   inputs(tick);select_scene(&ref);fn_802FCC44(&ref.tag_owner);original_draw_cpu(&ref);
   select_scene(&candidate);fn_802FCC44(&candidate.tag_owner);require(prepare(17,29,error,sizeof(error)));equal(&ref,&candidate);
  }
  init(&ref);init(&candidate);inputs(0);select_scene(&ref);original_draw_cpu(&ref);select_scene(&candidate);original_draw_cpu(&candidate);
 }
 select_scene(&candidate);Scene before=candidate;
 healthy=0;require(!prepare(17,29,error,sizeof(error)));healthy=1;require(!memcmp(&before,&candidate,sizeof(before)));
 require(!prepare(17,0,error,sizeof(error)));require(!memcmp(&before,&candidate,sizeof(before)));
 candidate.main.proj_mtx=NULL;before=candidate;require(!prepare(17,29,error,sizeof(error)));require(!memcmp(&before,&candidate,sizeof(before)));candidate.main.proj_mtx=&candidate.inverse;
 active=0;candidate.main.proj_mtx=NULL;before=candidate;require(prepare(17,0,error,sizeof(error)));require(!memcmp(&before,&candidate,sizeof(before)));active=1;candidate.main.proj_mtx=&candidate.inverse;
 inputs(1);cm_80452C68.mode=CAMERA_FREE;before=candidate;require(!prepare(17,29,error,sizeof(error)));require(!memcmp(&before,&candidate,sizeof(before)));cm_80452C68.mode=CAMERA_STANDARD;
 stage_info.grkind=Gr_Kind_Castle;require(!prepare(17,29,error,sizeof(error)));require(!memcmp(&before,&candidate,sizeof(before)));stage_info.grkind=Gr_Kind_Last;
 inverse_live=0;require(!prepare(17,29,error,sizeof(error)));require(!memcmp(&before,&candidate,sizeof(before)));inverse_live=1;
 candidate.owner.render_cb=NULL;before=candidate;require(!prepare(17,29,error,sizeof(error)));require(!memcmp(&before,&candidate,sizeof(before)));
 require(!alloc_calls);puts("camera-history actual-source PASS");return 0;
}
