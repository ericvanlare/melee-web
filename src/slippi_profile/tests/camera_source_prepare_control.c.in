typedef struct Scene { HSD_CObj main,copy; HSD_WObj eye,interest,copy_eye,copy_interest; Mtx inverse; HSD_GObj owner,tag_owner; HSD_GObjProc proc; HSD_JObj tag,child; u8 slot; } Scene;
static void init(Scene* s) {
 memset(s,0,sizeof(*s));
 s->main.parent.parent.class_info=&hsdCObj.parent.parent;
 s->copy.parent.parent.class_info=&hsdCObj.parent.parent;
 s->eye.parent.parent.class_info=s->interest.parent.parent.class_info=s->copy_eye.parent.parent.class_info=s->copy_interest.parent.parent.class_info=&hsdWObj.parent.parent;
 s->main.eyepos=&s->eye;s->main.interest=&s->interest;s->main.proj_mtx=&s->inverse;
 s->copy.eyepos=&s->copy_eye;s->copy.interest=&s->copy_interest;
 s->main.projection_type=s->copy.projection_type=PROJ_PERSPECTIVE;
 s->main.projection_param.perspective.aspect=s->copy.projection_param.perspective.aspect=1.25f;
 s->main.viewport.xmax=640;s->main.viewport.ymax=480;
 s->owner.classifier=0x10;s->owner.p_link=0x12;s->owner.gx_link=64;s->owner.render_priority=2;s->owner.obj_kind=1;s->owner.render_cb=fn_800301D0;s->owner.hsd_obj=&s->main;s->owner.proc=&s->proc;
 s->proc.gobj=&s->owner;s->proc.s_link=0x12;s->proc.on_invoke=fn_8002F360;
 s->tag.flags=JOBJ_MTX_DIRTY;s->tag.child=&s->child;s->tag_owner.hsd_obj=&s->tag;s->tag_owner.user_data=&s->slot;
}
static void select_scene(Scene* s) {
 cm_80452C68.gobj=&s->owner;cm_804D6464=&s->copy;expected_inverse=&s->inverse;
 heads[64]=tails[64]=&s->owner;gobj_alloc_data.used=1;HSD_GObjLibInitData.gx_link_max=63;
}
static void inputs(int tick) {
 cm_80452C68.mode=CAMERA_STANDARD; stage_info.grkind=Gr_Kind_Last;
 cm_80452C68.transform.fov=37.0f+tick;
 cm_80452C68.transform.position=(Vec3){2.0f*tick,12.0f+tick,130.0f-tick};
 cm_80452C68.transform.interest=(Vec3){-1.0f*tick,3.0f,0};
 cm_80452C68.transform_copy=cm_80452C68.transform;
 cm_80452C68.transform_copy.position.z+=3;
 cm_80452C68.translation=(Vec2){tick*.25f,tick*.125f};
 cm_80452C68.nearz=.1f;cm_80452C68.farz=16384;
 player=(Vec3){tick*1.25f,4.0f+tick,0};
}
