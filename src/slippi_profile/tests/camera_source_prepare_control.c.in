 Camera_8002A4AC(&s->owner); HSD_CObjSetupViewingMtx(&s->main);(void)HSD_CObjGetInvViewingMtxPtrDirect(&s->main);
}
static void equal(Scene* a,Scene* b) {
 require(!memcmp(&a->eye.pos,&b->eye.pos,sizeof(Vec3))&&!memcmp(&a->interest.pos,&b->interest.pos,sizeof(Vec3)));
 require(!memcmp(&a->copy_eye,&b->copy_eye,sizeof(HSD_WObj))&&!memcmp(&a->copy_interest,&b->copy_interest,sizeof(HSD_WObj)));
 require(!memcmp(a->main.view_mtx,b->main.view_mtx,sizeof(Mtx))&&!memcmp(a->inverse,b->inverse,sizeof(Mtx)));
 require(a->main.flags==b->main.flags&&a->eye.flags==b->eye.flags&&a->interest.flags==b->interest.flags);
 require(!memcmp(&a->main.projection_param,&b->main.projection_param,sizeof(a->main.projection_param)));
 require(!memcmp(&a->copy.projection_param,&b->copy.projection_param,sizeof(a->copy.projection_param)));
 require(a->main.near==b->main.near&&a->main.far==b->main.far&&a->copy.near==b->copy.near&&a->copy.far==b->copy.far&&a->copy.flags==b->copy.flags);
 require(a->owner.hsd_obj==&a->main&&b->owner.hsd_obj==&b->main&&a->main.proj_mtx==&a->inverse&&b->main.proj_mtx==&b->inverse);
 require(!memcmp(&a->tag.translate,&b->tag.translate,sizeof(Vec3)));
 require(!memcmp(a->copy.view_mtx,b->copy.view_mtx,sizeof(Mtx))&&!a->copy.proj_mtx&&!b->copy.proj_mtx);
}
static int prepare(uint64_t world, uint64_t token, char* error, size_t size) {
 HSD_GObj* selected=&(HSD_GObj){0};
 int ok=slippi_camera_source_prepare(world,token,&selected,error,size);
 require(selected==((ok&&token)?cm_80452C68.gobj:NULL));
 return ok;
}

static void compare_subject(Scene* explicit_scene, CmSubject* subject,
                            int want_write, int want_cull, int want_draw) {
 const S32Vec2 sentinel={-81234,76543};
 S32Vec2 expected=sentinel, actual=sentinel;
 HSD_GObj* reference_owner=cm_80452C68.gobj;
 HSD_CObj* original_current=HSD_CObjGetCurrent();
 int wrote=-1,culled=-1,draw=-1;
 int center_visible=Camera_80030CD8(subject,&expected);
 int expected_draw=center_visible||Camera_80030CFC(subject,15.0f);
 HSD_CObj* reference=reference_owner->hsd_obj;
 Scissor reference_scissor=reference->scissor;
 reference->scissor=(Scissor){0};
 require(slippi_camera_source_project_subject(&explicit_scene->main,subject,&actual,
                                             &wrote,&culled,&draw));
 reference->scissor=reference_scissor;
 require(wrote==want_write&&culled==want_cull&&draw==want_draw);
 require(wrote==(expected.x!=sentinel.x||expected.y!=sentinel.y));
 require(culled==!center_visible&&draw==expected_draw);
 require(actual.x==expected.x&&actual.y==expected.y);
 require(HSD_CObjGetCurrent()==original_current&&cm_80452C68.gobj==reference_owner);
}

static void check_projection(Scene* ref, Scene* candidate) {
 CmSubject subject={0};
 S32Vec2 center;
 select_scene(ref);
 current=&ref->copy;
 subject.bone_pos=ref->interest.pos;
 ref->main.scissor=(Scissor){.left=0,.right=640,.top=0,.bottom=480};
 require(Camera_80030CD8(&subject,&center));

 /* The reference camera and SDK current camera are different from the
  * explicit camera. Compare both paths with identical authored parameters. */
 candidate->main.scissor=ref->main.scissor;
 compare_subject(candidate,&subject,1,0,1);

 /* The original uses inclusive left and exclusive right scissor bounds. */
 ref->main.scissor.left=center.x;
 candidate->main.scissor=ref->main.scissor;
 compare_subject(candidate,&subject,1,0,1);
 ref->main.scissor.left=0;
 ref->main.scissor.right=center.x;
 candidate->main.scissor=ref->main.scissor;
 compare_subject(candidate,&subject,1,1,1); /* tolerance admits the subject */

 subject.bone_pos.x+=1000.0f;
 compare_subject(candidate,&subject,1,1,0);
 ref->main.projection_type=candidate->main.projection_type=255;
 compare_subject(candidate,&subject,0,1,0); /* no projection writes the sentinel */
 ref->main.projection_type=candidate->main.projection_type=PROJ_PERSPECTIVE;
 current=NULL;
}

static void check_warm_arm(void) {
 Fighter fp={0};
 Projection owner={.fp=&fp,.listed=1,.flag=1};
 const S32Vec2 warm={18,39},canonical={8,9};
 owners=&owner;
 memcpy(owner.screen,&warm,sizeof(warm));
 active=0;
 /* Wrong world, frame, unobserved draw, stale owner, and unlisted owner. */
 for(int i=0;i<5;++i){
  private_armed=0;failed=0;warm_draw_valid=i!=2;warm_draw_source_frame=5;
  owner_live=i!=3;owner.listed=i!=4;
  fp.x2188=canonical;fp.x221F_b0=0;
  require(!slippi_fighter_projection_private_arm(i==0?19:17,i==1?6:5));
  require(!private_armed&&!memcmp(&fp.x2188,&canonical,sizeof(canonical))&&!fp.x221F_b0);
 }
 private_armed=0;failed=0;warm_draw_valid=1;owner_live=1;owner.listed=1;
 require(slippi_fighter_projection_private_arm(17,5));
 require(private_armed&&!warm_draw_valid&&fp.x221F_b0);
 require(!memcmp(&fp.x2188,&warm,sizeof(warm)));
 fp.x2188=canonical;fp.x221F_b0=0;
 require(!slippi_fighter_projection_private_arm(17,5));
 require(!memcmp(&fp.x2188,&canonical,sizeof(canonical))&&!fp.x221F_b0);
 active=1;failed=0;owners=NULL;
}

static void check_magnifier(Scene* scene) {
 Fighter fp={0};
 HSD_GObj fighter={0},hud={0},magnifier={0};
 CmSubject subject={0};
 Projection owner={.fp=&fp};
 select_scene(scene);
 scene->main.scissor=(Scissor){.left=0,.right=640,.top=0,.bottom=480};
 cm_80452C68.x398_b0=0;
 scheduled_main=&scene->owner;scheduled_hud=&hud;scheduled_magnifier=&magnifier;
 magnifier.hsd_obj=&scene->copy;
 owners=&owner;fixture_fighter=&fighter;entities.fighters=&fighter;
 fighter.classifier=HSD_GOBJ_CLASS_FIGHTER;
 fighter.p_link=8;fighter.user_data_kind=4;fighter.gx_link=5;
 fighter.user_data=&fp;fighter.render_cb=ftDrawCommon_80080E18;
 heads[5]=tails[5]=&fighter;gobj_alloc_data.used=2;
 subject.bone_pos=scene->interest.pos;
 fp.x890_cameraBox=&subject;fp.x221F_b0=1;
 fp.x2188=(S32Vec2){1,1};
 ifMagnifyPlayer* slot=&ifMagnify_804A1DE0.player[0];
 ifMagnify_804A1DE0.player[1].state.ignore_offscreen=1;
 ifMagnify_804A1DE0.player[1].state.edge=4;
 S32Vec2 expected=fp.x2188;
 require(Camera_80030CD8(&subject,&expected));
 ifMagnifyPlayer projected=*slot;
 Vec2 direction={expected.x-320.0f,-((f32)expected.y-240.0f)},edge_position;
 ifMagnify_802FB73C(&projected,&direction,&edge_position);
 require(slippi_fighter_projection_source_prepare(17,29,&scene->owner,&hud,&magnifier,0));
 require(slot->state.is_offscreen&&!fp.x221F_b0&&slot->state.edge==projected.state.edge);
 require(!memcmp(&fp.x2188,&expected,sizeof(expected)));
 require(slippi_fighter_projection_source_prepare(17,29,&scene->owner,&hud,&magnifier,0));
 require(!slot->state.is_offscreen&&slot->state.edge==projected.state.edge);

 /* A callback skipped by the original fighter guard leaves stale screen
  * coordinates. The arrow still runs from those coordinates. */
 fp.x221F_b0=1;fp.x221F_b3=1;fp.x2188=(S32Vec2){12,240};
 require(slippi_fighter_projection_source_prepare(17,29,&scene->owner,&hud,&magnifier,0));
 require(slot->state.is_offscreen&&slot->state.edge==2&&fp.x2188.x==12&&fp.x221F_b0);
 fp.invisible=1;
 require(slippi_fighter_projection_source_prepare(17,29,&scene->owner,&hud,&magnifier,0));
 require(!slot->state.is_offscreen&&slot->state.edge==2);
 require(ifMagnify_804A1DE0.player[1].state.ignore_offscreen&&
         ifMagnify_804A1DE0.player[1].state.edge==4);
 const ifMagnify before=ifMagnify_804A1DE0;
 heads[5]=tails[5]=NULL;
 require(!slippi_fighter_projection_source_prepare(17,29,&scene->owner,&hud,&magnifier,0));
 require(!memcmp(&before,&ifMagnify_804A1DE0,sizeof(before)));
}

int main(void) {
 Scene ref,candidate,omitted; char error[256];
