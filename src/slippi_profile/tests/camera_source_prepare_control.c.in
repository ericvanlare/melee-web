 check_projection(&ref,&candidate);
 check_warm_arm();
 check_magnifier(&ref);
 /* Modeled in-place PRE restoration of these typed fixture values, not an
  * aggregate checkpoint test; original warm computation is replayed exactly. */
 init(&ref);init(&candidate);inputs(0);select_scene(&ref);original_draw_cpu(&ref);select_scene(&candidate);original_draw_cpu(&candidate);
 for(int replay=0;replay<2;++replay) {
