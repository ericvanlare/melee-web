/* Source case fragments remain verbatim, including original guards/order. */
static void fixture_anim_original(Fighter *fp, int32_t *data)
{
@TIMER_DECREMENT_ORIGINAL@
    if (fp->mv.co.unk_deadup.x40 == 0) {
        switch (fp->mv.co.unk_deadup.x44) {
@ANIM_CASE_ORIGINAL@
        }
    }
}

static void fixture_anim_profile(Fighter *fp, int32_t *data)
{
@TIMER_DECREMENT_PROFILE@
    if (fp->mv.co.unk_deadup.x40 == 0) {
        switch (fp->mv.co.unk_deadup.x44) {
@ANIM_CASE_PROFILE@
        }
    }
}

static int fixture_anim_result;
bool ftAnim_80070FD0(Fighter *fp)
{
    assert(fp == &fixture_fighter);
    anim_calls++;
    return fixture_anim_result != 0;
}

static void fixture_physics_original(Fighter *fp, float *config)
{
    unsigned char *ca = (unsigned char *) config;
    switch (fp->mv.co.unk_deadup.x44) {
@PHYSICS_CASE_ORIGINAL@
    }
}

static void fixture_physics_profile(Fighter *fp, float *config)
{
    unsigned char *ca = (unsigned char *) config;
    switch (fp->mv.co.unk_deadup.x44) {
@PHYSICS_CASE_PROFILE@
    }
}

/* The matrix routine's name is changed only to count calls around the actual
 * source arithmetic. The matrix operation body itself is unmodified. */
static void fixture_recording_ps_mtx_mult_vec(const Mtx matrix,
                                               const Vec *source,
                                               Vec *destination)
{
    matrix_multiply_calls++;
    extracted_melee_web_ps_mtx_mult_vec(matrix, source, destination);
}

void *Camera_800310B8(void) { camera_getter_calls++; return &fixture_camera_tag; }
MtxPtr HSD_CObjGetInvViewingMtxPtr(void *camera)
{
    assert(camera == &fixture_camera_tag);
    matrix_getter_calls++;
    return fixture_inverse_view;
}
int Camera_80031060(void) { camera_mode_calls++; return fixture_camera_mode; }
bool ftLib_80086A8C(HSD_GObj *gobj)
{
    assert(gobj == &fixture_gobj);
    return fixture_fighter_usable != 0;
}
void HSD_JObjSetTranslate(HSD_JObj *jobj, Vec3 *position)
{
    assert(jobj == &fixture_jobj);
    translation_calls++;
    translation_source_was_cur_pos = position == &fixture_fighter.cur_pos;
    jobj->translated = *position;
}
