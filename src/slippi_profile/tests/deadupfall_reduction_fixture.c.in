struct Fighter {
    int32_t player_id;
    int32_t x618_player_id;
    int32_t kind;
    struct { union ftCommon_MotionVars co; } mv;
    Vec3 self_vel;
    int x221F_b3;
    int x221E_b5;
    int x2226_b5;
    int x2220_b7;
    int x2223_b3;
    int x2222_b6;
    int invisible;
    struct { void *xC[5]; } x5AC;
    Vec3 cur_pos;
    Vec3 pos_delta;
    Vec3 prev_pos;
};
struct HSD_JObj { Vec3 translated; };

_Static_assert(offsetof(HSD_GObj, hsd_obj) ==
                   offsetof(HSD_GObj, gxlink_prios) + sizeof(u64),
               "pinned HSD_GObj hsd_obj field order");
_Static_assert(offsetof(HSD_GObj, user_data) ==
                   offsetof(HSD_GObj, hsd_obj) + sizeof(void *),
               "pinned HSD_GObj user_data field order");

_Static_assert(offsetof(union ftCommon_MotionVars, unk_deadup.pad_x48) == 8,
               "actual source private Y offset");
_Static_assert(offsetof(union ftCommon_MotionVars, unk_deadup.x4C) == 12,
               "actual source private Z offset");
_Static_assert(offsetof(union ftCommon_MotionVars, unk_deadup.x50) == 16,
               "actual source draw position offset");
_Static_assert(offsetof(union ftCommon_MotionVars, unk_deadup.x5C) == 28,
               "actual source accumulation offset");

#define HSD_ASSERT(line, condition) do { (void) (line); assert(condition); } while (0)
#define GET_FIGHTER(gobj) ((Fighter *) (gobj)->user_data)
#undef PSMTXMultVec
#define PSMTXMultVec fixture_recording_ps_mtx_mult_vec
#define FIXTURE_EXPECT(name, condition) \
    do { \
        if (!(condition)) { \
            fprintf(stderr, "EXPECTED_FAILURE:%s\n", (name)); \
            fflush(stderr); \
            exit(86); \
        } \
    } while (0)

