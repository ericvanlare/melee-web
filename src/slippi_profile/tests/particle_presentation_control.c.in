static uint64_t token;
static unsigned world_calls, mint_calls;
static unsigned match_calls, retired_match_calls, allocation_calls;
static unsigned identity_fault, duplicate_particle_identity, fixture_retired_particle;
static HSD_ObjAllocData particle_pool, app_pool;
static HSD_Particle particles[3];
static HSD_Particle speculative_particle;
static HSD_psAppSRT app;
HSD_Particle* hsd_804D0908[16];
static HSD_Particle* particle_list[17];
