static u8 psFrameNum=0x7b;
typedef struct { HSD_Particle *head,*tail; } psdisp_ParticleSortBucket;
uint64_t melee_web_cpu_interval_token(void) { return token; }
int melee_web_cpu_interval_active(void) { return token!=0; }
int melee_web_cpu_interval_admit(uint64_t t) { return t && t==token; }
void* particle_test_calloc(size_t count,size_t size)
{
    void* p;
    if(size && count>SIZE_MAX/size) return NULL;
    ++allocation_calls;
    p=malloc(count*size);
    if(p) memset(p,0,count*size);
    return p;
}
static int fixture_pool_cell_identity(void* p,const void* pool,size_t n,
                                      MeleeWebSourcePoolCellIdentity* out)
{
    uintptr_t address=(uintptr_t)p, base=0;
    uint64_t allocation=0;
    uint32_t source=0, offset=0, stride=(uint32_t)n;
    if(pool==&particle_pool && n==sizeof(HSD_Particle)) {
        uintptr_t particle_base=(uintptr_t)particles;
        uintptr_t particle_end=particle_base+sizeof(particles);
        if(p==&speculative_particle) {
            base=(uintptr_t)&speculative_particle;
            allocation=4; source=32;
        } else if(address>=particle_base && address<particle_end &&
                  (address-particle_base)%sizeof(HSD_Particle)==0) {
            base=particle_base; allocation=3;
            offset=(uint32_t)(address-particle_base);
            source=4+offset;
            if(duplicate_particle_identity) { offset=0; source=4; }
        } else return 0;
    } else if(pool==&app_pool && p==&app && n==sizeof(HSD_psAppSRT)) {
        base=(uintptr_t)&app; allocation=5; source=64;
    } else return 0;
    *out=(MeleeWebSourcePoolCellIdentity){1,2,allocation,base,
        (uintptr_t)pool,source,offset,stride};
    return 1;
}
int melee_web_source_memory_pool_cell_identity(void* p,const void* pool,size_t n,
                                              MeleeWebSourcePoolCellIdentity* out)
{
    ++mint_calls;
    return fixture_pool_cell_identity(p,pool,n,out);
}
int melee_web_source_memory_pool_cell_matches(void* p,const void* pool,size_t n,
                                              const MeleeWebSourcePoolCellIdentity* id)
{
    MeleeWebSourcePoolCellIdentity current;
    ++match_calls;
    if(p==&particles[0] && fixture_retired_particle) ++retired_match_calls;
    if(!id || !fixture_pool_cell_identity(p,pool,n,&current)) return 0;
    if(identity_fault==1) ++current.allocation;
    if(identity_fault==2) ++current.descriptor;
    if(identity_fault==3) ++current.stride;
    return id->world==current.world && id->epoch==current.epoch &&
        id->allocation==current.allocation && id->pool==current.pool &&
        id->descriptor==current.descriptor && id->source==current.source &&
        id->cell_offset==current.cell_offset && id->stride==current.stride;
}
#if defined(ACTUAL_LINKED_MATH)
static void measured_world(Mtx m,Vec3* scale,Vec3* rotate,Vec3* translate,Vec3* unused)
{
    ++world_calls;
    HSD_MtxSRT(m,scale,rotate,translate,unused);
}
#else
void HSD_MtxSRT(Mtx m,Vec3* scale,Vec3* rotate,Vec3* translate,Vec3* unused)
{
    (void)rotate;(void)unused;++world_calls;
    memset(m,0,sizeof(Mtx));m[0][0]=scale->x;m[1][1]=scale->y;m[2][2]=scale->z;
    m[0][3]=translate->x;m[1][3]=translate->y;m[2][3]=translate->z;
}
#endif
void psDispParticles(u32 mask,u32 sw)
{
    (void)mask;
    assert(sw==0);
    ACTUAL_SW0
    abort();
}
ACTUAL_SORT
uint8_t slippi_particle_source_frame_key(void) { return psFrameNum; }
ACTUAL_PREFLIGHT
#if defined(ACTUAL_LINKED_MATH)
#define HSD_MtxSRT measured_world
#endif
ACTUAL_PREPARE
#undef HSD_MtxSRT
#if defined(ACTUAL_LINKED_MATH)
static HSD_psAppSRT reference_app;
static Mtx vmtx={{0.9f,0.1f,0.0f,3.0f},{0.0f,0.8f,0.2f,4.0f},{0.3f,0.0f,0.7f,5.0f}};
ACTUAL_PROJECTIONS
#endif
static HSD_GObj camera, manager;
static SlippiParticlePassVisit visits[3];
static void init(void)
{
    unsigned i;
    assert(slippi_particle_presentation_world_begin(1));
    assert(slippi_particle_presentation_pool_initialized(&particle_pool,sizeof(HSD_Particle),4));
    assert(slippi_particle_presentation_appsrt_pool_initialized(&app_pool,sizeof(HSD_psAppSRT),4));
    memset(&app,0,sizeof(app));app.status=PS_APPSTATUS_ONCE;
    app.scale.x=app.scale.y=app.scale.z=1;app.translate.x=17;
    app.ssx=-123;
    assert(slippi_particle_presentation_appsrt_created(&app,&app_pool));
    for(i=0;i<3;++i) {
        particles[i].kind=i==0?(5u<<25)|TexEdge:i==1?(1u<<25):(2u<<25)|TexEdge;
        particles[i].next=i<2?&particles[i+1]:NULL;
        particles[i].linkNo=0;particles[i].idnum=(u16)(i+1);particles[i].size=1;
        particles[i].appsrt=&app;
        assert(slippi_particle_presentation_particle_created(&particles[i],&particle_pool));
    }
    hsd_804D0908[0]=particles;
    for(i=0;i<3;++i) visits[i]=(SlippiParticlePassVisit){SLIPPI_PARTICLE_CAMERA_MAIN_TAIL,&camera,i,7,5,&manager};
}
static void draw(void)
{
    unsigned i;
    assert(slippi_particle_presentation_draw_begin(1,token,NULL,0));
    assert(slippi_particle_presentation_camera_begin(&camera,NULL,0));
    for(i=0;i<3;++i) {
        HSD_Particle *sorted,*nonedge;u8 key;
        assert(slippi_particle_presentation_dispatch_begin(&manager,i,7,5,NULL,0)==SLIPPI_PARTICLE_DISPATCH_ROUTED);
        assert(slippi_particle_presentation_render_data(0,i,&key,&sorted,&nonedge)==SLIPPI_PARTICLE_DISPATCH_ROUTED);
        assert(key==psFrameNum);
        if(i) {
            HSD_psAppSRT scratch;
            HSD_psAppSRT original=app;
            assert(sorted==&particles[2] && nonedge==&particles[1]);
            assert(slippi_particle_presentation_app_srt_view(&app,&scratch)==&scratch);
            assert(scratch.frameNum==0 && scratch.status==PS_APPSTATUS_STILL && scratch.mmtx[0][3]==17);
#if defined(ACTUAL_LINKED_MATH)
            {
                HSD_Particle ref=*sorted;
                HSD_psAppSRT point, polygon;
                ref.appsrt=&reference_app;
                reference_point(&ref);
                candidate_point(sorted,&point);
                assert(!memcmp(point.mmtx,reference_app.mmtx,sizeof(Mtx)));
                assert(!memcmp(&point.ssx,&reference_app.ssx,14*sizeof(float)));
                reference_polygon(&ref);
                candidate_polygon(sorted,&polygon);
                assert(!memcmp(polygon.mmtx,reference_app.mmtx,sizeof(Mtx)));
                assert(!memcmp(&polygon.ssx,&reference_app.ssx,14*sizeof(float)));
            }
#endif
            scratch.ssx=999;
            assert(!memcmp(&original,&app,sizeof(app)));
        }
        assert(slippi_particle_presentation_dispatch_end(NULL,0));
    }
    assert(slippi_particle_presentation_camera_end(&camera,NULL,0));
    assert(slippi_particle_presentation_draw_end(NULL,0));
}
static int row_same_identity(const SlippiParticleCellEndpointRow* a,
                             const SlippiParticleCellEndpointRow* b)
{
    return a->schema==b->schema && a->bytes==b->bytes &&
        a->object_kind==b->object_kind && a->extent==b->extent &&
        a->receipt_serial==b->receipt_serial && a->object==b->object &&
        a->world==b->world && a->epoch==b->epoch &&
        a->allocation==b->allocation && a->pool==b->pool &&
        a->descriptor==b->descriptor && a->source==b->source &&
        a->cell_offset==b->cell_offset && a->stride==b->stride &&
        a->reserved==0;
}
static void require_zero_header(const SlippiParticleCellEndpointHeader* h)
{
    SlippiParticleCellEndpointHeader zero={0};
    assert(!memcmp(h,&zero,sizeof(zero)));
}
static void require_zero_row(const SlippiParticleCellEndpointRow* row)
{
    SlippiParticleCellEndpointRow zero={0};
    assert(!memcmp(row,&zero,sizeof(zero)));
}
static void endpoint_control(const char* mode)
{
    SlippiParticlePresentationAnchor anchor, next_anchor;
    SlippiParticleCellEndpointHeader clean={0}, after={0};
    SlippiParticleCellEndpointRow clean_live[4], clean_captured[4], row={0};
    HSD_Particle before_particles[3];
    HSD_psAppSRT before_app;
    uint8_t before_frame;
    unsigned mint_before, alloc_before, world_before, retired_before;
    uint32_t i;
    token=41;
    anchor=slippi_particle_presentation_anchor_capture();
    assert(anchor.world==1 && anchor.token && anchor.serial==4);
    if(!strcmp(mode,"endpoint-stale")) {
        SlippiParticleCellEndpointHeader refused;
        SlippiParticlePresentationAnchor stale=anchor;
        memset(&refused,0xa5,sizeof(refused)); ++stale.token;
        mint_before=mint_calls; alloc_before=allocation_calls;
        assert(!slippi_particle_presentation_cell_endpoint_header(stale,&refused));
        require_zero_header(&refused);
        assert(mint_calls==mint_before && allocation_calls==alloc_before);
    } else if(!strcmp(mode,"endpoint-generation") ||
              !strcmp(mode,"endpoint-descriptor") ||
              !strcmp(mode,"endpoint-stride")) {
        SlippiParticleCellEndpointHeader refused;
        memset(&refused,0xa5,sizeof(refused));
        identity_fault=!strcmp(mode,"endpoint-generation")?1u:
                       !strcmp(mode,"endpoint-descriptor")?2u:3u;
        mint_before=mint_calls; alloc_before=allocation_calls;
        assert(!slippi_particle_presentation_cell_endpoint_header(anchor,&refused));
        require_zero_header(&refused);
        assert(mint_calls==mint_before && allocation_calls==alloc_before);
    } else if(!strcmp(mode,"endpoint-duplicate")) {
        SlippiParticleCellEndpointHeader refused;
        memset(&refused,0xa5,sizeof(refused));
        mint_before=mint_calls; alloc_before=allocation_calls;
        assert(!slippi_particle_presentation_cell_endpoint_header(anchor,&refused));
        require_zero_header(&refused);
        assert(mint_calls==mint_before && allocation_calls==alloc_before);
    } else if(!strcmp(mode,"endpoint-index")) {
        SlippiParticleCellEndpointRow refused;
        assert(slippi_particle_presentation_cell_endpoint_header(anchor,&clean));
        memset(&refused,0xa5,sizeof(refused));
        mint_before=mint_calls; alloc_before=allocation_calls;
        assert(!slippi_particle_presentation_cell_endpoint_row(
            anchor,SLIPPI_PARTICLE_CELL_ROW_LIVE,UINT32_MAX,&refused));
        require_zero_row(&refused);
        assert(mint_calls==mint_before && allocation_calls==alloc_before);
    } else {
        memcpy(before_particles,particles,sizeof(particles)); before_app=app;
        before_frame=psFrameNum; mint_before=mint_calls;
        assert(slippi_particle_presentation_cell_endpoint_header(anchor,&clean));
        assert(clean.schema==SLIPPI_PARTICLE_CELL_ENDPOINT_SCHEMA &&
               clean.bytes==64 && clean.live_count==4 && clean.captured_count==4 &&
               clean.world==1 && clean.anchor_serial==4 &&
               clean.anchor_token==anchor.token && clean.history_serial==4);
        for(i=0;i<4;++i) assert(clean.reserved[i]==0);
        alloc_before=allocation_calls; world_before=world_calls;
        for(i=0;i<4;++i) {
            assert(slippi_particle_presentation_cell_endpoint_row(
                anchor,SLIPPI_PARTICLE_CELL_ROW_LIVE,i,&clean_live[i]));
            assert(slippi_particle_presentation_cell_endpoint_row(
                anchor,SLIPPI_PARTICLE_CELL_ROW_CAPTURED,i,&clean_captured[i]));
            assert(clean_live[i].bytes==96 && clean_live[i].index==i &&
                   clean_live[i].row_kind==SLIPPI_PARTICLE_CELL_ROW_LIVE &&
                   clean_captured[i].row_kind==SLIPPI_PARTICLE_CELL_ROW_CAPTURED &&
                   clean_live[i].object_kind==(i==3 ?
                       SLIPPI_PARTICLE_CELL_OBJECT_APPSRT :
                       SLIPPI_PARTICLE_CELL_OBJECT_PARTICLE));
            if(i<3) {
                assert(clean_live[i].extent==sizeof(HSD_Particle) &&
                       clean_live[i].stride==sizeof(HSD_Particle) &&
                       clean_live[i].object==(uint64_t)(uintptr_t)&particles[2-i] &&
                       clean_live[i].world==1 && clean_live[i].epoch==2 &&
                       clean_live[i].allocation==3 &&
                       clean_live[i].pool==(uint64_t)(uintptr_t)particles &&
                       clean_live[i].descriptor==(uint64_t)(uintptr_t)&particle_pool &&
                       clean_live[i].source==4+(uint32_t)((2-i)*sizeof(HSD_Particle)) &&
                       clean_live[i].cell_offset==(uint32_t)((2-i)*sizeof(HSD_Particle)));
            } else {
                assert(clean_live[i].extent==sizeof(HSD_psAppSRT) &&
                       clean_live[i].stride==sizeof(HSD_psAppSRT) &&
                       clean_live[i].object==(uint64_t)(uintptr_t)&app &&
                       clean_live[i].world==1 && clean_live[i].epoch==2 &&
                       clean_live[i].allocation==5 &&
                       clean_live[i].pool==(uint64_t)(uintptr_t)&app &&
                       clean_live[i].descriptor==(uint64_t)(uintptr_t)&app_pool &&
                       clean_live[i].source==64 && clean_live[i].cell_offset==0);
            }
            assert(row_same_identity(&clean_live[i],&clean_captured[i]));
        }
        assert(mint_calls==mint_before && allocation_calls==alloc_before &&
               world_calls==world_before && psFrameNum==before_frame);
        assert(!memcmp(before_particles,particles,sizeof(particles)) &&
               !memcmp(&before_app,&app,sizeof(app)));

        /* Retiring a captured cell leaves its immutable receipt enumerable.
         * The endpoint read must not ask the backing observer about that dead
         * object; the later checked reset is allowed to revalidate it. */
        assert(slippi_particle_presentation_particle_retiring(
            &particles[0],&particle_pool));
        fixture_retired_particle=1;
        retired_before=retired_match_calls;
        mint_before=mint_calls; alloc_before=allocation_calls;
        assert(slippi_particle_presentation_cell_endpoint_row(
            anchor,SLIPPI_PARTICLE_CELL_ROW_CAPTURED,2,&row));
        assert(row_same_identity(&row,&clean_captured[2]));
        assert(retired_match_calls==retired_before && mint_calls==mint_before &&
               allocation_calls==alloc_before);

        memset(&speculative_particle,0,sizeof(speculative_particle));
        assert(slippi_particle_presentation_particle_created(
            &speculative_particle,&particle_pool));
        assert(slippi_particle_presentation_particle_retiring(
            &speculative_particle,&particle_pool));
        assert(slippi_particle_presentation_reset_after_restore(anchor));
        fixture_retired_particle=0;
        assert(slippi_particle_presentation_prepare(visits,3,1,token,NULL,0));

        /* Endpoint reads after the same helper continuation expose unchanged
         * live/captured cell identities, while the local monotonic history
         * watermark records the additional speculative constructor. */
        memcpy(before_particles,particles,sizeof(particles)); before_app=app;
        before_frame=psFrameNum; mint_before=mint_calls;
        assert(slippi_particle_presentation_cell_endpoint_header(anchor,&after));
        assert(after.live_count==4 && after.captured_count==4 &&
               after.anchor_serial==4 && after.history_serial==5);
        alloc_before=allocation_calls; world_before=world_calls;
        for(i=0;i<4;++i) {
            assert(slippi_particle_presentation_cell_endpoint_row(
                anchor,SLIPPI_PARTICLE_CELL_ROW_LIVE,i,&row));
            assert(row.row_kind==SLIPPI_PARTICLE_CELL_ROW_LIVE && row.index==i);
            assert(row_same_identity(&row,&clean_live[i]));
            assert(slippi_particle_presentation_cell_endpoint_row(
                anchor,SLIPPI_PARTICLE_CELL_ROW_CAPTURED,i,&row));
            assert(row.row_kind==SLIPPI_PARTICLE_CELL_ROW_CAPTURED && row.index==i);
            assert(row_same_identity(&row,&clean_captured[i]));
        }
        assert(mint_calls==mint_before && allocation_calls==alloc_before &&
               world_calls==world_before && psFrameNum==before_frame);
        assert(!memcmp(before_particles,particles,sizeof(particles)) &&
               !memcmp(&before_app,&app,sizeof(app)));
        assert(slippi_particle_presentation_interval_end(1,token));
        token=0;
        next_anchor=slippi_particle_presentation_anchor_capture();
        assert(next_anchor.world==anchor.world && next_anchor.serial==5 &&
               next_anchor.token!=anchor.token);
        assert(slippi_particle_presentation_cell_endpoint_header(next_anchor,&after));
        assert(after.history_serial==5 && after.anchor_serial==5 &&
               after.live_count==4 && after.captured_count==4);
        for(i=0;i<4;++i) {
            assert(slippi_particle_presentation_cell_endpoint_row(
                next_anchor,SLIPPI_PARTICLE_CELL_ROW_LIVE,i,&row));
            assert(row.row_kind==SLIPPI_PARTICLE_CELL_ROW_LIVE && row.index==i);
            assert(row_same_identity(&row,&clean_live[i]));
            assert(slippi_particle_presentation_cell_endpoint_row(
                next_anchor,SLIPPI_PARTICLE_CELL_ROW_CAPTURED,i,&row));
            assert(row.row_kind==SLIPPI_PARTICLE_CELL_ROW_CAPTURED && row.index==i);
            assert(row_same_identity(&row,&clean_captured[i]));
        }
        assert(!slippi_particle_presentation_failure());
        slippi_particle_presentation_anchor_disarm(next_anchor);
        assert(slippi_particle_presentation_world_end(1));
        puts("particle presentation control endpoint passed; typed constructor receipt rows and monotonic local history");
        return;
    }
    assert(slippi_particle_presentation_failure());
    assert(slippi_particle_presentation_interval_end(1,token));
    token=0;
    assert(!slippi_particle_presentation_world_end(1));
    assert(slippi_particle_presentation_world_begin(2));
    assert(slippi_particle_presentation_world_end(2));
    printf("particle presentation control %s passed; zero-on-refusal typed endpoint\n",mode);
}
int main(int argc,char** argv)
{
    SlippiParticlePresentationAnchor anchor;
    HSD_Particle before[3];HSD_psAppSRT before_app;
    u8 initial_key, expected_key;
    const char* mode=argc>1?argv[1]:"positive";
    if(!strcmp(mode,"endpoint-duplicate")) duplicate_particle_identity=1;
    init();
    if(!strncmp(mode,"endpoint-",9) || !strcmp(mode,"endpoint")) {
        endpoint_control(mode);
        return 0;
    }
#if defined(ACTUAL_LINKED_MATH)
    app.rot.x=0.23f;app.rot.y=-0.5f;app.rot.z=0.9f;
    app.scale.x=1.2f;app.scale.y=0.7f;app.scale.z=2.0f;
    app.xA2=1;
    reference_app=app;
#endif
    if(!strcmp(mode,"wrap")) psFrameNum=0xfe;
    initial_key=psFrameNum; expected_key=initial_key<255?(u8)(initial_key+1):1;
    if(!strcmp(mode,"stale")) app.frameNum=0x7c;
    if(!strcmp(mode,"kind")) particles[0].kind|=PrimEnv;
    if(!strcmp(mode,"foreign")) hsd_804D0908[2]=(HSD_Particle*)&camera;
    memcpy(before,particles,sizeof(before));before_app=app;
    assert(!token);
    anchor=slippi_particle_presentation_anchor_capture();
    assert(anchor.world==1 && anchor.token && anchor.particle_count==3 && anchor.appsrt_count==1);
    assert(slippi_particle_presentation_anchor_admit(anchor));
    assert(mint_calls==4); /* Capture/admit never adopt a new cell. */
    token=41;
    if(!strcmp(mode,"first-error") || !strcmp(mode,"first-camera") ||
       !strcmp(mode,"first-bare")) {
        assert(slippi_particle_presentation_prepare(visits,3,1,token,NULL,0));
        memcpy(before,particles,sizeof(before)); before_app=app;
        assert(slippi_particle_presentation_draw_begin(1,token,NULL,0));
        if(!strcmp(mode,"first-camera")) {
            assert(!slippi_particle_presentation_camera_end(&camera,NULL,0));
        } else {
            assert(slippi_particle_presentation_camera_begin(&camera,NULL,0));
            if(!strcmp(mode,"first-error")) {
                assert(slippi_particle_presentation_dispatch_begin(
                    &manager,1,7,5,NULL,0)==SLIPPI_PARTICLE_DISPATCH_REFUSED);
            } else {
                uint8_t key; HSD_Particle *sorted,*nonedge;
                assert(slippi_particle_presentation_render_data(
                    16,0,&key,&sorted,&nonedge)==SLIPPI_PARTICLE_DISPATCH_REFUSED);
            }
        }
        assert(!slippi_particle_presentation_camera_end(&camera,NULL,0));
        assert(!slippi_particle_presentation_draw_end(NULL,0));
        assert(!slippi_particle_presentation_draw_end(NULL,0));
        assert(!memcmp(before,particles,sizeof(before)));
        assert(!memcmp(&before_app,&app,sizeof(app)));
        goto failed_cleanup;
    }
    if(!strcmp(mode,"lifetime")) {
        assert(slippi_particle_presentation_particle_retiring(&particles[0],&particle_pool));
        assert(slippi_particle_presentation_particle_created(&particles[0],&particle_pool));
        assert(mint_calls==5);
    }
    if(!strcmp(mode,"poolbusy")) {
        assert(!slippi_particle_presentation_pool_reinitialization_allowed());
        assert(psFrameNum==initial_key && !memcmp(before,particles,sizeof(before)) && !memcmp(&before_app,&app,sizeof(app)));
    } else if(!strcmp(mode,"stale") || !strcmp(mode,"kind") || !strcmp(mode,"foreign")) {
        assert(!slippi_particle_presentation_prepare(visits,3,1,token,NULL,0));
        assert(psFrameNum==initial_key && !memcmp(before,particles,sizeof(before)) && !memcmp(&before_app,&app,sizeof(app)));
        assert(!world_calls);
    } else {
        assert(slippi_particle_presentation_prepare(visits,3,1,token,NULL,0));
        assert(psFrameNum==expected_key && world_calls==1 && app.status==PS_APPSTATUS_STILL);
        assert(hsd_804D0908[0]==&particles[2] && particles[2].next==&particles[0] && particles[0].next==&particles[1]);
        if(!strcmp(mode,"changed")) {
            particles[0].kind^=TexEdge;
            assert(!slippi_particle_presentation_draw_begin(1,token,NULL,0));
        } else if(!strcmp(mode,"wrong")) {
            assert(slippi_particle_presentation_draw_begin(1,token,NULL,0));
            assert(slippi_particle_presentation_camera_begin(&camera,NULL,0));
            assert(slippi_particle_presentation_dispatch_begin(&manager,2,7,5,NULL,0)==SLIPPI_PARTICLE_DISPATCH_REFUSED);
            assert(!slippi_particle_presentation_draw_end(NULL,0));
        } else {
            s32 source_value=42;
            draw();
            if(!strcmp(mode,"repeat")) assert(!slippi_particle_presentation_draw_begin(1,token,NULL,0));
            else {
                /* Model only the checked source commit. The actual coordinator
                 * pre-write/reset contract is tested in its existing controls. */
                memcpy(particles,before,sizeof(before));app=before_app;
                hsd_804D0908[0]=particles;psFrameNum=initial_key;
                memset(HSD_PSDisp_8040C360,0,sizeof(HSD_PSDisp_8040C360));
                memset(particle_list,0,sizeof(particle_list));
                assert(slippi_particle_presentation_reset_after_restore(anchor));
                assert(slippi_particle_presentation_prepare(visits,3,1,token,NULL,0));
                assert(world_calls==2);
#if defined(ACTUAL_LINKED_MATH)
                reference_app=before_app;
                draw();
                app.status=0;reference_app.status=0;
                app.translate.y=reference_app.translate.y=19.0f;
                app.rot.z=reference_app.rot.z=-0.11f;
                assert(slippi_particle_presentation_prepare(visits,3,1,token,NULL,0));
                draw();
                assert(app.status==0);
                app.status=reference_app.status=PS_APPSTATUS_STILL;
                app.translate.z=reference_app.translate.z=200.0f;
                assert(slippi_particle_presentation_prepare(visits,3,1,token,NULL,0));
                draw();
                assert(app.status==PS_APPSTATUS_STILL);
                assert(slippi_particle_presentation_prepare(visits,3,1,token,NULL,0));
#endif
                assert(slippi_particle_presentation_draw_begin(1,token,NULL,0));
                *slippi_particle_presentation_s32_slot(SLIPPI_PARTICLE_CACHE_PREV_POINT_SIZE,&source_value)=99;
                assert(source_value==42);
                /* A source mutation attempt latches failure before the caller store. */
                assert(!slippi_particle_presentation_source_mutation_allowed());
                assert(!slippi_particle_presentation_draw_end(NULL,0));
            }
        }
    }
failed_cleanup:
    assert(mint_calls==(!strcmp(mode,"lifetime")?5u:4u));
    assert(slippi_particle_presentation_failure());
    assert(slippi_particle_presentation_interval_end(1,token));
    slippi_particle_presentation_anchor_disarm(anchor);
    token=0;
    assert(!slippi_particle_presentation_world_end(1)); /* Cleanup preserves failure. */
    assert(slippi_particle_presentation_world_begin(2));
    assert(slippi_particle_presentation_world_end(2));
#if defined(ACTUAL_LINKED_MATH)
    puts("actual archived HSD_MtxSRT/PS math + original point/polygon prefixes: ONCE/shared/continuous/STILL/xA2 passed");
#endif
    printf("particle presentation control %s passed; actual sort/preparation gates; modeled providers\n",mode);
    return 0;
}
