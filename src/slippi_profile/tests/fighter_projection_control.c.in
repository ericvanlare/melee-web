static void set_shadow_values(Fighter* fp, int marker)
{
 Vec3 eye={marker+1,marker+2,marker+3};
 Vec3 interest={marker+4,marker+5,marker+6};
 fp->x20A4.x0_b0=(marker&1)!=0;fp->x20A4.x0_b1=(marker&2)!=0;
 fp->x20A4.x0_b2=(marker&4)!=0;fp->x20A4.x0_b3=(marker&8)!=0;
 fp->x20A4.x0_b4=(marker&16)!=0;fp->x20A4.x0_b5=(marker&32)!=0;
 shadow.intensity=(unsigned char)(100+marker);
 shadow_eye.flags=0x100u|(unsigned)marker;shadow_interest.flags=0x200u|(unsigned)(marker<<1);
 /* Exact pinned setter leaves exercise WObj dirty bits and camera fields.
  * Source input math and matrix/GX leaves below remain modeled. */
 HSD_CObjSetEyePosition(&camera,&eye);HSD_CObjSetInterest(&camera,&interest);
 HSD_CObjSetNear(&camera,marker+.125f);HSD_CObjSetFar(&camera,marker+500.0f);
 HSD_CObjSetViewportfx4(&camera,marker,marker+10,marker+20,marker+30);
 HSD_CObjSetScissorx4(&camera,(unsigned short)marker,(unsigned short)(marker+1),
                      (unsigned short)(marker+2),(unsigned short)(marker+3));
 HSD_CObjSetOrtho(&camera,marker+40,marker+41,marker+42,marker+43);
 camera.flags=0x1235u|((unsigned)marker<<30);
 HSD_CObjSetMtxDirty(&camera);
 /* Up-vector normalization and view-matrix production are modeled here. */
 camera.u.up=(Vec3){marker+.25f,marker+.5f,marker+.75f};
 camera.view_mtx[0][0]=marker+.1f;camera.view_mtx[1][1]=marker+.2f;camera.view_mtx[2][2]=marker+.3f;
 shadow_texture.flags=(shadow_texture.flags&~TEX_MTX_DIRTY)|
                      (marker&1?TEX_MTX_DIRTY:0)|0x00400000u;
 shadow_texture.mtx[0][0]=marker+.4f;shadow_texture.mtx[1][1]=marker+.5f;
 shadow_texture.mtx[2][2]=marker+.6f;
}
static void assert_shadow_values(Fighter* fp, int marker)
{
 assert(fp->x20A4.x0_b0==((marker&1)!=0));
 assert(fp->x20A4.x0_b2==((marker&4)!=0));
 assert(fp->x20A4.x0_b3==((marker&8)!=0));
 assert(fp->x20A4.x0_b4==((marker&16)!=0));
 assert(shadow.intensity==100+marker);
 assert(shadow_eye.pos.x==marker+1&&shadow_eye.pos.y==marker+2&&shadow_eye.pos.z==marker+3);
 assert(shadow_interest.pos.x==marker+4&&shadow_interest.pos.y==marker+5&&shadow_interest.pos.z==marker+6);
 assert(camera.u.up.x==marker+.25f&&camera.u.up.y==marker+.5f&&camera.u.up.z==marker+.75f);
 assert(camera.near==marker+.125f&&camera.far==marker+500.0f);
 assert(camera.viewport.xmin==marker&&camera.viewport.xmax==marker+10&&
        camera.viewport.ymin==marker+20&&camera.viewport.ymax==marker+30);
 assert(camera.scissor.left==marker&&camera.scissor.right==marker+1&&
        camera.scissor.top==marker+2&&camera.scissor.bottom==marker+3);
 assert(camera.projection_type==3);
 assert((camera.flags&0xC0000000u)==(marker==0?0:0xC0000000u));
 assert(camera.projection_param.ortho.top==marker+40&&camera.projection_param.ortho.bottom==marker+41&&
        camera.projection_param.ortho.left==marker+42&&camera.projection_param.ortho.right==marker+43);
 assert(camera.view_mtx[0][0]==marker+.1f&&camera.view_mtx[1][1]==marker+.2f&&camera.view_mtx[2][2]==marker+.3f);
 assert(shadow_texture.mtx[0][0]==marker+.4f&&shadow_texture.mtx[1][1]==marker+.5f&&
        shadow_texture.mtx[2][2]==marker+.6f);
}
static void init_fixture(Fighter* fp, HSD_GObj* fighter)
{
 memset(fp,0,sizeof(*fp));
 init_shadow(fp);fighter->next=0;fighter->user_data=fp;fighter->hsd_obj=&fighter_model;
 entities.fighters=fighter;
#ifdef MELEE_WEB_FIGHTER_PROJECTION_SOURCE_CONTROLS
 tobj_shadows=&shadow_texture;tobj_toon=NULL;
#endif
}
static int run_topology_mode(const char* mode)
{
 Fighter fp={0};HSD_GObj fighter={0};int descriptor=1;uint64_t token=0;
 const uint64_t world_id=20;
 const int failed_interval=strcmp(mode,"failed-active")==0;
 if(strcmp(mode,"active-topology")!=0&&!failed_interval&&
    strcmp(mode,"active-rebuilt")!=0&&strcmp(mode,"inactive-rebuilt")!=0&&
    strcmp(mode,"active-order")!=0&&strcmp(mode,"arm-mid-draw")!=0&&
    strcmp(mode,"disarm-mid-draw")!=0&&strcmp(mode,"tuple-active")!=0&&
    strcmp(mode,"image-active")!=0&&strcmp(mode,"inverse-active")!=0)
  return 0;
 identity.world=world_id;identity.fighter=20;
 assert(slippi_fighter_projection_world_begin(world_id));
 init_fixture(&fp,&fighter);set_shadow_values(&fp,0);
 camera.flags&=~0xC0000000u; /* Match the source fixture's normalized entry state. */
 assert(slippi_fighter_projection_created(&fp,&descriptor,sizeof(fp)));

 if(strcmp(mode,"active-topology")==0||failed_interval) {
  token=melee_web_cpu_interval_begin();assert(token&&melee_web_cpu_interval_active());
  if(failed_interval) {
   assert(!melee_web_cpu_interval_attempt(MELEE_WEB_CPU_EFFECT_SOURCE_FILE));
   assert(melee_web_cpu_interval_failure()==MELEE_WEB_CPU_EFFECT_SOURCE_FILE);
   assert(melee_web_cpu_interval_active());
  }
  assert(slippi_fighter_projection_draw_begin());
  shadow.objects=NULL;shadow.active=0;
  assert(!slippi_fighter_projection_draw_end());
  assert(strcmp(slippi_fighter_projection_failure_reason(),
                "shadow canonical member node changed")==0);
  assert(shadow.objects==&shadow_object&&shadow.active==1);
  assert(melee_web_cpu_interval_end(token));assert(!melee_web_cpu_interval_active());
  assert(slippi_fighter_projection_world_end(world_id));
  return 1;
 }
 if(strcmp(mode,"active-rebuilt")==0||strcmp(mode,"inactive-rebuilt")==0) {
  HSD_SList replacement={0};
  if(strcmp(mode,"active-rebuilt")==0) {
   token=melee_web_cpu_interval_begin();assert(token&&melee_web_cpu_interval_active());
  }
  assert(slippi_fighter_projection_draw_begin());
  replacement.data=&fighter_model;shadow.objects=&replacement;
  if(token) {
   assert(!slippi_fighter_projection_draw_end());
   assert(strcmp(slippi_fighter_projection_failure_reason(),"shadow canonical member node changed")==0);
   assert(shadow.objects==&shadow_object&&shadow.active==1);
  } else {
   assert(slippi_fighter_projection_draw_end());
   assert(shadow.objects==&replacement&&shadow.active==1);
  }
  assert_shadow_values(&fp,0);
  if(token) {assert(melee_web_cpu_interval_end(token));assert(!melee_web_cpu_interval_active());}
  assert(slippi_fighter_projection_world_end(world_id));
  return 1;
 }
 if(strcmp(mode,"active-order")==0) {
  token=melee_web_cpu_interval_begin();assert(token&&melee_web_cpu_interval_active());
  assert(slippi_fighter_projection_draw_begin());
  shadow_object.data=&other_model;
  assert(!slippi_fighter_projection_draw_end());
  assert(strcmp(slippi_fighter_projection_failure_reason(),
                "shadow canonical member node changed")==0);
  assert(melee_web_cpu_interval_end(token));assert(!melee_web_cpu_interval_active());
  assert(slippi_fighter_projection_world_end(world_id));
  return 1;
 }
 if(strcmp(mode,"arm-mid-draw")==0||strcmp(mode,"disarm-mid-draw")==0) {
  const int arm=strcmp(mode,"arm-mid-draw")==0;
  if(!arm) {token=melee_web_cpu_interval_begin();assert(token&&melee_web_cpu_interval_active());}
  assert(slippi_fighter_projection_draw_begin());
  if(arm) {token=melee_web_cpu_interval_begin();assert(token&&melee_web_cpu_interval_active());}
  else {assert(melee_web_cpu_interval_end(token));token=0;assert(!melee_web_cpu_interval_active());}
  shadow.objects=NULL;shadow.active=0;
  assert(!slippi_fighter_projection_draw_end());
  assert(strcmp(slippi_fighter_projection_failure_reason(),
                "CPU interval armed state changed during draw")==0);
  assert(shadow.objects==(arm?NULL:&shadow_object)&&shadow.active==(arm?0:1));
  if(token) assert(melee_web_cpu_interval_end(token));
  assert(!melee_web_cpu_interval_active());
  assert(slippi_fighter_projection_world_end(world_id));
  return 1;
 }
 if(strcmp(mode,"tuple-active")==0) {
  token=melee_web_cpu_interval_begin();assert(token&&melee_web_cpu_interval_active());
  camera.eyepos=&other_eye;
  assert(!slippi_fighter_projection_draw_begin());
  assert(strcmp(slippi_fighter_projection_failure_reason(),
                "shadow camera WObj tuple changed")==0);
  assert(melee_web_cpu_interval_end(token));assert(!melee_web_cpu_interval_active());
  assert(slippi_fighter_projection_world_end(world_id));
  return 1;
 }
 if(strcmp(mode,"image-active")==0) {
  token=melee_web_cpu_interval_begin();assert(token&&melee_web_cpu_interval_active());
  shadow_image.width=128;
  assert(!slippi_fighter_projection_draw_begin());
  assert(strcmp(slippi_fighter_projection_failure_reason(),"shadow image layout changed")==0);
  assert(melee_web_cpu_interval_end(token));assert(!melee_web_cpu_interval_active());
  assert(slippi_fighter_projection_world_end(world_id));
  return 1;
 }
 if(strcmp(mode,"inverse-active")==0) {
  Mtx late_inverse={{0}};
  token=melee_web_cpu_interval_begin();assert(token&&melee_web_cpu_interval_active());
  assert(slippi_fighter_projection_draw_begin());camera.proj_mtx=&late_inverse;
  assert(!slippi_fighter_projection_draw_end());
  assert(strcmp(slippi_fighter_projection_failure_reason(),"shadow camera inverse appeared")==0);
  assert(melee_web_cpu_interval_end(token));assert(!melee_web_cpu_interval_active());
  assert(slippi_fighter_projection_world_end(world_id));
  return 1;
 }
 return 0;
}
#ifdef MELEE_WEB_FIGHTER_PROJECTION_SOURCE_CONTROLS
static void init_source_fixture(Fighter* fp,HSD_GObj* fighter,
                                unsigned canonical_members,int active,
                                int image_present)
{
 memset(fp,0,sizeof(*fp));memset(fighter,0,sizeof(*fighter));
 init_fixture(fp,fighter);
 identity.world=41;identity.fighter=42;
 fighter->hsd_obj=&fighter_model;fighter->user_data=fp;
 entities.fighters=fighter;
 fighter_model.refs=3;other_model.refs=7;foreign_model.refs=11;
 fp->x21FC_flag.b7=1;fp->x5AC.xC[1]=&fixture_scissor;
 fp->x20A0_accessory=&other_model;
 fp->x20A4.x0_b0=fp->x20A4.x0_b1=fp->x20A4.x0_b2=0;
 fp->x20A4.x0_b3=fp->x20A4.x0_b4=fp->x20A4.x0_b5=0;
 shadow_image.image_ptr=image_present?shadow_pixels:NULL;
 shadow.active=!!active;
 shadow_object.data=&fighter_model;
 shadow_object.next=canonical_members>1?&shadow_accessory_object:NULL;
 shadow_accessory_object.data=&other_model;shadow_accessory_object.next=NULL;
 shadow.objects=canonical_members?&shadow_object:NULL;
 memset(&foreign_shadow,0,sizeof(foreign_shadow));
 memset(&foreign_tobj,0,sizeof(foreign_tobj));
 shadow_texture.next=NULL;tobj_shadows=active?&shadow_texture:NULL;tobj_toon=NULL;
 list_allocations=list_removals=jobj_refs=jobj_unrefs=0;list_pool_cursor=0;
 tevdesc_frees=texp_frees=resource_assignments=tev_compiles=0;
 setup_count=0;memset(&ordinary_a,0,sizeof(ordinary_a));
 memset(&ordinary_b,0,sizeof(ordinary_b));memset(&toon_tobj,0,sizeof(toon_tobj));
 memset(&toon_image,0,sizeof(toon_image));
 memset(&fixture_material,0,sizeof(fixture_material));memset(&fixture_mobj,0,sizeof(fixture_mobj));
 material_gobj.user_data=&fixture_scissor;
 assert(slippi_fighter_projection_world_begin(identity.world));
 int descriptor=1;
 assert(slippi_fighter_projection_created(fp,&descriptor,sizeof(*fp)));
}
static unsigned projected_shadow_count(void)
{
 unsigned count=0;HSD_SList* node=shadow.objects;
 while(node){assert(count<3);count++;node=node->next;}
 return count;
}
static void assert_source_canonical(unsigned members,int active)
{
 assert(shadow.objects==(members?&shadow_object:NULL));
 assert(shadow_object.data==&fighter_model);
 assert(shadow_object.next==(members>1?&shadow_accessory_object:NULL));
 if(members>1){assert(shadow_accessory_object.data==&other_model);
                assert(shadow_accessory_object.next==NULL);}
 assert(shadow.active==!!active);
 assert(tobj_shadows==(active?&shadow_texture:NULL));
 assert(shadow_texture.next==NULL);
 assert(fighter_model.refs==3&&other_model.refs==7&&foreign_model.refs==11);
 assert(list_allocations==0&&list_removals==0&&jobj_refs==0&&jobj_unrefs==0);
}
static void source_draw_finish(uint64_t token,int expected,unsigned members,int active)
{
 int result=slippi_fighter_projection_draw_end();
 assert(result==expected);
 assert_source_canonical(members,active);
 assert(melee_web_cpu_interval_end(token));assert(!melee_web_cpu_interval_active());
 assert(slippi_fighter_projection_world_end(identity.world));
}
static int run_source_control(const char* mode)
{
 Fighter fp={0};HSD_GObj fighter={0};uint64_t token;
 if(strcmp(mode,"source-root")==0||strcmp(mode,"source-accessory")==0||
    strcmp(mode,"source-dedup")==0) {
  unsigned canonical=strcmp(mode,"source-dedup")==0?1:
                     strcmp(mode,"source-root")==0?1:1;
  init_source_fixture(&fp,&fighter,canonical,1,1);
  if(strcmp(mode,"source-root")==0)fp.x20A0_accessory=NULL;
  if(strcmp(mode,"source-accessory")==0)fp.invisible=1;
  if(strcmp(mode,"source-dedup")==0)fp.x20A0_accessory=&fighter_model;
  token=melee_web_cpu_interval_begin();assert(token);
  assert(slippi_fighter_projection_draw_begin());original_shadow_selector_members();
