static void psDispParticles(u32 target, u32 code)
{
    assert(actual_count < sizeof(actual) / sizeof(actual[0]));
    actual[actual_count].camera = HSD_GObj_804D7818;
    actual[actual_count].manager = HSD_GObj_804D7814;
    actual[actual_count].code = code;
    actual[actual_count].target = target;
    ++actual_count;
    assert(draw_order_count < sizeof(draw_order) / sizeof(draw_order[0]));
    draw_order[draw_order_count++] = 100u + code;
}

