int slippi_particle_presentation_world_begin(uint64_t world)
{ return world != 0; }
int slippi_particle_presentation_world_end(uint64_t world)
{ return world != 0; }
int slippi_particle_presentation_prepare(
    const struct SlippiParticlePassVisit* visits, size_t count,
    uint64_t world, uint64_t interval, char* out, size_t out_size)
{
    (void) out; (void) out_size;
    assert(world != 0);
    if (interval) assert(visits || count == 0);
    ++helper_prepare_calls;
    helper_visit_count = count;
    return 1;
}
int slippi_particle_presentation_draw_begin(uint64_t world, uint64_t interval,
                                             char* out, size_t out_size)
{
    (void) out; (void) out_size; (void) interval;
    assert(world != 0); ++helper_draw_begin_calls; return 1;
}
int slippi_particle_presentation_camera_begin(const HSD_GObj* camera,
                                              char* out, size_t out_size)
{
    (void) out; (void) out_size; assert(camera != NULL);
    ++helper_camera_begin_calls; return 1;
}
int slippi_particle_presentation_camera_end(const HSD_GObj* camera,
                                            char* out, size_t out_size)
{
    (void) out; (void) out_size; assert(camera != NULL);
    ++helper_camera_end_calls; return 1;
}
int slippi_particle_presentation_draw_end(char* out, size_t out_size)
{ (void) out; (void) out_size; ++helper_draw_end_calls; return 1; }
int slippi_particle_presentation_reset_after_restore(
    SlippiParticlePresentationAnchor anchor)
{ return anchor.world != 0; }
int slippi_particle_presentation_interval_end(uint64_t world, uint64_t interval)
{ (void) interval; ++helper_interval_end_calls; return world != 0; }

