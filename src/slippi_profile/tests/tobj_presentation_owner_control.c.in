extern HSD_TObjInfo hsdTObj;
void fixture_tobj_update(HSD_TObj*, float);
void fixture_tobj_update_type(HSD_TObj*, u32, float);
void fixture_tobj_setup(HSD_TObj*);
void fixture_tobj_amnesia(void);
HSD_TObj* fixture_actual_shadow(void);
void fixture_actual_make(HSD_TObj*);
int fixture_tobj_default_callbacks(void);
