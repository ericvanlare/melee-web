static _Noreturn void stop(const char* s) {
    fprintf(stderr, "UNSUPPORTED:%s\n", s);
    exit(91);
}
static void require(int yes, const char* s) {
    if (!yes) {
        fprintf(stderr, "CONTROL_FAIL:%s\n", s);
        exit(92);
    }
}
void __assert(char* f, u32 l, char* s) {
    fprintf(stderr, "SOURCE_ASSERT:%s:%u:%s\n", f, l, s);
    exit(93);
}
void HSD_Panic(char* f, u32 l, char* s) {
    fprintf(stderr, "SOURCE_PANIC:%s:%u:%s\n", f, l, s);
    exit(94);
}
void OSReport(const char* format, ...) {
    char message[512];
    va_list args;
    va_start(args, format);
    vsnprintf(message, sizeof(message), format, args);
    va_end(args);
    if (!strncmp(message, "FIRST_FAILURE_CONTEXT=", 22)) {
        fputs(message, stderr);
        return;
    }
    fprintf(stderr, "UNSUPPORTED_OSREPORT:%s\n", message);
    exit(91);
}

alignas(32) static unsigned char arena[1 << 20];
static size_t used;
static unsigned constructed, released, freed, descriptors;
static unsigned host_allocs;
static int fail_host_alloc;
void* __real_malloc(size_t);
void* __real_calloc(size_t, size_t);
void* __wrap_malloc(size_t n) {
    ++host_allocs;
    if (fail_host_alloc) return NULL;
    return __real_malloc(n);
}
void* __wrap_calloc(size_t n, size_t size) {
    ++host_allocs;
    if (fail_host_alloc) return NULL;
    return __real_calloc(n, size);
}

/* Explicit source allocation model; original class-piece split/free-list code
 * remains under test. These are not rollback snapshots or GPU storage. */
void* (HSD_MemAlloc)(ssize_t n) {
    require(n > 0, "positive source alloc");
    size_t p = (used + 31) & ~(size_t) 31;
    require((size_t) n <= sizeof(arena) - p, "arena bound");
    used = p + (size_t) n;
    return arena + p;
}
void* melee_web_HSD_MemAllocAt(ssize_t n, const char* f, unsigned l) {
    (void) f;
    (void) l;
    return (HSD_MemAlloc)(n);
}
void HSD_Free(void* p) {
    (void) p;
    stop("source allocation table growth/free outside fixture");
}
void HSD_AObjRemove(HSD_AObj* p) {
    require(p == NULL, "null-only AObj provider");
    ++released;
}
void melee_web_class_piece_cold(const void* p, int32_t n) {
    (void) p;
    (void) n;
}
void melee_web_class_piece_descriptor(const void* p) {
    require(p != NULL, "descriptor callback");
    ++descriptors;
}
void melee_web_class_piece_alloc(void* p, int32_t n, uint32_t z) {
    require(p && n > 0 && z >= (uint32_t) n, "piece event");
}
void melee_web_class_piece_promote(void* p, int32_t n) {
    (void) p;
    (void) n;
    stop("unexpected old table promotion");
}
void melee_web_class_piece_free(void* p, int32_t n) {
    require(p && n > 0, "free event");
    ++freed;
}
void melee_web_class_piece_label(void* p, const void* i, int32_t n,
                                 uint32_t s, const void* old) {
    (void) old;
    require(p && i && n > 0, "label event");
    if (s == 2) ++constructed;
}
void melee_web_class_piece_amnesia(void) {}
void slippi_lobj_constructed(void* p, void* i) {
    require(p != NULL, "foreign-class constructor leaf");
    (void) i;
}
void slippi_lobj_retiring(void* p) { require(p != NULL, "retire leaf"); }
void slippi_lobj_rebound(void* p, void* a, void* b) {
    require(p && a && b, "actual successful rebind leaf");
}

