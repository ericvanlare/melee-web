/* Test-only accessors inspect the ACTUAL module in this TU; no replacement
 * lineage, callback or cache implementation. Not production exports. */
static int component_member(const void* p){for(TObjOwner* e=owners;e;e=e->next)if(e->object==p)return !e->poisoned&&e->world==owner_world;return 0;}
static uint64_t component_token(const void* p){for(TObjOwner* e=owners;e;e=e->next)if(e->object==p)return e->generation;return 0;}
static int component_token_admit(const void* p,uint64_t g){for(TObjOwner* e=owners;e;e=e->next)if(e->object==p)return e->generation==g&&admissible(e)&&!first_failure;return 0;}
static uint64_t component_serial(void){return owner_serial;}
static unsigned component_failure(void){return slippi_tobj_failure();}
#endif
u32 fixture_flags(HSD_TObj*);MtxPtr fixture_matrix(HSD_TObj*);int fixture_reload(HSD_TObj*,HSD_TObjDesc*);
extern HSD_TObjInfo hsdTObj;
