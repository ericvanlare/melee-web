_Noreturn void HSD_TExpColorOp(HSD_TExp* p,GXTevOp a,GXTevBias b,GXTevScale c,u8 d){(void)p;(void)a;(void)b;(void)c;(void)d;stop("TExpColorOp");}
_Noreturn void HSD_TExpAlphaOp(HSD_TExp* p,GXTevOp a,GXTevBias b,GXTevScale c,u8 d){(void)p;(void)a;(void)b;(void)c;(void)d;stop("TExpAlphaOp");}
