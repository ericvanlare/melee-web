_Noreturn void PSVECNormalize(const Vec* src,Vec* dst){(void)src;(void)dst;stop("unsupported highlight PSVECNormalize");}
/* Canonical make_texp stays actual in the source; reaching its providers is unsupported. */
_Noreturn HSD_TExp* HSD_TExpTev(HSD_TExp** p){(void)p;stop("TExpTev");}
_Noreturn HSD_TExp* HSD_TExpCnst(void* p,HSD_TEInput a,HSD_TEType b,HSD_TExp** q){(void)p;(void)a;(void)b;(void)q;stop("TExpCnst");}
