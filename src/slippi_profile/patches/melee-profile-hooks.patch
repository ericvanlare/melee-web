 void HSD_PerfInitStat(void)
 {
+#if defined(MELEE_WEB_SLIPPI_PARTICLE_PRESENTATION_CACHE) && MELEE_WEB_SLIPPI_PARTICLE_PRESENTATION_CACHE
+    HSD_PerfStat* current = slippi_hsd_perf_measurement_current();
+    HSD_PerfStat* last = slippi_hsd_perf_measurement_last_for_init();
+    HSD_ASSERT(0xA1, current != 0 && last != 0);
+    if (current == 0 || last == 0) __builtin_trap();
+    *last = *current;
+    memset(current, 0, sizeof(HSD_PerfStat));
+#else
     HSD_PerfLastStat = HSD_PerfCurrentStat;
     memset(&HSD_PerfCurrentStat, 0, sizeof(HSD_PerfStat));
+#endif
