 void HSD_PerfSetStartTime(void)
 {
+#if defined(MELEE_WEB_SLIPPI_PARTICLE_PRESENTATION_CACHE) && MELEE_WEB_SLIPPI_PARTICLE_PRESENTATION_CACHE
+    s64* start = slippi_hsd_perf_measurement_start_time();
+    HSD_ASSERT(0xA2, start != 0);
+    if (start == 0) __builtin_trap();
+    *start = OSGetTime();
+#else
     start_time = OSGetTime();
+#endif
 }
 
 void HSD_PerfSetCPUTime(void)
 {
+#if defined(MELEE_WEB_SLIPPI_PARTICLE_PRESENTATION_CACHE) && MELEE_WEB_SLIPPI_PARTICLE_PRESENTATION_CACHE
+    HSD_PerfStat* current = slippi_hsd_perf_measurement_current();
+    s64* start = slippi_hsd_perf_measurement_start_time();
+    HSD_ASSERT(0xA3, current != 0 && start != 0);
+    if (current == 0 || start == 0) __builtin_trap();
+    current->cpu_time =
+        (OSGetTime() - *start) / (f32) (OSSecondsToTicks(1) / 60);
+#else
     HSD_PerfCurrentStat.cpu_time =
         (OSGetTime() - start_time) / (f32) (OSSecondsToTicks(1) / 60);
+#endif
 }
 
