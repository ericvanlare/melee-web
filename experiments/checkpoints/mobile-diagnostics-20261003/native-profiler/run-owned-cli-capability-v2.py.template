#!/usr/bin/env python3
"""Bounded owner for the inert, one-process native trace capability check."""
import hashlib
import json
import os
import signal
import socket
import subprocess
import threading
import time
from pathlib import Path

BASE = Path(__file__).resolve().parent
ROOT = Path('__LOCAL_CHECKOUT__')
WEBKIT = '__LOCAL_WEBKIT_RUNTIME_ROOT__/'
RUNNER = BASE / 'run-xctrace-inert-worker-v2.py'
OUT = BASE / 'attempt-02'
RECEIPT = BASE / 'attempt-02-owner-receipt.json'
assert not OUT.exists() and not RECEIPT.exists(), 'Preserve prior attempts'
assert RUNNER.is_file(), 'Reviewed v2 runner required'
started = time.monotonic()
receipt = {'schema': 'webmelee-owned-native-capability-v1', 'started_at': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()), 'process_cap_seconds': 60, 'cleanup_cap_seconds': 5, 'scope': 'Inert CLI worker only, natural recorder lifecycle; no browser or game', 'result': 'running'}
owned = {}
before = {}
process = None
watcher = None
stopped = threading.Event()

def inventory():
    comm = subprocess.check_output(['/bin/ps', '-axo', 'pid=,ppid=,pgid=,comm='], text=True, timeout=2)
    argv = subprocess.check_output(['/bin/ps', '-axo', 'pid=,args='], text=True, timeout=2)
    args = {int(a[0]): a[1] for line in argv.splitlines() if len(a := line.strip().split(None, 1)) == 2}
    return {int(a[0]): {'parent': int(a[1]), 'pgid': int(a[2]), 'command': a[3], 'args': args.get(int(a[0]))}
            for line in comm.splitlines() if len(a := line.strip().split(None, 3)) == 4}

def collect():
    current = inventory()
    family = {process.pid}
    while True:
        children = {pid for pid, row in current.items() if row['parent'] in family}
        if children <= family:
            break
        family.update(children)
    for pid, row in current.items():
        if pid in family or (pid not in before and row['command'].startswith(WEBKIT)):
            owned[pid] = row

def live_owned():
    current = inventory()
    return {pid: row for pid, row in owned.items() if current.get(pid, {}).get('command') == row['command'] and current.get(pid, {}).get('args') == row['args']}

def monitor():
    while not stopped.wait(.25):
        try:
            collect()
        except Exception as error:
            receipt.setdefault('monitor_errors', []).append(type(error).__name__)

try:
    before = inventory()
    assert not any(row['command'].startswith(WEBKIT) for row in before.values()), 'Pinned WebKit runtime already active; do not interfere'
    receipt['runner_sha256'] = hashlib.sha256(RUNNER.read_bytes()).hexdigest()
    command = ['python3', 'scripts/agent_workspace.py', 'run', '--', 'python3', str(RUNNER), '--out', str(OUT)]
    with (BASE / 'attempt-02.log').open('x') as log:
        process = subprocess.Popen(command, cwd=ROOT, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
        receipt['leader_pid'] = process.pid
        collect()
        watcher = threading.Thread(target=monitor, daemon=True)
        watcher.start()
        receipt['exit_code'] = process.wait(timeout=max(1, 60 - (time.monotonic() - started)))
    receipt['result'] = 'completed' if receipt['exit_code'] == 0 else 'failed'
except BaseException as error:
    receipt['result'] = 'failed'
    receipt['failure'] = str(error)
finally:
    stopped.set()
    if watcher:
        watcher.join(timeout=1)
    if process:
        try:
            collect()
            receipt['cleanup_before'] = [{'pid': pid, **row} for pid, row in live_owned().items()]
            deadline = time.monotonic() + 5
            for pid in live_owned():
                try:
                    os.kill(pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
            while live_owned() and time.monotonic() < deadline - 2:
                time.sleep(.05)
            for pid in live_owned():
                try:
                    os.kill(pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
            if process.poll() is None:
                process.wait(timeout=max(.1, deadline - time.monotonic()))
            receipt['cleanup_remaining'] = [{'pid': pid, **row} for pid, row in live_owned().items()]
            if receipt['cleanup_remaining']:
                receipt['result'] = 'failed'
        except BaseException as error:
            receipt['result'] = 'failed'
            receipt['cleanup_error'] = str(error)
        receipt['owned_processes'] = [{'pid': pid, **row} for pid, row in owned.items()]
    report_path = OUT / 'report.json'
    if report_path.exists():
        receipt['report_sha256'] = hashlib.sha256(report_path.read_bytes()).hexdigest()
        try:
            report = json.loads(report_path.read_text())
            receipt['runner_status'] = report['status']
            from urllib.parse import urlparse
            url = urlparse(report.get('page', {}).get('url') or '')
            if url.hostname == '127.0.0.1' and url.port:
                with socket.socket() as probe:
                    probe.settimeout(.2)
                    receipt['port_connect_ex'] = probe.connect_ex((url.hostname, url.port))
                if receipt['port_connect_ex'] == 0:
                    receipt['result'] = 'failed'
        except Exception as error:
            receipt['result'] = 'failed'
            receipt['report_error'] = str(error)
    if receipt.get('monitor_errors'):
        receipt['result'] = 'failed'
    receipt['elapsed_seconds'] = time.monotonic() - started
    receipt['finished_at'] = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())
    RECEIPT.write_text(json.dumps(receipt, indent=2) + '\n')
    print(json.dumps({k: v for k, v in receipt.items() if k != 'owned_processes'}))
if receipt['result'] != 'completed':
    raise SystemExit(1)
