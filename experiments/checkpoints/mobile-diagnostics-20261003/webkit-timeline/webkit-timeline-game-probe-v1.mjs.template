    if (context) { try { await boundedClose(context, cleanupDeadline, 'context close'); report.cleanup.context_closed = true; } catch (error) { report.cleanup.errors.push(`context_close:${boundedError(error)}`); } }
    if (browser) { try { await boundedClose(browser, cleanupDeadline, 'browser close'); report.cleanup.browser_closed = true; } catch (error) { report.cleanup.errors.push(`browser_close:${boundedError(error)}`); } }
    if (server) { try { await withDeadline(new Promise((resolve, reject) => server.close(error => error ? reject(error) : resolve())), cleanupDeadline, 'server close'); report.cleanup.server_closed = true; } catch (error) { report.cleanup.errors.push(`server_close:${boundedError(error)}`); } }
    if (report.cleanup.errors.length) {
      report.status = 'fail';
      report.result = 'failure';
      failCode('cleanup_error');
    }
    report.timing.finished_monotonic_ms = performance.now();
    report.timing.elapsed_ms = report.timing.finished_monotonic_ms - started;
    report.failure_codes = Array.from(new Set(report.failure_codes));
    report.browser.event_drops_total = Object.values(report.browser.event_drops).reduce((sum, value) => sum + value, 0);
    if (report.failure_code_drops) report.status = 'fail';
    await fs.writeFile(path.join(args.out, 'report.json'), `${JSON.stringify(report, null, 2)}\n`, { flag: 'wx' });
  }
  if (report.status !== 'pass') process.exitCode = 1;
}

main().catch(error => { console.error(boundedError(error)); process.exitCode = 1; });
