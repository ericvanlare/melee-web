+  const auto history_first = m_local_pad_queue.back()->frame;
+  const auto history_last = m_local_pad_queue.front()->frame;
+  const auto history_count = m_local_pad_queue.size();
+  if (m_rollback_diagnostic.IsHoldFrame(frame))
+  {
+    if (m_diagnostic_held_pad_packets.size() >= MAX_DIAGNOSTIC_HELD_PAD_PACKETS)
+      m_rollback_diagnostic.Fail("diagnostic hold packet queue exceeded its eight-packet bound");
+    const bool is_begin = m_diagnostic_held_pad_packets.empty();
+    const std::string payload_hash = PacketHash(*spac);
+    m_diagnostic_held_pad_packets.push_back(
+        {std::move(spac), frame, payload_hash});
+    m_rollback_diagnostic.Record({{"event", "pad_transport"},
+                                  {"action", is_begin ? "hold_begin" : "hold"},
+                                  {"packet_frame", frame},
+                                  {"payload_hash", payload_hash},
+                                  {"begin_count", is_begin ? 1 : 0},
+                                  {"held_count", m_diagnostic_held_pad_packets.size()},
+                                  {"history_count", history_count},
+                                  {"history_first_frame", history_first},
+                                  {"history_last_frame", history_last}},
+                                  SlippiRollbackDiagnostic::ObserverContext::TRANSPORT);
+    return;
+  }
+
+  if (m_rollback_diagnostic.IsDropFrame(frame))
+  {
+    m_rollback_diagnostic.ConsumeTransportFrame(frame);
+    m_rollback_diagnostic.Record({{"event", "pad_transport"},
+                                  {"action", "drop"},
+                                  {"packet_frame", frame},
+                                  {"payload_hash", PacketHash(*spac)},
+                                  {"drop_count", 1},
+                                  {"history_count", history_count},
+                                  {"history_first_frame", history_first},
+                                  {"history_last_frame", history_last}},
+                                  SlippiRollbackDiagnostic::ObserverContext::TRANSPORT);
+    return;
+  }
+
+  if (!m_diagnostic_held_pad_packets.empty() && frame >= m_rollback_diagnostic.ReleaseFrame())
+  {
+    const std::size_t release_count = m_diagnostic_held_pad_packets.size();
+    nlohmann::json held_frames = nlohmann::json::array();
+    nlohmann::json held_hashes = nlohmann::json::array();
+    for (const auto& held_packet : m_diagnostic_held_pad_packets)
+    {
+      held_frames.push_back(held_packet.frame);
+      held_hashes.push_back(held_packet.payload_hash);
+    }
+    const std::string release_hash = PacketHash(*spac);
+    while (!m_diagnostic_held_pad_packets.empty())
+    {
+      SendAsync(std::move(m_diagnostic_held_pad_packets.front().packet));
+      m_diagnostic_held_pad_packets.pop_front();
+    }
+    m_rollback_diagnostic.Record({{"event", "pad_transport"},
+                                  {"action", "hold_release"},
+                                  {"release_packet_frame", frame},
+                                  {"release_payload_hash", release_hash},
+                                  {"release_count", release_count},
+                                  {"held_frames", held_frames},
+                                  {"held_payload_hashes", held_hashes},
+                                  {"history_count", history_count},
+                                  {"history_first_frame", history_first},
+                                  {"history_last_frame", history_last}},
+                                  SlippiRollbackDiagnostic::ObserverContext::TRANSPORT);
+  }
+
   SendAsync(std::move(spac));
   u64 time = Common::Timer::NowUs();
 
