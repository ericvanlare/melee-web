+std::string PacketHash(const sf::Packet& packet)
+{
+  constexpr u64 FNV_OFFSET = 14695981039346656037ULL;
+  constexpr u64 FNV_PRIME = 1099511628211ULL;
+  u64 hash = FNV_OFFSET;
+  const auto* bytes = static_cast<const u8*>(packet.getData());
+  for (std::size_t index = 0; index < packet.getDataSize(); ++index)
+  {
+    hash ^= bytes[index];
+    hash *= FNV_PRIME;
+  }
+
+  std::ostringstream stream;
+  stream << std::hex << std::setfill('0') << std::setw(16) << hash;
+  return stream.str();
+}
