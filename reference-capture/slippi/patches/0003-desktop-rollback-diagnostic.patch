+      memory.GetPointerForRange(values.rxb_address, values.rxb_size) == nullptr ||
+      (values.sscb_address != 0 &&
+       memory.GetPointerForRange(values.sscb_address, values.sscb_size) == nullptr))
+  {
+    diagnostic.Fail("rollback preservation block is outside emulated memory");
+  }
+  auto odb_u8 = [&](u32 offset) {
+    return memory.Read_U8(DiagnosticAddress(diagnostic, values.odb_address, values.odb_size,
+                                            offset, 1));
+  };
+  auto odb_u32 = [&](u32 offset) {
+    return memory.Read_U32(DiagnosticAddress(diagnostic, values.odb_address, values.odb_size,
+                                             offset, 4));
+  };
+  auto rxb_u32 = [&](u32 offset) {
+    return memory.Read_U32(DiagnosticAddress(diagnostic, values.rxb_address, values.rxb_size,
+                                             offset, 4));
+  };
+  event["odb"] = {{"frame", odb_u32(ODB_FRAME)},
+                  {"delay_frames", odb_u8(ODB_DELAY_FRAMES)},
+                  {"txb_addr", odb_u32(ODB_TXB_ADDR)},
