+
+u32 DiagnosticWord(const u8* payload, u32 offset)
+{
+  return Common::swap32(&payload[offset]);
+}
+
+DiagnosticPreservation ReadDiagnosticPreservation(SlippiRollbackDiagnostic& diagnostic,
+                                                  const u8* payload)
+{
+  DiagnosticPreservation values{DiagnosticWord(payload, 4), DiagnosticWord(payload, 8),
+                                DiagnosticWord(payload, 12), DiagnosticWord(payload, 16),
+                                DiagnosticWord(payload, 20), DiagnosticWord(payload, 24)};
+  if (DiagnosticWord(payload, 28) != 0 || values.odb_address == 0 || values.odb_size == 0 ||
+      values.rxb_address == 0 || values.rxb_size == 0 || values.sscb_address == 0 ||
+      values.sscb_size == 0)
+  {
+    diagnostic.Fail("malformed savestate preservation array");
+  }
+  if (values.odb_size != ASM_ODB_SIZE || values.rxb_size != ASM_RXB_SIZE ||
+      values.sscb_size != ASM_SSCB_SIZE)
+  {
+    diagnostic.Fail("savestate preservation block size does not match pinned ASM");
+  }
+  return values;
+}
+
+u32 DiagnosticAddress(SlippiRollbackDiagnostic& diagnostic, u32 address, u32 size, u32 offset,
+                      u32 width)
+{
+  if (offset > size || width > size - offset ||
+      address > std::numeric_limits<u32>::max() - offset)
+    diagnostic.Fail("rollback observation field exceeds preserved block");
+  return address + offset;
+}
+
+void AddRollbackSnapshot(SlippiRollbackDiagnostic& diagnostic, nlohmann::json& event,
