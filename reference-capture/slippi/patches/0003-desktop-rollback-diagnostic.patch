+                  {"stable_finalized_frame", odb_u32(ODB_STABLE_FINALIZED_FRAME)},
+                  {"finalized_frame", odb_u32(ODB_FINALIZED_FRAME)}};
+  event["rxb"] = {{"latest_frame_p0", rxb_u32(RXB_OPNT_FRAME_NUMS)},
+                  {"latest_frame_p1", rxb_u32(RXB_OPNT_FRAME_NUMS + 4)},
+                  {"latest_frame_p2", rxb_u32(RXB_OPNT_FRAME_NUMS + 8)},
+                  {"smallest_latest_frame", rxb_u32(RXB_SMALLEST_LATEST_FRAME)}};
+  event["preservation"] = {{"odb_address", values.odb_address},
