diff --git a/Source/Core/Core/Slippi/SlippiRollbackDiagnostic.cpp b/Source/Core/Core/Slippi/SlippiRollbackDiagnostic.cpp
new file mode 100644
index 0000000000..7bc998c77d
--- /dev/null
+++ b/Source/Core/Core/Slippi/SlippiRollbackDiagnostic.cpp
@@ -0,0 +1,385 @@
+// Copyright 2026 Melee Web contributors
+// Licensed under GPLv2+
+// Refer to the license.txt file included.
+
+#include "Core/Slippi/SlippiRollbackDiagnostic.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <iomanip>
+#include <initializer_list>
+#include <limits>
+#include <mutex>
+#include <sstream>
+#include <utility>
+
+namespace
+{
+constexpr std::string_view SCHEMA = "melee-web-slippi-rollback-diagnostic-v1";
+constexpr s32 MAX_FRAME = 1'000'000;
+constexpr s32 MAX_HOLD_FRAMES = 8;
+constexpr u32 FINAL_DESTINATION_STAGE_ID = 0x20;
+constexpr std::string_view PROFILE_NAME = "mario-fd-rollback-v1";
+
+using json = nlohmann::json;
+
+[[noreturn]] void Fatal(std::string_view reason)
+{
+  std::fputs("[slippi rollback diagnostic] ", stderr);
+  std::fwrite(reason.data(), 1, reason.size(), stderr);
+  std::fputc('\n', stderr);
+  std::fflush(stderr);
+  std::abort();
+}
+
+const json& Member(const json& object, std::string_view key)
+{
+  if (!object.is_object())
+    Fatal("diagnostic config member lookup requires an object");
+  const auto iterator = object.find(std::string(key));
+  if (iterator == object.end())
+    Fatal("diagnostic config is missing a required member");
+  return iterator.value();
+}
+
+void CheckObjectKeys(const json& object, std::initializer_list<std::string_view> required,
+                     std::string_view name)
+{
+  if (!object.is_object())
+    Fatal(std::string(name) + " must be an object");
+
+  for (auto iterator = object.begin(); iterator != object.end(); ++iterator)
+  {
+    const std::string& key = iterator.key();
+    const auto known = std::find_if(required.begin(), required.end(),
+                                    [&key](std::string_view required_key) {
+                                      return required_key == key;
+                                    });
+    if (known == required.end())
+      Fatal(std::string(name) + " has an unknown key");
+  }
+  for (const std::string_view key : required)
+  {
+    if (object.find(std::string(key)) == object.end())
+      Fatal(std::string(name) + " is missing a required key");
+  }
+}
+
+bool ReadBool(const json& object, std::string_view key)
+{
+  const json& value = Member(object, key);
+  if (!value.is_boolean())
+    Fatal(std::string(key) + " must be a boolean");
+  return value.get<bool>();
+}
+
+u32 ReadU32(const json& object, std::string_view key, u32 maximum)
+{
+  const json& value = Member(object, key);
+  if (value.is_number_unsigned())
+  {
+    const std::uint64_t unsigned_value = value.get<std::uint64_t>();
+    if (unsigned_value > maximum)
+      Fatal(std::string(key) + " is outside its bounded range");
+    return static_cast<u32>(unsigned_value);
+  }
+  if (!value.is_number_integer())
+    Fatal(std::string(key) + " must be an integer");
+  const std::int64_t signed_value = value.get<std::int64_t>();
+  if (signed_value < 0 || static_cast<std::uint64_t>(signed_value) > maximum)
+    Fatal(std::string(key) + " is outside its bounded range");
+  return static_cast<u32>(signed_value);
+}
+
+s32 ReadFrame(const json& object, std::string_view key)
+{
+  const u32 frame = ReadU32(object, key, MAX_FRAME);
+  if (frame == 0)
+    Fatal(std::string(key) + " must be at least one");
+  return static_cast<s32>(frame);
+}
+
+u8 HexNibble(char value)
+{
+  if (value >= '0' && value <= '9')
+    return static_cast<u8>(value - '0');
+  if (value >= 'a' && value <= 'f')
+    return static_cast<u8>(value - 'a' + 10);
+  if (value >= 'A' && value <= 'F')
+    return static_cast<u8>(value - 'A' + 10);
+  Fatal("overlay.pad_hex contains a non-hex character");
+}
+
+std::array<u8, 8> ReadPad(const json& object)
+{
+  const json& value = Member(object, "pad_hex");
+  if (!value.is_string())
+    Fatal("overlay.pad_hex must be a string");
+  const std::string text = value.get<std::string>();
+  if (text.size() != 16)
+    Fatal("overlay.pad_hex must contain exactly 16 hex characters");
+
+  std::array<u8, 8> pad{};
+  for (std::size_t index = 0; index < pad.size(); ++index)
+    pad[index] = static_cast<u8>((HexNibble(text[index * 2]) << 4) |
+                                 HexNibble(text[index * 2 + 1]));
+  return pad;
+}
+
+std::string Hex(const u8* bytes, std::size_t size)
+{
+  std::ostringstream stream;
+  stream << std::hex << std::setfill('0');
+  for (std::size_t index = 0; index < size; ++index)
+    stream << std::setw(2) << static_cast<int>(bytes[index]);
+  return stream.str();
+}
+
+SlippiRollbackDiagnostic::Config ParseConfig(const json& root)
+{
+  CheckObjectKeys(root, {"schema", "enabled", "rng_offset", "log_path", "stage_id",
+                         "input_profile", "overlay", "transport"},
+                  "config");
+  const json& schema = Member(root, "schema");
+  if (!schema.is_string() || schema.get<std::string>() != SCHEMA)
+    Fatal("diagnostic config has an unsupported schema");
+
+  SlippiRollbackDiagnostic::Config config;
+  config.enabled = ReadBool(root, "enabled");
+  config.rng_offset = ReadU32(root, "rng_offset", 0xffff);
+  const json& log_path = Member(root, "log_path");
+  if (!log_path.is_string())
+    Fatal("log_path must be a string");
+  config.log_path = log_path.get<std::string>();
+  if (config.log_path.empty() || config.log_path.find('\0') != std::string::npos)
+    Fatal("log_path must be nonempty and contain no NUL");
+  if (!Member(root, "stage_id").is_null())
+  {
+    const u32 stage_id = ReadU32(root, "stage_id", 0xffff);
+    if (stage_id != FINAL_DESTINATION_STAGE_ID)
+      Fatal("stage_id must be Final Destination (0x20)");
+    config.stage_id = static_cast<u16>(stage_id);
+  }
+
+  const json& profile = Member(root, "input_profile");
+  if (!profile.is_null())
+  {
+    CheckObjectKeys(profile, {"name", "role"}, "input_profile");
+    const json& profile_name = Member(profile, "name");
+    if (!profile_name.is_string() || profile_name.get<std::string>() != PROFILE_NAME)
+      Fatal("input_profile.name must be mario-fd-rollback-v1");
+    const u32 role = ReadU32(profile, "role", 2);
+    if (role < 1)
+      Fatal("input_profile.role must be 1 or 2");
+    config.input_profile = SlippiRollbackDiagnostic::Config::InputProfile{
+        std::string(PROFILE_NAME), static_cast<u8>(role)};
+  }
+
+  const json& overlay = Member(root, "overlay");
+  if (!overlay.is_null())
+  {
+    CheckObjectKeys(overlay, {"frame", "pad_hex"}, "overlay");
+    config.overlay_frame = ReadFrame(overlay, "frame");
+    config.overlay_pad = ReadPad(overlay);
+  }
+
+  const json& transport = Member(root, "transport");
+  CheckObjectKeys(transport, {"action", "frame", "release_frame"}, "transport");
+  const json& action_value = Member(transport, "action");
+  if (!action_value.is_string())
+    Fatal("transport.action must be a string");
+  const std::string action = action_value.get<std::string>();
+  if (action == "none")
+  {
+    if (!Member(transport, "frame").is_null() || !Member(transport, "release_frame").is_null())
+      Fatal("transport none requires null frame and release_frame");
+  }
+  else if (action == "drop")
+  {
+    config.transport_action = SlippiRollbackDiagnostic::TransportAction::DROP;
+    if (Member(transport, "frame").is_null() || !Member(transport, "release_frame").is_null())
+      Fatal("transport drop requires a frame and null release_frame");
+    config.transport_frame = ReadFrame(transport, "frame");
+  }
+  else if (action == "hold")
+  {
+    config.transport_action = SlippiRollbackDiagnostic::TransportAction::HOLD;
+    if (Member(transport, "frame").is_null() || Member(transport, "release_frame").is_null())
+      Fatal("transport hold requires frame and release_frame");
+    config.transport_frame = ReadFrame(transport, "frame");
+    config.transport_release_frame = ReadFrame(transport, "release_frame");
+    if (*config.transport_release_frame <= *config.transport_frame ||
+        *config.transport_release_frame - *config.transport_frame > MAX_HOLD_FRAMES)
+    {
+      Fatal("transport hold release is outside its bounded range");
+    }
+  }
+  else
+  {
+    Fatal("transport.action must be none, drop, or hold");
+  }
+
+  if (!config.enabled &&
+      (config.stage_id.has_value() || config.input_profile.has_value() ||
+       config.overlay_frame.has_value() || config.transport_action !=
+                                                 SlippiRollbackDiagnostic::TransportAction::NONE))
+  {
+    Fatal("disabled diagnostic config contains active controls");
+  }
+  return config;
+}
+}  // namespace
+
+SlippiRollbackDiagnostic SlippiRollbackDiagnostic::FromEnvironment()
+{
+  const char* path = std::getenv("SLIPPI_ROLLBACK_DIAGNOSTIC_CONFIG");
+  if (path == nullptr || path[0] == '\0')
+    return SlippiRollbackDiagnostic(Config{});
+
+  std::ifstream stream(path);
+  if (!stream)
+    Fatal("could not open rollback diagnostic config");
+  const json parsed = json::parse(stream, nullptr, false);
+  if (parsed.is_discarded())
+    Fatal("invalid rollback diagnostic config: malformed JSON");
+  if (!parsed.is_object())
+    Fatal("invalid rollback diagnostic config: root must be an object");
+  return SlippiRollbackDiagnostic(ParseConfig(parsed));
+}
+
+void SlippiRollbackDiagnostic::ResetMatch()
+{
+  m_overlay_applied = false;
+  m_transport_used = false;
+  ++m_game_sequence;
+}
+
+void SlippiRollbackDiagnostic::ApplyInputProfile(s32 source_frame, u8 delay, u8* inputs)
+{
+  if (!Enabled() || !m_config.input_profile)
+    return;
+  if (inputs == nullptr)
+    Fail("input profile received a null TXB pad pointer");
+
+  std::array<u8, 8> generated{};
+  const u8 role = m_config.input_profile->role;
+  if (role == 1 && source_frame >= 90 && source_frame <= 139)
+    generated[2] = 0x7f;
+  else if (role == 1 && source_frame >= 150)
+    generated[2] = 0x81;
+  else if (role == 2 && source_frame >= 90 && source_frame <= 126)
+    generated[2] = 0x81;
+  if (role == 2 && source_frame >= 96 && source_frame <= 100)
+    generated[0] = 0x01;
+
+  std::copy(generated.begin(), generated.end(), inputs);
+  Record({{"event", "input_profile"},
+          {"profile", m_config.input_profile->name},
+          {"role", role},
+          {"source_frame", source_frame},
+          {"consumed_frame", source_frame + delay},
+          {"delay", delay},
+          {"generated_pad_hex", Hex(generated.data(), generated.size())},
+          {"pad_after_hex", Hex(inputs, 12)},
+          {"preserved_tail_hex", Hex(inputs + 8, 4)}}, ObserverContext::EXI);
+}
+
+void SlippiRollbackDiagnostic::ApplyInputOverlay(s32 source_frame, u8 delay, u8* inputs)
+{
+  if (!Enabled() || !m_config.overlay_frame || m_overlay_applied ||
+      source_frame != *m_config.overlay_frame)
+  {
+    return;
+  }
+  if (inputs == nullptr)
+    Fail("input overlay received a null TXB pad pointer");
+
+  const std::string before = Hex(inputs, 12);
+  std::copy(m_config.overlay_pad.begin(), m_config.overlay_pad.end(), inputs);
+  m_overlay_applied = true;
+  Record({{"event", "input_overlay"},
+          {"source_frame", source_frame},
+          {"consumed_frame", source_frame + delay},
+          {"pad_before_hex", before},
+          {"pad_after_hex", Hex(inputs, 12)},
+          {"preserved_tail_hex", Hex(inputs + 8, 4)}}, ObserverContext::EXI);
+}
+
+u32 SlippiRollbackDiagnostic::OverrideRngOffset(u32 generated) const
+{
+  return Enabled() ? m_config.rng_offset : generated;
+}
+
+std::optional<u16> SlippiRollbackDiagnostic::StageOverride() const
+{
+  return Enabled() ? m_config.stage_id : std::nullopt;
+}
+
+std::optional<u8> SlippiRollbackDiagnostic::InputProfileRole() const
+{
+  return Enabled() && m_config.input_profile ? std::optional<u8>(m_config.input_profile->role) :
+                                                std::nullopt;
+}
+
+bool SlippiRollbackDiagnostic::IsTransportFrame(s32 packet_frame) const
+{
+  return IsHoldFrame(packet_frame) || IsDropFrame(packet_frame);
+}
+
+bool SlippiRollbackDiagnostic::IsHoldFrame(s32 packet_frame) const
+{
+  return Enabled() && m_config.transport_action == TransportAction::HOLD &&
+         m_config.transport_frame && m_config.transport_release_frame &&
+         packet_frame >= *m_config.transport_frame &&
+         packet_frame < *m_config.transport_release_frame;
+}
+
+bool SlippiRollbackDiagnostic::IsDropFrame(s32 packet_frame) const
+{
+  return Enabled() && !m_transport_used && m_config.transport_frame &&
+         m_config.transport_action == TransportAction::DROP &&
+         packet_frame == *m_config.transport_frame;
+}
+
+bool SlippiRollbackDiagnostic::ConsumeTransportFrame(s32 packet_frame)
+{
+  if (!IsDropFrame(packet_frame))
+    return false;
+  m_transport_used = true;
+  return true;
+}
+
+s32 SlippiRollbackDiagnostic::ReleaseFrame() const
+{
+  return m_config.transport_release_frame.value_or(std::numeric_limits<s32>::max());
+}
+
+void SlippiRollbackDiagnostic::Record(const nlohmann::json& event,
+                                      ObserverContext context) const
+{
+  if (!Enabled())
+    return;
+  static std::mutex mutex;
+  std::lock_guard lock(mutex);
+  std::ofstream stream(m_config.log_path, std::ios::out | std::ios::app);
+  if (!stream)
+    Fail("could not open rollback diagnostic log");
+  auto row = event;
+  row["diagnostic_schema"] = SCHEMA;
+  row["observer_context"] = context == ObserverContext::EXI ? "exi" : "transport";
+  row["game_sequence"] = m_game_sequence;
+  u64& event_sequence = context == ObserverContext::EXI ? m_exi_event_sequence :
+                                                            m_transport_event_sequence;
+  row["event_sequence"] = event_sequence++;
+  stream << row.dump() << '\n';
+  if (!stream)
+    Fail("could not write rollback diagnostic log");
+}
+
+[[noreturn]] void SlippiRollbackDiagnostic::Fail(std::string_view reason) const
+{
+  Fatal(reason);
+}
diff --git a/Source/Core/Core/Slippi/SlippiRollbackDiagnostic.h b/Source/Core/Core/Slippi/SlippiRollbackDiagnostic.h
new file mode 100644
index 0000000000..c7deb2926e
--- /dev/null
+++ b/Source/Core/Core/Slippi/SlippiRollbackDiagnostic.h
@@ -0,0 +1,83 @@
+// Copyright 2026 Melee Web contributors
+// Licensed under GPLv2+
+// Refer to the license.txt file included.
+
+#pragma once
+
+#include <array>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include <nlohmann/json.hpp>
+
+#include "Common/CommonTypes.h"
+
+class SlippiRollbackDiagnostic
+{
+public:
+  enum class ObserverContext
+  {
+    EXI,
+    TRANSPORT,
+  };
+
+  enum class TransportAction
+  {
+    NONE,
+    DROP,
+    HOLD,
+  };
+
+  struct Config
+  {
+    struct InputProfile
+    {
+      std::string name;
+      u8 role = 0;
+    };
+
+    bool enabled = false;
+    u32 rng_offset = 0;
+    std::string log_path;
+    std::optional<u16> stage_id;
+    std::optional<InputProfile> input_profile;
+    std::optional<s32> overlay_frame;
+    std::array<u8, 8> overlay_pad{};
+    TransportAction transport_action = TransportAction::NONE;
+    std::optional<s32> transport_frame;
+    std::optional<s32> transport_release_frame;
+  };
+
+  static SlippiRollbackDiagnostic FromEnvironment();
+
+  bool Enabled() const { return m_config.enabled; }
+  const Config& GetConfig() const { return m_config; }
+
+  void ResetMatch();
+  void ApplyInputProfile(s32 source_frame, u8 delay, u8* inputs);
+  void ApplyInputOverlay(s32 source_frame, u8 delay, u8* inputs);
+  u32 OverrideRngOffset(u32 generated) const;
+  std::optional<u16> StageOverride() const;
+  std::optional<u8> InputProfileRole() const;
+
+  bool IsTransportFrame(s32 packet_frame) const;
+  bool IsHoldFrame(s32 packet_frame) const;
+  bool IsDropFrame(s32 packet_frame) const;
+  bool ConsumeTransportFrame(s32 packet_frame);
+  s32 ReleaseFrame() const;
+
+  void Record(const nlohmann::json& event, ObserverContext context) const;
+  [[noreturn]] void Fail(std::string_view reason) const;
+
+private:
+  explicit SlippiRollbackDiagnostic(Config config) : m_config(std::move(config)) {}
+
+  Config m_config;
+  bool m_overlay_applied = false;
+  bool m_transport_used = false;
+  s32 m_game_sequence = -1;
+  mutable u64 m_exi_event_sequence = 0;
+  mutable u64 m_transport_event_sequence = 0;
+};
