+void WriteHex(std::ofstream& stream, u32 value, int digits)
+{
+  static constexpr char hex[] = "0123456789abcdef";
+  for (int index = digits - 1; index >= 0; --index)
+    stream << hex[(value >> (index * 4)) & 0xf];
+}
+
+void ObserveConsumedControllerResponse(int device_number, const GCPadStatus& status, u32 high,
+                                       u32 low, u8 mode)
+{
+  static const char* const path = std::getenv("SLIPPI_LOCAL_SI_OBSERVATION");
+  if (path == nullptr || path[0] == '\0' || device_number < 0 || device_number >= 4)
+    return;
+
+  static std::mutex observation_mutex;
+  static std::array<GCPadStatus, 4> previous_status{};
+  static std::array<bool, 4> has_previous_status{};
+  static std::ofstream observation_file;
+  static bool open_failed = false;
+  static bool failure_logged = false;
+
+  std::lock_guard lock(observation_mutex);
+  const std::size_t port = static_cast<std::size_t>(device_number);
+  const GCPadStatus& previous = previous_status[port];
+  if (has_previous_status[port] && previous.button == status.button &&
+      previous.stickX == status.stickX && previous.stickY == status.stickY &&
+      previous.substickX == status.substickX && previous.substickY == status.substickY &&
+      previous.triggerLeft == status.triggerLeft && previous.triggerRight == status.triggerRight &&
+      previous.analogA == status.analogA && previous.analogB == status.analogB &&
+      previous.isConnected == status.isConnected)
+  {
+    return;
+  }
+
+  previous_status[port] = status;
+  has_previous_status[port] = true;
+  if (!observation_file.is_open() && !open_failed)
+  {
+    observation_file.open(path, std::ios::out | std::ios::app);
+    open_failed = !observation_file.is_open();
+  }
+  if (open_failed)
+  {
+    if (!failure_logged)
+    {
+      ERROR_LOG_FMT(SERIALINTERFACE, "[LocalOnly] Could not open SI input observation log");
+      failure_logged = true;
+    }
+    return;
+  }
+
+  const auto monotonic_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                std::chrono::steady_clock::now().time_since_epoch())
+                                .count();
+  observation_file << "{\"event\":\"si_pad_response\",\"host_monotonic_ns\":"
+                   << monotonic_ns << ",\"port\":" << device_number + 1
+                   << ",\"connected\":" << (status.isConnected ? "true" : "false")
+                   << ",\"buttons\":" << status.button << ",\"buttons_hex\":\"";
+  WriteHex(observation_file, status.button, 4);
+  observation_file << "\",\"stick\":[" << static_cast<int>(status.stickX) << ','
+                   << static_cast<int>(status.stickY) << "],\"cstick\":["
+                   << static_cast<int>(status.substickX) << ','
+                   << static_cast<int>(status.substickY) << "],\"triggers\":["
+                   << static_cast<int>(status.triggerLeft) << ','
+                   << static_cast<int>(status.triggerRight) << "],\"analog_ab\":["
+                   << static_cast<int>(status.analogA) << ',' << static_cast<int>(status.analogB)
+                   << "],\"mode\":" << static_cast<int>(mode) << ",\"high_hex\":\"";
+  WriteHex(observation_file, high, 8);
+  observation_file << "\",\"low_hex\":\"";
+  WriteHex(observation_file, low, 8);
+  observation_file << "\"}\n";
+  observation_file.flush();
+}
+}  // namespace
