@@ -90,13 +91,14 @@ std::string MemoryWatcher::ComposeMessages(const Core::CPUThreadGuard& guard)
     u32& current_value = entry.second;
 
     u32 new_value = ChasePointer(guard, address);
-    if (new_value != current_value)
+    if (m_initial_scan || new_value != current_value)
     {
       // Update the value
       current_value = new_value;
       message_stream << address << '\n' << new_value << '\n';
     }
   }
+  m_initial_scan = false;
 
