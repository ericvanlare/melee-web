+void ObserveRemotePadConsumed(int slot, u8 local_player, const SlippiRemotePadOutput& output)
+{
+  static const char* const path = std::getenv("SLIPPI_LOCAL_PAD_OBSERVATION");
+  if (path == nullptr || path[0] == '\0' || slot < 0 || slot >= SLIPPI_REMOTE_PLAYER_MAX ||
+      output.data.empty())
+  {
+    return;
+  }
+
+  static std::mutex observation_mutex;
+  static constexpr s32 unobserved_frame = std::numeric_limits<s32>::min();
+  static std::array<s32, SLIPPI_REMOTE_PLAYER_MAX> last_frame = [] {
+    std::array<s32, SLIPPI_REMOTE_PLAYER_MAX> frames{};
+    frames.fill(unobserved_frame);
+    return frames;
+  }();
+  static std::array<u32, SLIPPI_REMOTE_PLAYER_MAX> game_sequence{};
+  static std::ofstream observation_file;
+  static bool open_failed = false;
+  static bool failure_logged = false;
+  std::lock_guard lock(observation_mutex);
+  if (last_frame[slot] != unobserved_frame && output.latest_frame <= last_frame[slot])
+  {
+    // A new direct match in the same Dolphin process restarts the frame
+    // sequence. Ignore rollback lookbacks within one match, but start a new
+    // observation sequence after a larger backward jump.
+    const s64 rewind = static_cast<s64>(last_frame[slot]) - output.latest_frame;
+    if (rewind <= ROLLBACK_MAX_FRAMES)
+      return;
+    last_frame[slot] = unobserved_frame;
+    ++game_sequence[slot];
+  }
+  if (output.latest_frame <= last_frame[slot])
+    return;
+
+  last_frame[slot] = output.latest_frame;
+  if (!observation_file.is_open() && !open_failed)
+  {
+    observation_file.open(path, std::ios::out | std::ios::app);
+    open_failed = !observation_file.is_open();
+  }
+  if (open_failed)
+  {
+    if (!failure_logged)
+    {
+      ERROR_LOG_FMT(SLIPPI_ONLINE, "[LocalOnly] Could not open remote-pad observation log");
+      failure_logged = true;
+    }
+    return;
+  }
+
+  static constexpr char hex[] = "0123456789abcdef";
+  const auto host_monotonic_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                     std::chrono::steady_clock::now().time_since_epoch())
+                                     .count();
+  observation_file << "{\"event\":\"remote_pad_consumed\",\"game_sequence\":"
+                   << game_sequence[slot] << ",\"host_monotonic_ns\":" << host_monotonic_ns
+                   << ",\"frame\":"
+                   << output.latest_frame << ",\"local_port\":" << static_cast<int>(local_player + 1)
+                   << ",\"remote_port\":" << static_cast<int>(output.player_idx + 1)
+                   << ",\"pad_hex\":\"";
+  for (const u8 byte : output.data)
+    observation_file << hex[byte >> 4] << hex[byte & 0x0f];
+  observation_file << "\"}\n";
+  if (output.latest_frame % 30 == 0)
+    observation_file.flush();
+}
