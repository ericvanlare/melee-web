@@ -106,7 +108,39 @@ void MemoryWatcher::Step(const Core::CPUThreadGuard& guard)
   if (!m_running)
     return;
 
+  const bool initial_scan = m_initial_scan;
   std::string message = ComposeMessages(guard);
-  sendto(m_fd, message.c_str(), message.size() + 1, 0, reinterpret_cast<sockaddr*>(&m_addr),
-         sizeof(m_addr));
+  if (!initial_scan)
+  {
+    sendto(m_fd, message.c_str(), message.size() + 1, 0, reinterpret_cast<sockaddr*>(&m_addr),
+           sizeof(m_addr));
+    return;
+  }
+
+  // Unix datagram payload limits vary by host. Split the complete initial
+  // scan into bounded address/value records and mark its final packet.
+  constexpr std::size_t packet_limit = 1024;
+  constexpr char snapshot_marker[] = "__local_initial_scan_complete__";
+  constexpr std::size_t marker_size = sizeof(snapshot_marker) + 2;
+  std::istringstream scan(message);
+  std::string address;
+  std::string value;
+  std::string packet;
+  const auto send_packet = [this](const std::string& payload) {
+    sendto(m_fd, payload.c_str(), payload.size() + 1, 0,
+           reinterpret_cast<sockaddr*>(&m_addr), sizeof(m_addr));
+  };
+  while (std::getline(scan, address) && std::getline(scan, value))
+  {
+    const std::string record = address + '\n' + value + '\n';
+    if (!packet.empty() && packet.size() + record.size() + marker_size > packet_limit)
+    {
+      send_packet(packet);
+      packet.clear();
+    }
+    packet += record;
+  }
+  packet += snapshot_marker;
+  packet += "\n1\n";
+  send_packet(packet);
 }
