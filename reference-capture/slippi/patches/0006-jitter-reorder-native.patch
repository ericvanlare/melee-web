+bool SlippiRollbackDiagnostic::IsJitterFrame(s32 packet_frame) const
+{
+  return Enabled() && m_config.transport_action == TransportAction::JITTER &&
+         m_config.transport_frame && m_config.transport_release_frame &&
+         packet_frame >= *m_config.transport_frame &&
+         packet_frame < *m_config.transport_release_frame;
+}
+
+bool SlippiRollbackDiagnostic::IsReorderFrame(s32 packet_frame) const
+{
+  return Enabled() && m_config.transport_action == TransportAction::REORDER &&
+         m_config.transport_frame && m_config.transport_release_frame &&
+         packet_frame >= *m_config.transport_frame &&
+         packet_frame < *m_config.transport_release_frame;
+}
+
+bool SlippiRollbackDiagnostic::IsReorderAction() const
+{
+  return Enabled() && m_config.transport_action == TransportAction::REORDER;
+}
