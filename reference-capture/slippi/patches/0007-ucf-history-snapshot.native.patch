diff --git a/Source/Core/Core/Slippi/SlippiUcfHistory.h b/Source/Core/Core/Slippi/SlippiUcfHistory.h
new file mode 100644
index 0000000..5be6c29
--- /dev/null
+++ b/Source/Core/Core/Slippi/SlippiUcfHistory.h
@@ -0,0 +1,131 @@
+// Copyright 2026 Melee Web contributors
+// Licensed under GPLv2+.
+// Refer to the license.txt file included.
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <limits>
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include <nlohmann/json.hpp>
+
+#include "Common/CommonTypes.h"
+
+// This intentionally supports one source-reviewed installed Pad Buffer composition only.
+// The caller must explicitly opt in with this identity; other winning C2 layouts are rejected.
+namespace SlippiUcfHistory
+{
+inline constexpr std::string_view COMPOSITION_ID =
+    "gale01r2-required-general-codes-pad-buffer-c206b460-gctrel-085c-48-v1";
+
+inline constexpr u32 MEM1_START = 0x80000000;
+inline constexpr u32 MEM1_END = 0x81800000;
+inline constexpr u32 GCT_POINTER_SLOT = 0x80005600;
+inline constexpr u32 HOOK_ADDRESS = 0x8006b460;
+inline constexpr u32 GCT_BYTES = 58064;
+inline constexpr u32 PAYLOAD_OFFSET = 0x858;
+inline constexpr u32 TABLE_OFFSET = 0x85c;
+inline constexpr std::size_t AUTHORED_BYTES = 48;
+
+inline constexpr std::array<u32, 8> EXPECTED_LAYOUT_WORDS = {
+    0x00d0c0de, 0x00d0c0de, 0xc206b460, 0x00000054,
+    0x480000b1, 0xbf1c0000, 0x38d1b717, 0x42a00000};
+inline constexpr std::array<u32, 8> LAYOUT_WORD_OFFSETS = {
+    0x000, 0x004, 0x850, 0x854, 0x858, 0x88c, 0x890, 0x894};
+
+struct ResolvedLayout
+{
+  u32 gct_pointer;
+  u32 payload_address;
+  u32 table_address;
+};
+
+constexpr bool IsMem1Span(u32 address, std::uint64_t size)
+{
+  return (address & 3) == 0 && address >= MEM1_START && address < MEM1_END &&
+         static_cast<std::uint64_t>(address) + size <= MEM1_END;
+}
+
+inline std::optional<u32> DecodeHookBranchTarget(u32 word)
+{
+  // PPC relative b (opcode 18), with AA and LK both clear.
+  if ((word >> 26) != 18 || (word & 3) != 0)
+    return std::nullopt;
+
+  std::int64_t displacement = static_cast<std::int64_t>(word & 0x03fffffc);
+  if ((displacement & 0x02000000) != 0)
+    displacement -= 0x04000000;
+  const std::int64_t target = static_cast<std::int64_t>(HOOK_ADDRESS) + displacement;
+  if (target < MEM1_START || target >= MEM1_END || (target & 3) != 0)
+    return std::nullopt;
+  return static_cast<u32>(target);
+}
+
+inline std::optional<ResolvedLayout> Resolve(const u32 gct_pointer, const u32 hook_word,
+                                             const std::array<u32, 8>& layout_words)
+{
+  if (!IsMem1Span(gct_pointer, GCT_BYTES) || !IsMem1Span(HOOK_ADDRESS, sizeof(u32)))
+    return std::nullopt;
+
+  const auto branch_target = DecodeHookBranchTarget(hook_word);
+  const std::uint64_t payload_address = static_cast<std::uint64_t>(gct_pointer) + PAYLOAD_OFFSET;
+  if (!branch_target || payload_address > std::numeric_limits<u32>::max() ||
+      *branch_target != payload_address)
+    return std::nullopt;
+  if (layout_words != EXPECTED_LAYOUT_WORDS)
+    return std::nullopt;
+
+  const std::uint64_t table_address = static_cast<std::uint64_t>(gct_pointer) + TABLE_OFFSET;
+  if (table_address > std::numeric_limits<u32>::max() ||
+      !IsMem1Span(static_cast<u32>(table_address), AUTHORED_BYTES) ||
+      table_address + AUTHORED_BYTES != static_cast<std::uint64_t>(gct_pointer) + 0x88c)
+  {
+    return std::nullopt;
+  }
+
+  return ResolvedLayout{gct_pointer, static_cast<u32>(payload_address),
+                        static_cast<u32>(table_address)};
+}
+
+inline std::string BytesToHex(const std::array<u8, AUTHORED_BYTES>& bytes)
+{
+  static constexpr char HEX[] = "0123456789abcdef";
+  std::string result;
+  result.reserve(AUTHORED_BYTES * 2);
+  for (const u8 byte : bytes)
+  {
+    result.push_back(HEX[byte >> 4]);
+    result.push_back(HEX[byte & 0x0f]);
+  }
+  return result;
+}
+
+inline bool TryAddSnapshotField(nlohmann::json& event, std::string_view composition_id,
+                                u32 gct_pointer, u32 hook_word,
+                                const std::array<u32, 8>& layout_words,
+                                const std::array<u8, AUTHORED_BYTES>& bytes)
+{
+  if (composition_id != COMPOSITION_ID)
+    return false;
+  const auto layout = Resolve(gct_pointer, hook_word, layout_words);
+  if (!layout)
+    return false;
+
+  // Build the complete field before mutating the containing event. Failure emits no partial data.
+  const nlohmann::json snapshot = {
+      {"composition_id", std::string(composition_id)},
+      {"gct_pointer", layout->gct_pointer},
+      {"hook_address", HOOK_ADDRESS},
+      {"hook_word", hook_word},
+      {"payload_address", layout->payload_address},
+      {"authored_table_address", layout->table_address},
+      {"authored_byte_count", AUTHORED_BYTES},
+      {"bytes_hex", BytesToHex(bytes)}};
+  event["ucf_history"] = snapshot;
+  return true;
+}
+}  // namespace SlippiUcfHistory
