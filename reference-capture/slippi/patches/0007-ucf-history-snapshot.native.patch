diff --git a/Source/UnitTests/Core/SlippiUcfHistoryTest.cpp b/Source/UnitTests/Core/SlippiUcfHistoryTest.cpp
new file mode 100644
index 0000000..fbd82cb
--- /dev/null
+++ b/Source/UnitTests/Core/SlippiUcfHistoryTest.cpp
@@ -0,0 +1,129 @@
+// Copyright 2026 Melee Web contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <array>
+#include <string>
+#include <string_view>
+
+#include <gtest/gtest.h>
+#include <nlohmann/json.hpp>
+
+#include "Core/Slippi/SlippiUcfHistory.h"
+
+namespace
+{
+using namespace SlippiUcfHistory;
+
+constexpr u32 TEST_POINTER = 0x81000000;  // Synthetic in-range fixture; never a runtime address.
+constexpr u32 TEST_PAYLOAD = TEST_POINTER + PAYLOAD_OFFSET;
+constexpr u32 TEST_BRANCH =
+    0x48000000 | ((TEST_PAYLOAD - HOOK_ADDRESS) & 0x03fffffc);
+constexpr std::array<u32, 8> VALID_WORDS = EXPECTED_LAYOUT_WORDS;
+
+constexpr u32 RelativeBranchToPointer(u32 pointer)
+{
+  return 0x48000000 | ((pointer + PAYLOAD_OFFSET - HOOK_ADDRESS) & 0x03fffffc);
+}
+}  // namespace
+
+TEST(SlippiUcfHistory, ResolvesOneSupportedDynamicLayout)
+{
+  const auto resolved = Resolve(TEST_POINTER, TEST_BRANCH, VALID_WORDS);
+  ASSERT_TRUE(resolved.has_value());
+  EXPECT_EQ(resolved->gct_pointer, TEST_POINTER);
+  EXPECT_EQ(resolved->payload_address, TEST_POINTER + PAYLOAD_OFFSET);
+  EXPECT_EQ(resolved->table_address, TEST_POINTER + TABLE_OFFSET);
+  EXPECT_EQ(resolved->table_address + AUTHORED_BYTES, TEST_POINTER + 0x88c);
+}
+
+TEST(SlippiUcfHistory, RejectsInvalidPointerRanges)
+{
+  // Matching hook targets isolate GCT span validation instead of failing on
+  // an unrelated TEST_BRANCH target. These payload/table addresses still fit.
+  constexpr u32 below = MEM1_START - 4;
+  constexpr u32 overrun = MEM1_END - GCT_BYTES + 4;
+  ASSERT_EQ(DecodeHookBranchTarget(RelativeBranchToPointer(below)), below + PAYLOAD_OFFSET);
+  ASSERT_EQ(DecodeHookBranchTarget(RelativeBranchToPointer(overrun)), overrun + PAYLOAD_OFFSET);
+  EXPECT_FALSE(Resolve(below, RelativeBranchToPointer(below), VALID_WORDS));
+  EXPECT_FALSE(Resolve(overrun, RelativeBranchToPointer(overrun), VALID_WORDS));
+  // Unaligned/outside pointers cannot have an aligned in-MEM1 matching target;
+  // test their span guard directly as well as the complete resolver.
+  EXPECT_FALSE(IsMem1Span(TEST_POINTER + 1, GCT_BYTES));
+  EXPECT_FALSE(Resolve(TEST_POINTER + 1, RelativeBranchToPointer(TEST_POINTER + 1), VALID_WORDS));
+  EXPECT_FALSE(IsMem1Span(MEM1_END, GCT_BYTES));
+  EXPECT_FALSE(Resolve(MEM1_END, RelativeBranchToPointer(MEM1_END), VALID_WORDS));
+}
+
+TEST(SlippiUcfHistory, AcceptsFullSpanEndingExactlyAtMem1End)
+{
+  constexpr u32 last = MEM1_END - GCT_BYTES;
+  EXPECT_TRUE(IsMem1Span(last, GCT_BYTES));
+  const auto resolved = Resolve(last, RelativeBranchToPointer(last), VALID_WORDS);
+  ASSERT_TRUE(resolved.has_value());
+  EXPECT_EQ(resolved->gct_pointer, last);
+  EXPECT_FALSE(IsMem1Span(last + 4, GCT_BYTES));
+}
+
+TEST(SlippiUcfHistory, RejectsNonRelativeOrMismatchedHookBranches)
+{
+  EXPECT_FALSE(Resolve(TEST_POINTER, TEST_BRANCH | 1, VALID_WORDS));  // LK set.
+  EXPECT_FALSE(Resolve(TEST_POINTER, TEST_BRANCH | 2, VALID_WORDS));  // AA set.
+  EXPECT_FALSE(Resolve(TEST_POINTER, TEST_BRANCH + 4, VALID_WORDS));  // Wrong target.
+  // Change opcode only, leaving the exact target displacement and AA/LK intact.
+  EXPECT_FALSE(Resolve(TEST_POINTER, TEST_BRANCH ^ 0x04000000, VALID_WORDS));
+}
+
+TEST(SlippiUcfHistory, SignExtendsRelativeBranchDisplacement)
+{
+  // Synthetic relative branch word targets MEM1 start from 0x8006b460.
+  EXPECT_EQ(DecodeHookBranchTarget(0x4bf94ba0), MEM1_START);
+}
+
+TEST(SlippiUcfHistory, RejectsChangedHeaderAndFingerprintWords)
+{
+  for (std::size_t index = 0; index < VALID_WORDS.size(); ++index)
+  {
+    auto changed = VALID_WORDS;
+    changed[index] ^= 1;
+    EXPECT_FALSE(Resolve(TEST_POINTER, TEST_BRANCH, changed)) << "word index " << index;
+  }
+}
+
+TEST(SlippiUcfHistory, AddsCompleteFieldWithAllAuthoredBytesIncludingReservedBytes)
+{
+  std::array<u8, AUTHORED_BYTES> bytes{};
+  for (std::size_t index = 0; index < bytes.size(); ++index)
+    bytes[index] = static_cast<u8>(index);
+
+  nlohmann::json event = {{"event", "savestate_capture_complete"}, {"frame", 77}};
+  ASSERT_TRUE(TryAddSnapshotField(event, COMPOSITION_ID, TEST_POINTER, TEST_BRANCH, VALID_WORDS,
+                                 bytes));
+  ASSERT_TRUE(event.find("ucf_history") != event.end());
+  EXPECT_EQ(event["ucf_history"]["authored_byte_count"], AUTHORED_BYTES);
+  EXPECT_EQ(event["ucf_history"]["bytes_hex"].get<std::string>().size(), AUTHORED_BYTES * 2);
+  EXPECT_EQ(event["ucf_history"]["bytes_hex"],
+            "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
+            "202122232425262728292a2b2c2d2e2f");
+}
+
+TEST(SlippiUcfHistory, RefusesMismatchWithoutMutatingEvent)
+{
+  std::array<u8, AUTHORED_BYTES> bytes{};
+  for (std::size_t index = 0; index < bytes.size(); ++index)
+    bytes[index] = static_cast<u8>(index + 0x80);
+
+  const auto check_unchanged = [&](std::string_view composition, u32 pointer, u32 branch,
+                                   std::array<u32, 8> words) {
+    nlohmann::json event = {{"event", "savestate_load_complete"}, {"frame", 77}};
+    const auto before = event;
+    EXPECT_FALSE(TryAddSnapshotField(event, composition, pointer, branch, words, bytes));
+    EXPECT_EQ(event, before);
+  };
+
+  check_unchanged("other-composition", TEST_POINTER, TEST_BRANCH, VALID_WORDS);
+  check_unchanged(COMPOSITION_ID, MEM1_END - GCT_BYTES + 4, TEST_BRANCH, VALID_WORDS);
+  check_unchanged(COMPOSITION_ID, TEST_POINTER, TEST_BRANCH + 4, VALID_WORDS);
+  auto changed_header = VALID_WORDS;
+  changed_header[0] ^= 1;
+  check_unchanged(COMPOSITION_ID, TEST_POINTER, TEST_BRANCH, changed_header);
+}
