+AuroraBrowserByteBufferDescriptor describe_buffer(const ByteBuffer& buffer) noexcept {
+  return {
+      static_cast<uint64_t>(reinterpret_cast<uintptr_t>(buffer.data())),
+      static_cast<uint64_t>(buffer.size()),
+      static_cast<uint64_t>(buffer.capacity()),
+      static_cast<uint64_t>(buffer.max_capacity()),
+      buffer.owned() ? 1U : 0U,
+      0U,
