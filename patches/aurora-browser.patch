+  bool arm_first_draw(uint32_t frameIndex, uint64_t frameId) noexcept {
+    if (frameId == 0 || state_.load(std::memory_order_acquire) != AURORA_BROWSER_FRAME_EFFECT_UNUSED) return false;
+    firstDrawMode_ = true;
+    issuingFrameId_ = frameId;
+    return arm(frameIndex);
+  }
