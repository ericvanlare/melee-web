+         left.pipelineCacheStatus == right.pipelineCacheStatus &&
+         left.pendingFramePackets == right.pendingFramePackets &&
+         left.pendingStagingBuffers == right.pendingStagingBuffers && left.workerBusy == right.workerBusy &&
