+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+
+namespace aurora::gfx::detail {
+
+struct BrowserSubmissionOwner {
+  uint64_t futureId = 0;
+  uint64_t registrationSequence = 0;
+  uint64_t callbackSequence = 0;
+  uint64_t capturedGeneration = 0;
+  uint64_t queueHandle = 0;
+  uint64_t encoderHandle = 0;
+  uint32_t state = 0;
+};
+
+enum class BrowserOwnerCallbackOutcome : uint32_t {
+  Stale = 0,
+  OwnershipMismatch = 1,
+  Completed = 2,
+  Failed = 3,
+};
+
+/* This book is the narrow synchronization seam for the real owner records.
+ * Registration is published before the WebGPU call; a spontaneous callback can
+ * therefore complete before Future returns, and publish_future_if_current can
+ * attach the returned Future id afterward without replacing a reused slot. */
+template <size_t SlotCount>
