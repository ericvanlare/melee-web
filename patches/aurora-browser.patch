+} // namespace detail
+
+inline Sha256Digest sha256(const uint8_t* data, size_t size) noexcept {
+  Sha256Digest digest{};
+  if ((data == nullptr && size != 0) || size > std::numeric_limits<uint64_t>::max() / 8u) {
+    return digest;
+  }
+
+  const uint64_t bitLength = static_cast<uint64_t>(size) * 8u;
+  uint32_t state[8]{0x6a09e667u, 0xbb67ae85u, 0x3c6ef372u, 0xa54ff53au,
+                    0x510e527fu, 0x9b05688cu, 0x1f83d9abu, 0x5be0cd19u};
+  const size_t fullSize = size - (size % 64);
+  for (size_t offset = 0; offset < fullSize; offset += 64) {
+    detail::sha256_block(data + offset, state);
+  }
+
+  const size_t remainder = size - fullSize;
+  std::array<uint8_t, 128> tail{};
+  if (remainder != 0) {
+    std::memcpy(tail.data(), data + fullSize, remainder);
+  }
+  tail[remainder] = 0x80;
+  const size_t tailSize = remainder < 56 ? 64 : 128;
+  for (size_t i = 0; i < 8; ++i) {
+    tail[tailSize - 1 - i] = static_cast<uint8_t>(bitLength >> (i * 8));
+  }
+  for (size_t offset = 0; offset < tailSize; offset += 64) {
+    detail::sha256_block(tail.data() + offset, state);
+  }
+  for (size_t i = 0; i < 8; ++i) {
+    digest[i * 4] = static_cast<uint8_t>(state[i] >> 24);
+    digest[i * 4 + 1] = static_cast<uint8_t>(state[i] >> 16);
+    digest[i * 4 + 2] = static_cast<uint8_t>(state[i] >> 8);
+    digest[i * 4 + 3] = static_cast<uint8_t>(state[i]);
+  }
+  return digest;
+}
+
