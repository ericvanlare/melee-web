+void fill_staging_descriptor(AuroraBrowserFrameStagingDescriptor& out, size_t frameSlot) noexcept {
+  const auto& shadows = g_browserFrameStaging[frameSlot];
+  const auto& packet = g_framePackets[frameSlot];
+  const bool active = packet.frameId != 0;
+  std::memset(&out, 0, sizeof(out));
+  out.frameSlot = static_cast<uint32_t>(frameSlot);
+  out.packetActive = active ? 1U : 0U;
+  out.packetStagingBuffer = active ? static_cast<uint32_t>(packet.stagingBuffer) : UINT32_MAX;
+  out.packetFrameId = packet.frameId;
+  out.shadowPreviousUsed[0] = static_cast<uint64_t>(shadows.verts.previousUsed);
+  out.shadowPreviousUsed[1] = static_cast<uint64_t>(shadows.uniforms.previousUsed);
+  out.shadowPreviousUsed[2] = static_cast<uint64_t>(shadows.indices.previousUsed);
+  out.shadowPreviousUsed[3] = static_cast<uint64_t>(shadows.storage.previousUsed);
+  out.shadowPreviousUsed[4] = static_cast<uint64_t>(shadows.textureUpload.previousUsed);
+  out.shadowBuffers[0] = shadows.verts.descriptor();
+  out.shadowBuffers[1] = shadows.uniforms.descriptor();
+  out.shadowBuffers[2] = shadows.indices.descriptor();
+  out.shadowBuffers[3] = shadows.storage.descriptor();
+  out.shadowBuffers[4] = shadows.textureUpload.descriptor();
