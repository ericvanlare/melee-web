+      descriptor.type = seed.identity.key.type;
+      descriptor.pipeline_ref = seed.identity.key.pipelineRef;
+      descriptor.config_version = seed.identity.key.configVersion;
+      descriptor.config_size = seed.identity.configSize;
+      std::copy(seed.identity.sha256.begin(), seed.identity.sha256.end(), descriptor.sha256);
+      descriptors.push_back(descriptor);
+    }
+  }
+  return aurora_prepare_pipeline_union(descriptors.data(), descriptors.size());
