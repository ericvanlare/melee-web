+/* Pinned Emscripten JS-library bridge for the v5 read-only accessor.
+ * The postset creates a closure in the generated module. It intentionally
+ * does not publish state on globalThis or replace an Emdawn producer. */
+addToLibrary({
+  $AuroraBrowserFutureOwnerV5__deps: ['$WebGPU'],
+  $AuroraBrowserFutureOwnerV5: {},
+  $AuroraBrowserFutureOwnerV5__postset: `
+    AuroraBrowserFutureOwnerV5 = /* Canonical module-private accessor implementation. The generator places this
+ * expression inside the Emscripten $AuroraBrowserFutureOwnerV5 postset. It
+ * never calls Promise methods, enrolls callbacks, waits, or writes WebGPU
+ * Internals. Its closure is owned by one generated module instance. */
+(() => {
+  let moduleState = null;
+  const SUMMARY_BYTES = 96;
+  const ROW_BYTES = 32;
+  const MAX_RETAINED_REFS = 4096;
+  const MAX_TRACKED_ENTRIES = 65536;
+  const ERROR = Object.freeze({
+    NO_INTERNALS: -1,
+    OUTPUT: -2,
+    ARRAY_REPLACED: -3,
+    ENTRY_REPLACED: -4,
+    DESCRIPTOR: -5,
+    SHAPE: -6,
+    ORDINAL: -7,
+  });
+
+  function makeState() {
+    return {
+      arrays: { futures: null, jsObjects: null },
+      arrayLabels: { futures: 0, jsObjects: 0 },
+      labels: new WeakMap(),
+      refs: new Map(),
+      nextLabel: 1,
+      entries: { futures: new Map(), jsObjects: new Map() },
+      last: null,
+    };
+  }
+
+  function state() {
+    if (moduleState === null) moduleState = makeState();
+    return moduleState;
+  }
+
+  function isObjectLike(value) {
+    return (typeof value === "object" && value !== null) || typeof value === "function";
+  }
+
+  function cloneLabelMap(source) {
+    const labels = new Map();
+    for (const [label, value] of source.refs) labels.set(value, label);
+    return labels;
+  }
+
+  function beginStage(source) {
+    return {
+      arrays: { futures: source.arrays.futures, jsObjects: source.arrays.jsObjects },
+      arrayLabels: { futures: source.arrayLabels.futures, jsObjects: source.arrayLabels.jsObjects },
+      labels: cloneLabelMap(source),
+      refs: new Map(source.refs),
+      nextLabel: source.nextLabel,
