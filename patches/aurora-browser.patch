diff --git a/lib/gfx/pipeline_cache_queue.hpp b/lib/gfx/pipeline_cache_queue.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..a1b71e665d90d7bf6513621bd35fc518bc904275
--- /dev/null
+++ b/lib/gfx/pipeline_cache_queue.hpp
@@ -0,0 +1,76 @@
+#pragma once
+
+#include <cstddef>
+#include <iterator>
+#include <list>
+#include <unordered_map>
+#include <utility>
+
+namespace aurora::gfx::detail {
+
+// The browser cache writer may be deferred across many live matches. Keep one
+// row per SQLite key, preserve its first enqueue position, and never evict a
+// row when the optional persistence budget is exhausted.
+template <typename Write, typename Traits, size_t MaxRows = 16384, size_t MaxBytes = 64 * 1024 * 1024>
+class CoalescingWriteQueue {
+ public:
+  enum class EnqueueResult {
+    Added,
+    Coalesced,
+    Overflow,
+  };
+
+  EnqueueResult enqueue(Write write) {
+    const auto key = Traits::key(write);
+    const auto incomingBytes = Traits::bytes(write);
+    const auto found = index_.find(key);
+    if (found != index_.end()) {
+      auto& existing = *found->second;
+      const auto existingBytes = Traits::bytes(existing);
+      if (incomingBytes > MaxBytes - (bytes_ - existingBytes)) {
+        overflowed_ = true;
+        return EnqueueResult::Overflow;
+      }
+      Traits::merge(existing, std::move(write));
+      bytes_ = bytes_ - existingBytes + Traits::bytes(existing);
+      return EnqueueResult::Coalesced;
+    }
+
+    if (queue_.size() >= MaxRows || incomingBytes > MaxBytes - bytes_) {
+      overflowed_ = true;
+      return EnqueueResult::Overflow;
+    }
+
+    queue_.emplace_back(std::move(write));
+    auto iterator = std::prev(queue_.end());
+    index_.emplace(Traits::key(*iterator), iterator);
+    bytes_ += Traits::bytes(*iterator);
+    return EnqueueResult::Added;
+  }
+
+  void take(std::list<Write>& batch) {
+    batch.splice(batch.end(), queue_);
+    index_.clear();
+    bytes_ = 0;
+  }
+
+  void clear() {
+    queue_.clear();
+    index_.clear();
+    bytes_ = 0;
+    overflowed_ = false;
+  }
+
+  bool pending() const { return !queue_.empty(); }
+  bool overflowed() const { return overflowed_; }
+  size_t size() const { return queue_.size(); }
+  size_t bytes() const { return bytes_; }
+
+ private:
+  std::list<Write> queue_;
+  std::unordered_map<typename Traits::Key, typename std::list<Write>::iterator, typename Traits::Hash> index_;
+  size_t bytes_ = 0;
+  bool overflowed_ = false;
+};
+
+} // namespace aurora::gfx::detail
diff --git a/lib/gfx/pipeline_prepare_state.hpp b/lib/gfx/pipeline_prepare_state.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..73b22bcdf71b1dd107ef0e26990fa4cf008ac8ea
--- /dev/null
+++ b/lib/gfx/pipeline_prepare_state.hpp
@@ -0,0 +1,259 @@
+#pragma once
+
+/*
+ * GPU- and SQLite-free bounded state used by the selective pipeline cache.
+ * The cache owns seed configuration bytes internally; callers provide only
+ * typed descriptor identities.
+ */
+
+#include <aurora/pipeline_prepare.h>
+#include "sha256.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <iterator>
+#include <limits>
+#include <utility>
+#include <vector>
+
+namespace aurora::gfx::selective {
+
+constexpr size_t MaxSeedDescriptors = 1024;
+constexpr size_t MaxRetainedConfigBytes = 16u * 1024u * 1024u;
+
+struct DescriptorKey {
+  uint32_t type = 0;
+  uint64_t pipelineRef = 0;
+  uint32_t configVersion = 0;
+
+  bool operator==(const DescriptorKey&) const = default;
+};
+
+struct DescriptorIdentity {
+  DescriptorKey key;
+  uint32_t configSize = 0;
+  Sha256Digest sha256{};
+
+  bool operator==(const DescriptorIdentity&) const = default;
+};
+
+struct SeedDescriptor {
+  DescriptorIdentity identity;
+  uint32_t firstFrameUsed = UINT32_MAX;
+  std::vector<uint8_t> config;
+};
+
+enum class RegistryInsertResult {
+  Inserted,
+  Duplicate,
+  Conflict,
+  Invalid,
+  Overflow,
+};
+
+enum class RequestResult {
+  Accepted,
+  Duplicate,
+  Unknown,
+  Conflict,
+  Invalid,
+  Overflow,
+};
+
+enum class GateResult {
+  Allowed,
+  Unknown,
+  ByteMismatch,
+};
+
+class SeedDescriptorRegistry {
+public:
+  RegistryInsertResult add_seed(uint32_t type, uint64_t pipelineRef, uint32_t configVersion,
+                                uint32_t firstFrameUsed, const uint8_t* config, size_t configSize) {
+    if (type > AURORA_PIPELINE_SHADER_RML || config == nullptr || configSize == 0 ||
+        configSize > std::numeric_limits<uint32_t>::max() || configSize > MaxRetainedConfigBytes) {
+      return RegistryInsertResult::Invalid;
+    }
+    DescriptorIdentity identity{
+        .key = {.type = type, .pipelineRef = pipelineRef, .configVersion = configVersion},
+        .configSize = static_cast<uint32_t>(configSize),
+        .sha256 = sha256(config, configSize),
+    };
+    for (const auto& entry : entries_) {
+      if (!(entry.identity.key == identity.key)) {
+        continue;
+      }
+      if (entry.identity == identity && entry.config.size() == configSize &&
+          std::memcmp(entry.config.data(), config, configSize) == 0) {
+        return RegistryInsertResult::Duplicate;
+      }
+      return RegistryInsertResult::Conflict;
+    }
+
+    if (entries_.size() >= MaxSeedDescriptors || totalConfigBytes_ > MaxRetainedConfigBytes - configSize) {
+      return RegistryInsertResult::Overflow;
+    }
+
+    SeedDescriptor entry{
+        .identity = identity,
+        .firstFrameUsed = firstFrameUsed,
+        .config = std::vector<uint8_t>(config, config + configSize),
+    };
+    totalConfigBytes_ += configSize;
+    entries_.push_back(std::move(entry));
+    return RegistryInsertResult::Inserted;
+  }
+
+  void clear() noexcept {
+    entries_.clear();
+    totalConfigBytes_ = 0;
+  }
+
+  [[nodiscard]] size_t size() const noexcept { return entries_.size(); }
+  [[nodiscard]] size_t total_config_bytes() const noexcept { return totalConfigBytes_; }
+  [[nodiscard]] const std::vector<SeedDescriptor>& entries() const noexcept { return entries_; }
+
+  [[nodiscard]] bool contains(const DescriptorKey& key) const noexcept { return find(key) != nullptr; }
+
+  /* The GPU cache is keyed only by pipelineRef.  Keep the generic typed
+   * registry permissive, but let the cache reject an ambiguous seed set
+   * before it can queue any GPU work. */
+  [[nodiscard]] bool global_refs_unique() const noexcept {
+    for (size_t i = 0; i < entries_.size(); ++i) {
+      for (size_t j = i + 1; j < entries_.size(); ++j) {
+        if (entries_[i].identity.key.pipelineRef == entries_[j].identity.key.pipelineRef &&
+            !(entries_[i].identity == entries_[j].identity)) {
+          return false;
+        }
+      }
+    }
+    return true;
+  }
+
+  [[nodiscard]] const SeedDescriptor* find(const DescriptorKey& key) const noexcept {
+    const auto it = std::find_if(entries_.begin(), entries_.end(), [&](const SeedDescriptor& entry) {
+      return entry.identity.key == key;
+    });
+    return it == entries_.end() ? nullptr : &*it;
+  }
+
+  [[nodiscard]] const SeedDescriptor* find(const DescriptorIdentity& identity) const noexcept {
+    const auto* entry = find(identity.key);
+    return entry != nullptr && entry->identity == identity ? entry : nullptr;
+  }
+
+  [[nodiscard]] GateResult gate(const DescriptorIdentity& identity, const uint8_t* config, size_t configSize) const
+      noexcept {
+    const auto* entry = find(identity.key);
+    if (entry == nullptr) {
+      return GateResult::Unknown;
+    }
+    if (!(entry->identity == identity) || config == nullptr || configSize != entry->config.size() ||
+        std::memcmp(entry->config.data(), config, configSize) != 0) {
+      return GateResult::ByteMismatch;
+    }
+    return GateResult::Allowed;
+  }
+
+private:
+  std::vector<SeedDescriptor> entries_;
+  size_t totalConfigBytes_ = 0;
+};
+
+class PipelineSelection {
+public:
+  RequestResult build(const AuroraPipelineDescriptor* descriptors, size_t count,
+                      const SeedDescriptorRegistry& registry, size_t* invalidIndex = nullptr) const {
+    if (invalidIndex != nullptr) {
+      *invalidIndex = std::numeric_limits<size_t>::max();
+    }
+    if (descriptors == nullptr && count != 0) {
+      return RequestResult::Invalid;
+    }
+    if (count == 0) {
+      return RequestResult::Invalid;
+    }
+    if (count > MaxSeedDescriptors) {
+      return RequestResult::Overflow;
+    }
+
+    std::vector<DescriptorIdentity> candidate;
+    candidate.reserve(count);
+    for (size_t i = 0; i < count; ++i) {
+      const AuroraPipelineDescriptor& descriptor = descriptors[i];
+      if (descriptor.type > AURORA_PIPELINE_SHADER_RML || descriptor.config_size == 0 ||
+          descriptor.config_size > MaxRetainedConfigBytes) {
+        if (invalidIndex != nullptr) {
+          *invalidIndex = i;
+        }
+        return RequestResult::Invalid;
+      }
+      DescriptorIdentity identity{
+          .key = {.type = descriptor.type, .pipelineRef = descriptor.pipeline_ref,
+                  .configVersion = descriptor.config_version},
+          .configSize = descriptor.config_size,
+      };
+      std::copy(std::begin(descriptor.sha256), std::end(descriptor.sha256), identity.sha256.begin());
+
+      if (std::find(candidate.begin(), candidate.end(), identity) != candidate.end()) {
+        continue;
+      }
+      if (std::find_if(candidate.begin(), candidate.end(), [&](const DescriptorIdentity& prior) {
+            return prior.key == identity.key;
+          }) != candidate.end()) {
+        if (invalidIndex != nullptr) {
+          *invalidIndex = i;
+        }
+        return RequestResult::Conflict;
+      }
+      if (registry.find(identity) == nullptr) {
+        if (invalidIndex != nullptr) {
+          *invalidIndex = i;
+        }
+        return RequestResult::Unknown;
+      }
+      candidate.push_back(identity);
+    }
+    return RequestResult::Accepted;
+  }
+
+  RequestResult replace(const AuroraPipelineDescriptor* descriptors, size_t count,
+                        const SeedDescriptorRegistry& registry, size_t* invalidIndex = nullptr) {
+    const auto result = build(descriptors, count, registry, invalidIndex);
+    if (result != RequestResult::Accepted) {
+      return result;
+    }
+
+    std::vector<DescriptorIdentity> candidate;
+    candidate.reserve(count);
+    for (size_t i = 0; i < count; ++i) {
+      DescriptorIdentity identity{
+          .key = {.type = descriptors[i].type, .pipelineRef = descriptors[i].pipeline_ref,
+                  .configVersion = descriptors[i].config_version},
+          .configSize = descriptors[i].config_size,
+      };
+      std::copy(std::begin(descriptors[i].sha256), std::end(descriptors[i].sha256), identity.sha256.begin());
+      if (std::find(candidate.begin(), candidate.end(), identity) == candidate.end()) {
+        candidate.push_back(identity);
+      }
+    }
+    members_ = std::move(candidate);
+    return RequestResult::Accepted;
+  }
+
+  void clear() noexcept { members_.clear(); }
+  [[nodiscard]] size_t size() const noexcept { return members_.size(); }
+  [[nodiscard]] const std::vector<DescriptorIdentity>& members() const noexcept { return members_; }
+  [[nodiscard]] bool contains(const DescriptorKey& key) const noexcept {
+    return std::any_of(members_.begin(), members_.end(),
+                       [&](const DescriptorIdentity& identity) { return identity.key == key; });
+  }
+
+private:
+  std::vector<DescriptorIdentity> members_;
+};
+
+} // namespace aurora::gfx::selective
