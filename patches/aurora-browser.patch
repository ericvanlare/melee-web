+int browser_quiescence_descriptor(void* out, size_t bytes) noexcept {
+  if (!browser_quiescence_supported()) {
+    return 0;
+  }
+  const size_t required = browser_quiescence_descriptor_bytes();
+  if (out == nullptr || bytes < required) {
+    return 0;
+  }
+  const auto submission = browser_submission_status();
+  const auto header = make_quiescence_descriptor(submission);
+  std::array<AuroraBrowserFrameStagingDescriptor, FrameSlotCount> frameRows;
+  std::array<AuroraBrowserSubmissionDescriptor, StagingBufferCount> submissionRows;
+  std::memset(frameRows.data(), 0, sizeof(frameRows));
+  std::memset(submissionRows.data(), 0, sizeof(submissionRows));
+  for (size_t slot = 0; slot < active_frame_slot_count(); ++slot) {
+    fill_staging_descriptor(frameRows[slot], slot);
+  }
+  for (size_t slot = 0; slot < active_staging_buffer_count(); ++slot) {
+    fill_submission_descriptor(submissionRows[slot], slot);
+  }
+  std::memcpy(out, &header, sizeof(header));
+  auto* bytesOut = static_cast<uint8_t*>(out) + sizeof(header);
+  const size_t frameRowsBytes = active_frame_slot_count() * sizeof(frameRows[0]);
+  const size_t submissionRowsBytes = active_staging_buffer_count() * sizeof(submissionRows[0]);
+  std::memcpy(bytesOut, frameRows.data(), frameRowsBytes);
+  std::memcpy(bytesOut + frameRowsBytes, submissionRows.data(), submissionRowsBytes);
+  return 1;
+}
+
+int browser_quiescence_validate_descriptor(const void* captured, size_t bytes) noexcept {
+  if (!browser_quiescence_supported()) {
+    return 0;
+  }
+  const size_t required = browser_quiescence_descriptor_bytes();
+  if (captured == nullptr || bytes < required) {
+    return 0;
+  }
+  std::array<uint8_t, sizeof(AuroraBrowserQuiescenceDescriptor) +
+                         FrameSlotCount * sizeof(AuroraBrowserFrameStagingDescriptor) +
+                         StagingBufferCount * sizeof(AuroraBrowserSubmissionDescriptor)> current{};
+  if (!browser_quiescence_descriptor(current.data(), current.size())) {
+    return 0;
+  }
+  return std::memcmp(captured, current.data(), required) == 0 ? 1 : 0;
+}
+
+int browser_quiescence_capture_lease(AuroraBrowserQuiescenceLease* out) noexcept {
+  if (!browser_quiescence_supported()) {
+    return 0;
+  }
+  if (out == nullptr) {
+    return 0;
+  }
+  const auto submission = browser_submission_status();
+  *out = quiescence_lease(submission);
+  return quiescence_lease_is_idle(*out) ? 1 : 0;
+}
+
+int browser_quiescence_validate_lease(const AuroraBrowserQuiescenceLease* lease) noexcept {
+  if (!browser_quiescence_supported()) {
+    return 0;
+  }
+  if (lease == nullptr) {
+    return 0;
+  }
+  const auto submission = browser_submission_status();
+  const auto current = quiescence_lease(submission);
+  if (!quiescence_lease_is_idle(current)) {
+    return 0;
+  }
+  return quiescence_lease_equal(*lease, current) ? 1 : 0;
