+
+  void observe_op(const FramePacket& frame, const FrameOp& op) noexcept {
+    if (!begin_or_match(frame.frameIndex, frame.frameId)) return;
+    ++counts_.opCount;
+    AuroraBrowserFrameEffectEvent event = make_event(AURORA_BROWSER_FRAME_EFFECT_EVENT_FRAME_OP, op.index);
+    event.flags = static_cast<uint32_t>(op.type);
+    event.value0 = op.highWater.verts;
+    event.value1 = op.highWater.uniforms;
+    event.value2 = op.highWater.indices;
+    event.value3 = op.highWater.storage;
+    event.handleA = op.highWater.textureUpload;
+    event.handleB = op.highWater.textureUploadCount;
+    append(event);
+    switch (op.type) {
+    case FrameOpType::RenderPass:
+      if (op.renderPass == nullptr) set_blocker(AURORA_BROWSER_FRAME_EFFECT_MISSING_PAYLOAD);
+      else if (!op.renderPass->sealed) set_blocker(AURORA_BROWSER_FRAME_EFFECT_UNSEALED_PASS);
+      break;
+    case FrameOpType::TextureCopy:
+      if (op.textureCopy == nullptr) set_blocker(AURORA_BROWSER_FRAME_EFFECT_MISSING_PAYLOAD);
+      break;
+    case FrameOpType::EncoderTask:
+      if (op.encoderTask == nullptr) set_blocker(AURORA_BROWSER_FRAME_EFFECT_MISSING_PAYLOAD);
+      break;
+    default:
+      set_blocker(AURORA_BROWSER_FRAME_EFFECT_UNKNOWN_OP);
+      break;
+    }
+  }
+
+  void observe_render_pass(const FramePacket& frame, uint32_t opIndex, const RenderPass& pass,
+                          const std::array<wgpu::RenderPassColorAttachment, MaxColorAttachments>& colors,
+                          const wgpu::RenderPassDepthStencilAttachment* depth) noexcept {
+    if (!begin_or_match(frame.frameIndex, frame.frameId)) return;
+    static constexpr uint32_t expectedCommandCounts[] = {23u, 22u, 220u};
+    const uint32_t passOrdinal = counts_.renderPassCount;
+    if (passOrdinal >= 3 || pass.commands.size() != expectedCommandCounts[passOrdinal])
+      fail(AURORA_BROWSER_FRAME_EFFECT_COMMAND_SHAPE_MISMATCH);
+    ++counts_.renderPassCount;
+    auto event = make_event(AURORA_BROWSER_FRAME_EFFECT_EVENT_RENDER_PASS, opIndex);
+    event.flags = (pass.discardable ? 1u : 0u) | (pass.hasDepth ? 2u : 0u) |
+                  (pass.hasStencil ? 4u : 0u) | (pass.hasDraws ? 8u : 0u);
+    event.value0 = pass.colorAttachmentCount;
+    event.value1 = static_cast<uint32_t>(pass.commands.size());
+    event.value2 = static_cast<uint32_t>(pass.paletteConvs.size());
+    event.value3 = pass.msaaSamples;
+    append(event);
+
+    for (uint32_t i = 0; i < pass.colorAttachmentCount; ++i) {
+      const auto& source = pass.colorAttachments[i];
+      const auto& actual = colors[i];
+      auto row = make_event(AURORA_BROWSER_FRAME_EFFECT_EVENT_COLOR_ATTACHMENT, opIndex, i);
+      row.flags = source.clear ? 1u : 0u;
+      row.value0 = static_cast<uint32_t>(actual.loadOp);
+      row.value1 = static_cast<uint32_t>(actual.storeOp);
+      row.value2 = source.size.width;
+      row.value3 = source.size.height;
+      row.handleA = handle(AURORA_BROWSER_FRAME_EFFECT_HANDLE_TEXTURE_VIEW, source.view.Get());
+      row.handleB = handle(AURORA_BROWSER_FRAME_EFFECT_HANDLE_TEXTURE_VIEW, source.resolveView.Get());
+      const auto factEventIndex=eventCount_.load(std::memory_order_relaxed);
+      append(row);
+      if(eventCount_.load(std::memory_order_relaxed)==factEventIndex+1){
+        AuroraBrowserFrameEffectAttachmentFact fact{};fact.eventIndex=factEventIndex;fact.kind=1;fact.aspects=1;
