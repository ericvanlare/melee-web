+
+  void observe_actual_draw(uint32_t rendererKind, uint32_t vertexCount, uint32_t indexCount,
+                           uint32_t instanceCount, uint32_t dstAlpha, const wgpu::Color* clearColor = nullptr) noexcept {
+    if (!collecting()) return;
+    if (!drawCallbackActive_ || actualDrawCount_ >= DrawCapacity) {
+      fail(actualDrawCount_ >= DrawCapacity ? AURORA_BROWSER_FRAME_EFFECT_DRAW_OVERFLOW
+                                           : AURORA_BROWSER_FRAME_EFFECT_UNCLASSIFIED_DRAW);
+      return;
+    }
+    auto& out = draws_[actualDrawCount_++];
+    out = {};
+    out.frameIndex = frameIndex_;
+    out.opIndex = currentOpIndex_;
+    out.commandIndex = currentCommandIndex_;
+    out.rendererKind = rendererKind;
+    out.pipelineKey = currentPipelineKey_;
+    out.pipelineId = currentPipelineId_;
+    out.indexBufferId = currentIndexBufferId_;
+    out.indexFormat = currentIndexFormat_;
+    out.indexOffset = currentIndexOffset_;
+    out.indexSize = currentIndexSize_;
+    out.vertexCount = vertexCount;
+    out.indexCount = indexCount;
+    out.instanceCount = instanceCount;
+    out.dstAlpha = dstAlpha;
+    if (clearColor != nullptr) {
+      out.hasClearColor = 1;
+      out.clearColor[0] = clearColor->r;
+      out.clearColor[1] = clearColor->g;
+      out.clearColor[2] = clearColor->b;
+      out.clearColor[3] = clearColor->a;
+    }
+    for (uint32_t i = 0; i < 4; ++i) {
+      out.bindGroupIds[i] = currentBindGroupIds_[i];
+      out.dynamicOffsetCount[i] = currentDynamicOffsetCount_[i];
+      for (uint32_t j = 0; j < 4; ++j) out.dynamicOffsets[i][j] = currentDynamicOffsets_[i][j];
+    }
+    for (uint32_t i = 0; i < 6; ++i) out.viewport[i] = currentViewport_[i];
+    for (uint32_t i = 0; i < 4; ++i) out.scissor[i] = currentScissor_[i];
+    auto row = make_event(AURORA_BROWSER_FRAME_EFFECT_EVENT_DRAW_DETAIL, currentOpIndex_, currentCommandIndex_);
+    row.flags = rendererKind;
+    row.value0 = vertexCount;
+    row.value1 = indexCount;
+    row.value2 = instanceCount;
+    row.value3 = dstAlpha;
+    row.handleA = currentPipelineId_;
+    row.handleB = currentIndexBufferId_;
+    append(row);
+    for (uint32_t slot = 0; slot < 4; ++slot) {
+      auto binding = make_event(AURORA_BROWSER_FRAME_EFFECT_EVENT_BIND_GROUP_STATE, currentOpIndex_, currentCommandIndex_);
+      binding.flags = slot;
+      binding.value0 = currentDynamicOffsetCount_[slot];
+      binding.value1 = currentDynamicOffsets_[slot][0];
+      binding.value2 = currentDynamicOffsets_[slot][1];
+      binding.value3 = currentDynamicOffsets_[slot][2];
+      binding.handleA = currentBindGroupIds_[slot];
+      append(binding);
+    }
+  }
+
+  uint64_t register_resource(uint32_t kind, uintptr_t address, uint64_t ownerId,
+                             const uint32_t* words, uint32_t wordCount) noexcept {
+    if (!recording()) return 0;
+    if (address == 0 || wordCount > 16 || (wordCount != 0 && words == nullptr)) {
+      fail(AURORA_BROWSER_FRAME_EFFECT_UNKNOWN_RESOURCE);
+      return 0;
+    }
+    const uint64_t id = handle(kind, address);
+    if (id == 0) return 0;
+    for (uint32_t i = 0; i < resourceCount_; ++i) {
+      if (resources_[i].captureId != id) continue;
+      bool same = resources_[i].ownerId == ownerId && resources_[i].kind == kind &&
+                  resources_[i].wordCount == wordCount;
+      for (uint32_t j = 0; same && j < wordCount; ++j) same = resources_[i].words[j] == words[j];
+      if (!same) fail(AURORA_BROWSER_FRAME_EFFECT_RESOURCE_ID_REUSE);
+      return id;
+    }
+    if (resourceCount_ >= ResourceCapacity) {
+      fail(AURORA_BROWSER_FRAME_EFFECT_DESCRIPTOR_OVERFLOW);
+      return 0;
+    }
+    auto& resource = resources_[resourceCount_++];
+    resource = {};
+    resource.captureId = id;
+    resource.ownerId = ownerId;
+    resource.kind = kind;
+    resource.wordCount = wordCount;
+    for (uint32_t j = 0; j < wordCount; ++j) resource.words[j] = words[j];
+    return id;
+  }
+
+  uint64_t observe_bind_group_descriptor(uintptr_t group, uintptr_t device, uintptr_t layout,
+                                         uint64_t refKey, const WGPUBindGroupDescriptor& descriptor) noexcept {
+    if (!recording()) return 0;
+    if (descriptor.nextInChain != nullptr || descriptor.entryCount > BindingEntryCapacity ||
+        (descriptor.entryCount != 0 && descriptor.entries == nullptr)) {
+      fail(AURORA_BROWSER_FRAME_EFFECT_DESCRIPTOR_OVERFLOW);
+      return 0;
+    }
+    const uint64_t layoutId = handle(AURORA_BROWSER_FRAME_EFFECT_HANDLE_BIND_GROUP_LAYOUT, layout);
+    uint64_t descriptorHash = 14695981039346656037ULL;
+    auto mix = [&descriptorHash](uint64_t value) noexcept {
+      for (unsigned shift = 0; shift < 64; shift += 8) {
+        descriptorHash ^= (value >> shift) & 255u;
+        descriptorHash *= 1099511628211ULL;
+      }
+    };
+    for (size_t i = 0; i < descriptor.entryCount; ++i) {
+      const auto& entry = descriptor.entries[i];
+      if (entry.nextInChain != nullptr) {
+        fail(AURORA_BROWSER_FRAME_EFFECT_UNKNOWN_RESOURCE);
+        return 0;
+      }
+      uint32_t kind = 0;
+      uintptr_t raw = 0;
+      uint64_t offset = 0, size = 0;
+      if (entry.buffer != nullptr) { kind = AURORA_BROWSER_FRAME_EFFECT_HANDLE_BUFFER; raw = reinterpret_cast<uintptr_t>(entry.buffer); offset = entry.offset; size = entry.size; }
+      else if (entry.textureView != nullptr) { kind = AURORA_BROWSER_FRAME_EFFECT_HANDLE_TEXTURE_VIEW; raw = reinterpret_cast<uintptr_t>(entry.textureView); }
+      else if (entry.sampler != nullptr) { kind = AURORA_BROWSER_FRAME_EFFECT_HANDLE_SAMPLER; raw = reinterpret_cast<uintptr_t>(entry.sampler); }
+      mix(entry.binding); mix(kind); mix(handle(kind, raw)); mix(offset); mix(size);
+    }
+    const uint32_t words[] = {static_cast<uint32_t>(layoutId), static_cast<uint32_t>(layoutId >> 32),
+                              static_cast<uint32_t>(descriptor.entryCount), static_cast<uint32_t>(descriptorHash),
+                              static_cast<uint32_t>(descriptorHash >> 32)};
+    const uint64_t groupId = register_resource(AURORA_BROWSER_FRAME_EFFECT_HANDLE_BIND_GROUP, group,
+                                                handle(AURORA_BROWSER_FRAME_EFFECT_HANDLE_DEVICE, device),
+                                                words, 5);
+    if (groupId == 0) return 0;
+    if (refKey != 0) {
+      bool found = false;
+      for (uint32_t i = 0; i < bindGroupRefCount_; ++i) {
+        if (bindGroupRefs_[i].refKey != refKey) continue;
+        if (bindGroupRefs_[i].captureId != groupId) fail(AURORA_BROWSER_FRAME_EFFECT_RESOURCE_ID_REUSE);
+        found = true;
+        break;
+      }
+      if (!found) {
+        if (bindGroupRefCount_ >= BindGroupRefCapacity) fail(AURORA_BROWSER_FRAME_EFFECT_DESCRIPTOR_OVERFLOW);
+        else bindGroupRefs_[bindGroupRefCount_++] = {refKey, groupId};
+      }
+    }
+    for (uint32_t i = 0; i < descriptor.entryCount; ++i) {
+      const auto& entry = descriptor.entries[i];
+      uint32_t kind = 0;
+      uintptr_t raw = 0;
+      if (entry.buffer != nullptr) { kind = AURORA_BROWSER_FRAME_EFFECT_HANDLE_BUFFER; raw = reinterpret_cast<uintptr_t>(entry.buffer); }
+      else if (entry.textureView != nullptr) { kind = AURORA_BROWSER_FRAME_EFFECT_HANDLE_TEXTURE_VIEW; raw = reinterpret_cast<uintptr_t>(entry.textureView); }
+      else if (entry.sampler != nullptr) { kind = AURORA_BROWSER_FRAME_EFFECT_HANDLE_SAMPLER; raw = reinterpret_cast<uintptr_t>(entry.sampler); }
+      if (kind == 0 || raw == 0) { fail(AURORA_BROWSER_FRAME_EFFECT_UNKNOWN_RESOURCE); continue; }
+      const uint64_t resourceId = handle(kind, raw);
+      if (resourceId == 0 || !resource_known(resourceId)) fail(AURORA_BROWSER_FRAME_EFFECT_UNKNOWN_RESOURCE);
+      bool alreadyRecorded = false;
+      for (uint32_t prior = 0; prior < bindingEntryCount_; ++prior) {
+        const auto& existing = bindingEntries_[prior];
+        if (existing.bindGroupId == groupId && existing.binding == entry.binding &&
+            existing.resourceId == resourceId && existing.kind == kind &&
+            existing.offset == entry.offset && existing.size == entry.size) {
+          alreadyRecorded = true;
+          break;
+        }
+      }
+      if (alreadyRecorded) continue;
+      if (bindingEntryCount_ >= BindingEntryCapacity) { fail(AURORA_BROWSER_FRAME_EFFECT_DESCRIPTOR_OVERFLOW); return groupId; }
+      auto& out = bindingEntries_[bindingEntryCount_++];
+      out = {};
+      out.bindGroupId = groupId;
+      out.resourceId = resourceId;
+      out.binding = entry.binding;
+      out.kind = kind;
+      out.offset = entry.offset;
+      out.size = entry.size;
+    }
+    return groupId;
+  }
+
+  void observe_bind_group_ref(uint32_t slot, uint64_t refKey) noexcept {
+    if (!collecting() || slot >= 4 || refKey == 0) return;
+    for (uint32_t i = 0; i < bindGroupRefCount_; ++i) {
+      if (bindGroupRefs_[i].refKey != refKey) continue;
+      currentBindGroupIds_[slot] = bindGroupRefs_[i].captureId;
+      currentDynamicOffsetCount_[slot] = 0;
+      currentDynamicOffsets_[slot] = {};
+      return;
+    }
+    fail(AURORA_BROWSER_FRAME_EFFECT_UNKNOWN_RESOURCE);
+  }
