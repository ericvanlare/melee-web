+                           uint64_t generation, uint64_t queueHandle,
+                           uint64_t encoderHandle) {
+    std::lock_guard lock{m_mutex};
+    auto& owner = m_records[slot];
+    owner = {};
+    owner.registrationSequence = registrationSequence;
+    owner.capturedGeneration = generation;
+    owner.queueHandle = queueHandle;
+    owner.encoderHandle = encoderHandle;
+    owner.state = m_registeredState;
+  }
