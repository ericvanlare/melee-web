+#ifdef __EMSCRIPTEN__
+/** Browser-only completion snapshot. Polls callbacks without waiting or submitting
+ * another draw. Staging slots stay owned until OnSubmittedWorkDone succeeds. */
+typedef struct {
+  uint32_t pendingFramePackets;
+  uint32_t pendingStagingBuffers;
+  uint32_t workerBusy;
+} AuroraBrowserSubmissionStatus;
+AuroraBrowserSubmissionStatus aurora_browser_submission_status();
+
+/** Explicit local-only staging diagnostics. This snapshot does not pump browser
+ * callbacks or wait; queue-completion latency includes callback delivery time. */
+typedef struct {
+  uint32_t activeSlots;
+  uint32_t occupiedSlots;
+  uint64_t queueCompletionRegistrations;
+  uint64_t queueCompletionCallbacks;
