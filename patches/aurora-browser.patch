+  bool arm(uint32_t frameIndex) noexcept {
+    if (state_.load(std::memory_order_acquire) != AURORA_BROWSER_FRAME_EFFECT_UNUSED) return false;
+    targetFrameIndex_ = frameIndex;
+    if (preflightBlocker_ != AURORA_BROWSER_FRAME_EFFECT_BLOCKER_NONE) {
+      set_blocker(preflightBlocker_);
+      for (uint32_t blocker = 1; blocker < 64; ++blocker) {
+        if ((preflightFindingMask_ & (uint64_t{1} << blocker)) != 0) set_blocker(blocker);
+      }
+      state_.store(AURORA_BROWSER_FRAME_EFFECT_FAILED, std::memory_order_release);
+      return false;
+    }
+    state_.store(AURORA_BROWSER_FRAME_EFFECT_ARMED, std::memory_order_release);
+    return true;
+  }
