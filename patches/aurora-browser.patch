+  void observe_bind_group_set(uint32_t slot, uintptr_t bindGroup, uint32_t offsetCount,
+                              const uint32_t* offsets) noexcept {
+    if (!collecting() || slot >= 4 || offsetCount > 4 || (offsetCount != 0 && offsets == nullptr)) {
+      if (collecting()) fail(AURORA_BROWSER_FRAME_EFFECT_UNKNOWN_RESOURCE);
+      return;
+    }
+    const uint64_t id = handle(AURORA_BROWSER_FRAME_EFFECT_HANDLE_BIND_GROUP, bindGroup);
+    currentBindGroupIds_[slot] = id;
+    currentDynamicOffsetCount_[slot] = offsetCount;
+    currentDynamicOffsets_[slot] = {};
+    for (uint32_t i = 0; i < offsetCount; ++i) currentDynamicOffsets_[slot][i] = offsets[i];
+    if (id == 0 || !resource_known(id)) fail(AURORA_BROWSER_FRAME_EFFECT_UNKNOWN_RESOURCE);
+  }
+
+  void observe_index_buffer(uintptr_t buffer, uint32_t format, uint64_t offset, uint64_t size) noexcept {
