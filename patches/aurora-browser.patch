+static bool selective_seed_schema_valid(sqlite3* db) {
+  sqlite3_stmt* schemaInfo = nullptr;
+  auto ret = sqlite3_prepare_v2(db, "PRAGMA table_info(aurora_schema)", -1, &schemaInfo, nullptr);
+  if (ret != SQLITE_OK) {
+    return false;
+  }
+
+  size_t columnCount = 0;
+  bool valueColumnValid = false;
+  while ((ret = sqlite3_step(schemaInfo)) == SQLITE_ROW) {
+    ++columnCount;
+    const auto* name = reinterpret_cast<const char*>(sqlite3_column_text(schemaInfo, 1));
+    const auto* declaredType = reinterpret_cast<const char*>(sqlite3_column_text(schemaInfo, 2));
+    if (name != nullptr && declaredType != nullptr && std::strcmp(name, "value") == 0 &&
+        std::strcmp(declaredType, "INTEGER") == 0) {
+      valueColumnValid = true;
+    }
+  }
+  sqlite3_finalize(schemaInfo);
+  if (ret != SQLITE_DONE || columnCount != 1 || !valueColumnValid) {
+    return false;
+  }
+
+  sqlite3_stmt* schemaValue = nullptr;
+  ret = sqlite3_prepare_v2(db, "SELECT value FROM aurora_schema", -1, &schemaValue, nullptr);
+  if (ret != SQLITE_OK) {
+    return false;
+  }
+  size_t rowCount = 0;
+  bool valueMatches = false;
+  while ((ret = sqlite3_step(schemaValue)) == SQLITE_ROW) {
+    ++rowCount;
+    if (sqlite3_column_type(schemaValue, 0) == SQLITE_INTEGER &&
+        sqlite3_column_int64(schemaValue, 0) == PipelineCacheSchema) {
+      valueMatches = true;
+    }
+  }
+  sqlite3_finalize(schemaValue);
+  return ret == SQLITE_DONE && rowCount == 1 && valueMatches;
+}
