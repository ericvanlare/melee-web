+  void observe_command(uint32_t frameIndex, uint64_t frameId, uint32_t opIndex, uint32_t commandIndex,
+                       uint32_t commandType, bool callbackPresent) noexcept {
+    if (!begin_or_match(frameIndex, frameId)) return;
+    ++commandRecordCount_;
+    currentOpIndex_ = opIndex;
+    currentCommandIndex_ = commandIndex;
+    if (commandType > 4u) fail(AURORA_BROWSER_FRAME_EFFECT_UNKNOWN_COMMAND);
+    if (commandType == 2u && !callbackPresent) fail(AURORA_BROWSER_FRAME_EFFECT_UNCLASSIFIED_DRAW);
+    auto row = make_event(AURORA_BROWSER_FRAME_EFFECT_EVENT_COMMAND, opIndex, commandIndex);
+    row.flags = commandType;
+    row.value0 = callbackPresent ? 1u : 0u;
+    append(row);
+  }
