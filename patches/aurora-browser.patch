+  // capacity metadata; packetActive distinguishes liveness without hiding it.
+  out.packetBuffers[0] = describe_buffer(packet.verts);
+  out.packetBuffers[1] = describe_buffer(packet.uniforms);
+  out.packetBuffers[2] = describe_buffer(packet.indices);
+  out.packetBuffers[3] = describe_buffer(packet.storage);
+  out.packetBuffers[4] = describe_buffer(packet.textureUpload);
