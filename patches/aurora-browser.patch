+  out.createdPipelines = stats.createdPipelines;
+  out.drawCallCount = stats.drawCallCount;
+  out.pipelineCacheStatus = browser_pipeline_cache_status();
+  out.pendingFramePackets = submission.pendingFramePackets;
+  out.pendingStagingBuffers = submission.pendingStagingBuffers;
+  out.workerBusy = submission.workerBusy;
+  out.lastRegistrationSequence = g_browserSubmissionSequence.load(std::memory_order_acquire);
+  out.lastCallbackSequence = g_browserCallbackSequence.load(std::memory_order_acquire);
+  out.staleCallbackCount = g_browserStaleCallbackCount.load(std::memory_order_acquire);
+  return out;
