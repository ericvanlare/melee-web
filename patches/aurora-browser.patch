+  AURORA_BROWSER_STAGING_STREAM_COUNT = 5,
+};
+typedef struct {
+  uint64_t dataAddress;
+  uint64_t length;
+  uint64_t capacity;
+  uint64_t maxCapacity;
+  uint32_t owned;
+  uint32_t reserved;
+} AuroraBrowserByteBufferDescriptor;
+typedef struct {
+  uint32_t frameSlot;
+  uint32_t packetActive;
+  uint32_t packetStagingBuffer;
+  uint32_t reserved;
+  uint64_t packetFrameId;
+  uint64_t shadowPreviousUsed[AURORA_BROWSER_STAGING_STREAM_COUNT];
+  AuroraBrowserByteBufferDescriptor packetBuffers[AURORA_BROWSER_STAGING_STREAM_COUNT];
+  AuroraBrowserByteBufferDescriptor shadowBuffers[AURORA_BROWSER_STAGING_STREAM_COUNT];
+} AuroraBrowserFrameStagingDescriptor;
+typedef enum {
+  AURORA_BROWSER_SUBMISSION_IDLE = 0,
+  AURORA_BROWSER_SUBMISSION_REGISTERED = 1,
+  AURORA_BROWSER_SUBMISSION_COMPLETED = 2,
