new file mode 100644
index 0000000000000000000000000000000000000000..17fb09eca1b46fad73f97f6f3a8d24c76ac08eed
--- /dev/null
+++ b/tests/pipeline_prepare_state_test.cpp
@@ -0,0 +1,111 @@
+#include "../lib/gfx/pipeline_prepare_state.hpp"
+
+#include <cassert>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+using aurora::gfx::selective::DescriptorIdentity;
+using aurora::gfx::selective::GateResult;
+using aurora::gfx::selective::MaxSeedDescriptors;
+using aurora::gfx::selective::PipelineSelection;
+using aurora::gfx::selective::RegistryInsertResult;
+using aurora::gfx::selective::RequestResult;
+using aurora::gfx::selective::SeedDescriptorRegistry;
+
+static AuroraPipelineDescriptor descriptor(uint32_t type, uint64_t ref, uint32_t version,
+                                           const DescriptorIdentity& identity) {
+  AuroraPipelineDescriptor result{
+      .type = type,
+      .pipeline_ref = ref,
+      .config_version = version,
+      .config_size = identity.configSize,
+      .sha256 = {},
+  };
+  std::memcpy(result.sha256, identity.sha256.data(), identity.sha256.size());
+  return result;
+}
+
+int main() {
+  const uint8_t abc[] = {'a', 'b', 'c'};
+  const auto digest = aurora::gfx::selective::sha256(abc, sizeof(abc));
+  const uint8_t expected[] = {
+      0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea, 0x41, 0x41, 0x40, 0xde, 0x5d, 0xae, 0x22, 0x23,
+      0xb0, 0x03, 0x61, 0xa3, 0x96, 0x17, 0x7a, 0x9c, 0xb4, 0x10, 0xff, 0x61, 0xf2, 0x00, 0x15, 0xad,
+  };
+  assert(std::memcmp(digest.data(), expected, sizeof(expected)) == 0);
+
+  SeedDescriptorRegistry registry;
+  const uint8_t firstBytes[] = {1, 2, 3, 4};
+  assert(registry.add_seed(AURORA_PIPELINE_SHADER_GX, 0x11, 7, 12, firstBytes, sizeof(firstBytes)) ==
+         RegistryInsertResult::Inserted);
+  const auto* first = registry.find({.type = AURORA_PIPELINE_SHADER_GX, .pipelineRef = 0x11, .configVersion = 7});
+  assert(first != nullptr);
+  assert(registry.contains(first->identity.key));
+  assert(!registry.contains({.type = AURORA_PIPELINE_SHADER_GX, .pipelineRef = 0x12, .configVersion = 7}));
+  const DescriptorIdentity firstIdentity = first->identity;
+  assert(registry.add_seed(AURORA_PIPELINE_SHADER_GX, 0x11, 7, 12, firstBytes, sizeof(firstBytes)) ==
+         RegistryInsertResult::Duplicate);
+
+  const uint8_t changedBytes[] = {1, 2, 3, 5};
+  assert(registry.add_seed(AURORA_PIPELINE_SHADER_GX, 0x11, 7, 12, changedBytes, sizeof(changedBytes)) ==
+         RegistryInsertResult::Conflict);
+  assert(registry.add_seed(AURORA_PIPELINE_SHADER_CLEAR, 0x11, 7, 12, firstBytes, sizeof(firstBytes)) ==
+         RegistryInsertResult::Inserted);
+  assert(!registry.global_refs_unique()); // Typed registry permits it; GPU map identity does not.
+
+  SeedDescriptorRegistry uniqueRefs;
+  assert(uniqueRefs.add_seed(AURORA_PIPELINE_SHADER_GX, 0x12, 7, 12, firstBytes, sizeof(firstBytes)) ==
+         RegistryInsertResult::Inserted);
+  assert(uniqueRefs.global_refs_unique());
+
+  const AuroraPipelineDescriptor firstDescriptor = descriptor(AURORA_PIPELINE_SHADER_GX, 0x11, 7, firstIdentity);
+  const AuroraPipelineDescriptor duplicateDescriptor = firstDescriptor;
+  PipelineSelection selection;
+  assert(selection.replace(&firstDescriptor, 1, registry) == RequestResult::Accepted);
+  assert(selection.size() == 1);
+  assert(selection.contains(firstIdentity.key));
+  assert(!selection.contains({.type = AURORA_PIPELINE_SHADER_GX, .pipelineRef = 0x12, .configVersion = 7}));
+
+  AuroraPipelineDescriptor requestWithDuplicate[] = {firstDescriptor, duplicateDescriptor};
+  assert(selection.replace(requestWithDuplicate, 2, registry) == RequestResult::Accepted);
+  assert(selection.size() == 1);
+
+  const uint8_t wrongSha[] = {0xff, 0xee, 0xdd, 0xcc};
+  AuroraPipelineDescriptor wrongDescriptor = firstDescriptor;
+  std::memcpy(wrongDescriptor.sha256, wrongSha, sizeof(wrongSha));
+  assert(selection.replace(&wrongDescriptor, 1, registry) == RequestResult::Unknown);
+  assert(selection.size() == 1); // Failed replacement is atomic.
+
+  const DescriptorIdentity exact = firstIdentity;
+  assert(registry.gate(exact, firstBytes, sizeof(firstBytes)) == GateResult::Allowed);
+  assert(registry.gate(exact, changedBytes, sizeof(changedBytes)) == GateResult::ByteMismatch);
+  DescriptorIdentity unknown = exact;
+  unknown.key.pipelineRef = 0x99;
+  assert(registry.gate(unknown, firstBytes, sizeof(firstBytes)) == GateResult::Unknown);
+
+  SeedDescriptorRegistry bounded;
+  const uint8_t oneByte[] = {0};
+  for (size_t i = 0; i < MaxSeedDescriptors; ++i) {
+    assert(bounded.add_seed(AURORA_PIPELINE_SHADER_GX, i, 7, 0, oneByte, sizeof(oneByte)) ==
+           RegistryInsertResult::Inserted);
+  }
+  assert(bounded.size() == MaxSeedDescriptors);
+  assert(bounded.add_seed(AURORA_PIPELINE_SHADER_GX, MaxSeedDescriptors, 7, 0, oneByte, sizeof(oneByte)) ==
+         RegistryInsertResult::Overflow);
+
+  SeedDescriptorRegistry byteBounded;
+  const std::vector<uint8_t> sixteenKiB(16u * 1024u, 0);
+  for (size_t i = 0; i < MaxSeedDescriptors; ++i) {
+    assert(byteBounded.add_seed(AURORA_PIPELINE_SHADER_GX, i, 8, 0, sixteenKiB.data(), sixteenKiB.size()) ==
+           RegistryInsertResult::Inserted);
+  }
+  assert(byteBounded.total_config_bytes() == aurora::gfx::selective::MaxRetainedConfigBytes);
+  assert(byteBounded.add_seed(AURORA_PIPELINE_SHADER_CLEAR, 0x1234, 8, 0, oneByte, sizeof(oneByte)) ==
+         RegistryInsertResult::Overflow);
+
+  registry.clear();
+  assert(registry.size() == 0);
+  assert(registry.find(exact) == nullptr);
+  return 0;
+}
