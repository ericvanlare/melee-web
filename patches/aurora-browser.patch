+    const auto state = state_.load(std::memory_order_acquire);
+    if (state != AURORA_BROWSER_FRAME_EFFECT_FENCED && state != AURORA_BROWSER_FRAME_EFFECT_FAILED) return false;
+    firstDrawFinalized_ = true;
+    return true;
+  }
