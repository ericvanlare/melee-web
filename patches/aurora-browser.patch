+                                                 uint64_t registrationSequence,
+                                                 uint64_t generation,
+                                                 const std::atomic_uint64_t& currentGeneration,
+                                                 uint64_t callbackSequence,
+                                                 bool success) {
+    std::lock_guard lock{m_mutex};
+    auto& owner = m_records[slot];
+    // A callback from an older captured generation is stale and must not touch
+    // the slot. A current-generation registration/state mismatch is different:
