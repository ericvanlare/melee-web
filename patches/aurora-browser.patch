+  void observe_depth_state(uint32_t action, bool enabled, bool requested, bool due, bool validSource,
+                           uint32_t nextSlot, uint32_t slotIndex, uint32_t slotState,
+                           uint32_t width, uint32_t height, uint64_t byteSize,
+                           uintptr_t storageBuffer, uintptr_t readbackBuffer, uintptr_t paramsBuffer,
+                           uint32_t latestWidth, uint32_t latestHeight,
+                           uint32_t issuingIndex = 0, uint64_t issuingId = 0) noexcept {
+    if (!accept_depth_issuer(issuingIndex, issuingId)) return;
+    if (!collecting_or_submitted()) return;
+    ++depthTraceCount_;
+    auto row = make_event(AURORA_BROWSER_FRAME_EFFECT_EVENT_DEPTH_STATE, currentOpIndex_, slotIndex);
+    row.flags = action;
+    row.value0 = (enabled ? 1u : 0u) | (requested ? 2u : 0u) | (due ? 4u : 0u) | (validSource ? 8u : 0u);
+    row.value1 = nextSlot;
+    row.value2 = slotState;
+    row.value3 = width;
+    row.handleA = handle(AURORA_BROWSER_FRAME_EFFECT_HANDLE_BUFFER, storageBuffer);
+    row.handleB = handle(AURORA_BROWSER_FRAME_EFFECT_HANDLE_BUFFER, readbackBuffer);
+    append(row);
+    auto sizes = make_event(AURORA_BROWSER_FRAME_EFFECT_EVENT_DEPTH_STATE, currentOpIndex_, slotIndex);
+    sizes.flags = action | 0x100u;
+    sizes.value0 = height;
+    sizes.value1 = static_cast<uint32_t>(byteSize);
+    sizes.value2 = static_cast<uint32_t>(byteSize >> 32);
+    sizes.value3 = latestWidth;
+    sizes.handleA = handle(AURORA_BROWSER_FRAME_EFFECT_HANDLE_BUFFER, paramsBuffer);
+    sizes.handleB = (static_cast<uint64_t>(latestWidth) << 32) | latestHeight;
+    append(sizes);
+    if (slotState == 1u || slotState == 2u) set_blocker(AURORA_BROWSER_FRAME_EFFECT_DEPTH_MAP_PENDING);
+  }
+
+  void observe_depth_request(uint32_t action, bool enabled, bool requested, bool due,
+                             uint32_t nextSlot, uint32_t latestWidth, uint32_t latestHeight,
+                             uint32_t issuingIndex = 0, uint64_t issuingId = 0) noexcept {
+    if (!accept_depth_issuer(issuingIndex, issuingId)) return;
+    const auto state = state_.load(std::memory_order_acquire);
+    if (state != AURORA_BROWSER_FRAME_EFFECT_ARMED && state != AURORA_BROWSER_FRAME_EFFECT_COLLECTING) return;
+    ++depthTraceCount_;
+    if (action == AURORA_BROWSER_FRAME_EFFECT_DEPTH_ACTION_REQUEST) ++depthRequestCount_;
+    auto row = make_event(AURORA_BROWSER_FRAME_EFFECT_EVENT_DEPTH_STATE, currentOpIndex_, depthRequestCount_);
+    row.flags = action;
+    row.value0 = (enabled ? 1u : 0u) | (requested ? 2u : 0u) | (due ? 4u : 0u);
+    row.value1 = depthRequestCount_;
+    row.value2 = nextSlot;
+    row.value3 = latestWidth;
+    row.handleA = (static_cast<uint64_t>(latestWidth) << 32) | latestHeight;
+    append_or_queue_prebegin(row);
+  }
+
+  uint64_t observe_depth_map_registration(uint32_t slotIndex, uint64_t byteSize, uintptr_t buffer,
+                                          uint32_t issuingIndex = 0, uint64_t issuingId = 0) noexcept {
+    if (!accept_depth_issuer(issuingIndex, issuingId)) return 0;
+    if (!collecting_or_submitted()) return 0;
+    if (firstDrawMode_ && depthMapOwnerCount_ >= selectedMapSlots_.size()) {
+      fail(AURORA_BROWSER_FRAME_EFFECT_EVENT_OVERFLOW); return 0;
+    }
+    ++depthTraceCount_;
+    const uint64_t ownerId = ++depthMapOwnerCount_;
+    if (firstDrawMode_) selectedMapSlots_[ownerId - 1] = slotIndex;
+    auto row = make_event(AURORA_BROWSER_FRAME_EFFECT_EVENT_DEPTH_STATE, currentOpIndex_, slotIndex);
+    row.flags = AURORA_BROWSER_FRAME_EFFECT_DEPTH_ACTION_MAP_REGISTERED | 0x200u;
+    row.value0 = static_cast<uint32_t>(byteSize);
+    row.value1 = static_cast<uint32_t>(byteSize >> 32);
+    row.value2 = static_cast<uint32_t>(ownerId);
+    row.value3 = static_cast<uint32_t>(ownerId >> 32);
+    row.handleA = handle(AURORA_BROWSER_FRAME_EFFECT_HANDLE_BUFFER, buffer);
+    row.handleB = ownerId;
+    append(row);
+    return ownerId;
+  }
+
+  void note_depth_blocker(uint32_t blocker, uint32_t issuingIndex = 0, uint64_t issuingId = 0) noexcept {
+    if (accept_depth_issuer(issuingIndex, issuingId)) fail(blocker);
+  }
+
+  void observe_depth_map_callback(uint32_t slotIndex, uint64_t ownerId, uint32_t mapStatus, bool mappedRange,
+                                 uint32_t slotState, uint32_t latestWidth, uint32_t latestHeight,
+                                 uint32_t issuingIndex = 0, uint64_t issuingId = 0) noexcept {
+    if (!accept_depth_issuer(issuingIndex, issuingId)) return;
+    if (firstDrawMode_) {
+      // The selected map may complete after its queue fence; do not discard it.
+      if (firstDrawFinalized_ || ownerId == 0 || ownerId > depthMapOwnerCount_ ||
+          ownerId > selectedMapSlots_.size() || selectedMapSlots_[ownerId - 1] != slotIndex ||
+          selectedMapDone_[ownerId - 1]) {
+        set_blocker(AURORA_BROWSER_FRAME_EFFECT_DEPTH_MAP_OWNER_UNKNOWN); return;
+      }
+      selectedMapDone_[ownerId - 1] = true;
+      ++selectedMapCompleted_;
+    } else if (!collecting_or_submitted()) return;
+    ++depthTraceCount_;
+    auto row = make_event(AURORA_BROWSER_FRAME_EFFECT_EVENT_DEPTH_STATE, currentOpIndex_, slotIndex);
+    row.flags = AURORA_BROWSER_FRAME_EFFECT_DEPTH_ACTION_MAP_COMPLETE;
+    row.value0 = mapStatus;
+    row.value1 = mappedRange ? 1u : 0u;
+    row.value2 = slotState;
+    row.value3 = latestWidth;
+    row.handleA = (static_cast<uint64_t>(latestWidth) << 32) | latestHeight;
+    row.handleB = ownerId;
+    append(row);
+    if (ownerId == 0) set_blocker(AURORA_BROWSER_FRAME_EFFECT_DEPTH_MAP_OWNER_UNKNOWN);
+  }
+
+  void observe_depth_read(uint16_t x, uint16_t y, bool found, uint32_t value,
+                          uint32_t issuingIndex = 0, uint64_t issuingId = 0) noexcept {
+    if (!accept_depth_issuer(issuingIndex, issuingId)) return;
+    const auto state = state_.load(std::memory_order_acquire);
+    if (state != AURORA_BROWSER_FRAME_EFFECT_ARMED && state != AURORA_BROWSER_FRAME_EFFECT_COLLECTING) return;
+    ++depthTraceCount_;
+    auto row = make_event(AURORA_BROWSER_FRAME_EFFECT_EVENT_DEPTH_READ, currentOpIndex_, currentCommandIndex_);
+    row.flags = found ? 1u : 0u;
+    row.value0 = x;
+    row.value1 = y;
+    row.value2 = value;
+    append_or_queue_prebegin(row);
+  }
