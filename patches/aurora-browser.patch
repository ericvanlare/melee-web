+      [token, frame = submitFrame, started](wgpu::QueueWorkDoneStatus status, wgpu::StringView) {
+        pending = false;
+        EM_ASM({
+          if (window.runtimeGPUProbeResult) window.runtimeGPUProbeResult({
+            token:$0, submit_frame:$1, latency_ms:$2, status:$3, success:!!$4
+          });
+        }, token, frame, emscripten_get_now() - started, static_cast<int>(status),
+           status == wgpu::QueueWorkDoneStatus::Success);
+      });
+}
