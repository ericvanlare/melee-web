+ public:
+  BrowserSubmissionOwnerBook(uint32_t registeredState, uint32_t completedState,
+                             uint32_t failedState, uint32_t immediateState)
+      : m_registeredState(registeredState),
+        m_completedState(completedState),
+        m_failedState(failedState),
+        m_immediateState(immediateState) {}
