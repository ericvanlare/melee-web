+#pragma once
+
+/*
+ * This header exposes common pipeline preparation controls and the optional
+ * selective pipeline descriptor API. It is intentionally independent of
+ * MELEE_WEB_PIPELINE_PROVENANCE so a shipping build can use reviewed controls
+ * without enabling capture.
+ */
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Enable complete draw resolution for non-selective development rendering. */
+int aurora_pipeline_set_complete_draws(int enabled);
+
+/* Return whether complete draw resolution is currently enabled. */
+int aurora_pipeline_complete_draws_enabled(void);
+
+/* Drain queued pipeline work without starting or clearing a render frame. */
+int aurora_pipeline_service_preparation(void);
+
+#if defined(MELEE_WEB_SELECTIVE_PIPELINES)
+
+/* Values are the current aurora::gfx::ShaderType values. */
+enum {
+  AURORA_PIPELINE_SHADER_CLEAR = 0,
+  AURORA_PIPELINE_SHADER_GX = 1,
+  AURORA_PIPELINE_SHADER_RML = 2,
+};
+
+typedef struct AuroraPipelineDescriptor {
+  uint32_t type;
+  uint64_t pipeline_ref;
+  uint32_t config_version;
+  uint32_t config_size;
+  uint8_t sha256[32];
+} AuroraPipelineDescriptor;
+
+typedef enum AuroraPipelinePrepareState {
+  AURORA_PIPELINE_PREPARE_UNCONFIGURED = 0,
+  /* Selective mode is active but the first post-init union is not supplied. */
+  AURORA_PIPELINE_PREPARE_ENABLED_NO_REQUEST = 1,
+  AURORA_PIPELINE_PREPARE_VALIDATING = 2,
+  AURORA_PIPELINE_PREPARE_PENDING = 3,
+  AURORA_PIPELINE_PREPARE_READY = 4,
+  AURORA_PIPELINE_PREPARE_UNKNOWN_MEMBERSHIP = 5,
+  AURORA_PIPELINE_PREPARE_ERROR = 6,
+} AuroraPipelinePrepareState;
+
+typedef struct AuroraPipelinePrepareStatus {
+  uint32_t state;
+  uint8_t configured;
+  uint8_t valid;
+  uint8_t ready;
+  uint8_t reserved;
+  uint32_t requested_count;
+  uint32_t unique_count;
+  uint32_t accepted_count;
+  uint32_t ready_count;
+  uint32_t pending_count;
+  uint32_t unknown_count;
+  uint32_t error_count;
+  uint32_t invalid_index;
+  uint64_t retained_config_bytes;
+  uint32_t unexpected_count;
+  uint32_t deferred_count;
+} AuroraPipelinePrepareStatus;
+
+/* Arm selective mode. Call while the Aurora pipeline cache is stopped. */
+int aurora_pipeline_prepare_enable(void);
+
+/* Disable selective mode. Call while the Aurora pipeline cache is stopped. */
+int aurora_pipeline_prepare_disable(void);
+
+/*
+ * Replace the active allowed union. Call after cache initialization and before
+ * the next source/render operation. The array is copied before return.
+ */
+int aurora_prepare_pipeline_union(const AuroraPipelineDescriptor *entries,
+                                  size_t count);
+
+/* Prepare all descriptors in the verified, already imported catalog. This
+ * uses the same membership checks, queue and deduplication as an explicit union. */
+int aurora_prepare_pipeline_catalog(void);
+
+/* Read a synchronized status snapshot. Returns zero only for a null output. */
+int aurora_pipeline_prepare_status(AuroraPipelinePrepareStatus *out);
+
+/* Public alpha only: service deferred descriptors after the owner has paused
+ * its source clock. Lookup never constructs an undeclared pipeline. */
+int aurora_pipeline_prepare_deferred(void);
+
+#endif /* defined(MELEE_WEB_SELECTIVE_PIPELINES) */
+
+#ifdef __cplusplus
+}
+#endif
