+  out.stagingSlot = static_cast<uint32_t>(stagingSlot);
+  out.state = owner.state;
+  out.futureId = owner.futureId;
+  out.registrationSequence = owner.registrationSequence;
+  out.callbackSequence = owner.callbackSequence;
+  out.capturedGeneration = owner.capturedGeneration;
+  out.queueHandle = owner.queueHandle;
