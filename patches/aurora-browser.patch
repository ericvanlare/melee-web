+  void begin_draw_callback() noexcept {
+    if (!collecting()) return;
+    drawCallbackActive_ = true;
+    drawCallbackStartCount_ = actualDrawCount_;
+  }
+
+  void end_draw_callback() noexcept {
+    if (!collecting() || !drawCallbackActive_) return;
+    if (actualDrawCount_ == drawCallbackStartCount_) fail(AURORA_BROWSER_FRAME_EFFECT_UNCLASSIFIED_DRAW);
+    drawCallbackActive_ = false;
+  }
