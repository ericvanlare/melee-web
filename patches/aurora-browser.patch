+    currentPipelineKey_ = pipelineKey;
+    currentPipelineId_ = handle(AURORA_BROWSER_FRAME_EFFECT_HANDLE_PIPELINE, pipelineObject);
+    const uint32_t words[] = {static_cast<uint32_t>(pipelineKey), static_cast<uint32_t>(pipelineKey >> 32)};
+    register_resource(AURORA_BROWSER_FRAME_EFFECT_HANDLE_PIPELINE, pipelineObject,
+                      handle(AURORA_BROWSER_FRAME_EFFECT_HANDLE_DEVICE, deviceObject), words, 2);
