diff --git a/include/aurora/aurora_browser_future_owner_accessor.h b/include/aurora/aurora_browser_future_owner_accessor.h
new file mode 100644
index 0000000000000000000000000000000000000000..2ecd22a6c10e9caf99ce33d9c0a465a076965c7f
--- /dev/null
+++ b/include/aurora/aurora_browser_future_owner_accessor.h
@@ -0,0 +1,132 @@
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Read-only metadata returned by the Emscripten JS-library bridge. The bridge
+ * writes all bytes, including padding, before returning. Promise settlement and
+ * WebGPU graph reconstruction are deliberately represented as unsupported
+ * diagnostics rather than inferred from synchronous JS observations. */
+typedef struct {
+  uint32_t schemaVersion;
+  uint32_t statusFlags;
+  uint32_t errorCode;
+  uint32_t reserved;
+  uint64_t futuresArrayLabel;
+  uint64_t futuresLength;
+  uint64_t futuresOwnCount;
+  uint64_t futuresMaxIndex;
+  uint64_t jsObjectsArrayLabel;
+  uint64_t jsObjectsLength;
+  uint64_t jsObjectsOwnCount;
+  uint64_t jsObjectsMaxIndex;
+  uint64_t futureRowCount;
+  uint64_t jsObjectRowCount;
+} AuroraBrowserFutureOwnerSummary;
+
+/* One row is either a sparse WebGPU.Internals.futures entry or a sparse
+ * WebGPU.Internals.jsObjects entry. identityLabel is an accessor-private opaque
+ * identity, never a JS pointer and never a restorable handle. */
+typedef struct {
+  uint32_t kind;
+  uint32_t rowFlags;
+  uint32_t valueKind;
+  uint32_t reserved;
+  uint64_t index;
+  uint64_t identityLabel;
+} AuroraBrowserFutureOwnerRow;
+
+/* Return values: 1 = summary/row written; 0 = no prior summary for rows;
+ * negative values are fail-closed integrity errors. Invalid output pointers,
+ * byte counts, alignments, and ordinals are rejected before any heap write. Unsupported settlement and
+ * graph state are positive statusFlags, because they are observations rather
+ * than an authorization to restore. */
+enum {
+  AURORA_BROWSER_FUTURE_OWNER_SCHEMA_VERSION = 2,
+  AURORA_BROWSER_FUTURE_OWNER_STATUS_SETTLEMENT_UNKNOWN = 1u << 0,
+  AURORA_BROWSER_FUTURE_OWNER_STATUS_GRAPH_UNSUPPORTED = 1u << 1,
+  AURORA_BROWSER_FUTURE_OWNER_STATUS_DELETED_TRACKED_ENTRY = 1u << 2,
+  AURORA_BROWSER_FUTURE_OWNER_STATUS_NONINDEX_PROPERTY = 1u << 3,
+  AURORA_BROWSER_FUTURE_OWNER_ERROR_NO_INTERNALS = -1,
+  AURORA_BROWSER_FUTURE_OWNER_ERROR_OUTPUT = -2,
+  AURORA_BROWSER_FUTURE_OWNER_ERROR_ARRAY_REPLACED = -3,
+  AURORA_BROWSER_FUTURE_OWNER_ERROR_ENTRY_REPLACED = -4,
+  AURORA_BROWSER_FUTURE_OWNER_ERROR_DESCRIPTOR = -5,
+  AURORA_BROWSER_FUTURE_OWNER_ERROR_SHAPE = -6,
+  AURORA_BROWSER_FUTURE_OWNER_ERROR_ORDINAL = -7,
+  AURORA_BROWSER_FUTURE_OWNER_ERROR_UNSUPPORTED = -8,
+};
+
+enum {
+  AURORA_BROWSER_FUTURE_OWNER_ROW_F_PRESENT = 1u << 0,
+  AURORA_BROWSER_FUTURE_OWNER_ROW_F_SETTLEMENT_UNKNOWN = 1u << 1,
+  AURORA_BROWSER_FUTURE_OWNER_ROW_F_OPAQUE_GRAPH = 1u << 2,
+  AURORA_BROWSER_FUTURE_OWNER_VALUE_UNDEFINED = 1,
+  AURORA_BROWSER_FUTURE_OWNER_VALUE_OBJECT = 2,
+  AURORA_BROWSER_FUTURE_OWNER_VALUE_NULL = 3,
+  AURORA_BROWSER_FUTURE_OWNER_VALUE_PRIMITIVE = 4,
+};
+
+size_t aurora_browser_future_owner_summary_bytes(void);
+size_t aurora_browser_future_owner_row_bytes(void);
+size_t aurora_browser_future_owner_row_count(void);
+/* 1 = single-threaded Emscripten accessor available; negative = explicit unsupported. */
+int aurora_browser_future_owner_capability(void);
+int aurora_browser_future_owner_summary(void* out, size_t bytes);
+int aurora_browser_future_owner_row(void* out, size_t bytes, int32_t ordinal);
+int aurora_browser_future_owner_dispose(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#ifdef __cplusplus
+static_assert(sizeof(AuroraBrowserFutureOwnerSummary) == 96,
+              "future owner summary ABI changed");
+static_assert(sizeof(AuroraBrowserFutureOwnerRow) == 32,
+              "future owner row ABI changed");
+static_assert(offsetof(AuroraBrowserFutureOwnerSummary, schemaVersion) == 0,
+              "future owner summary schema offset changed");
+static_assert(offsetof(AuroraBrowserFutureOwnerSummary, statusFlags) == 4,
+              "future owner summary status offset changed");
+static_assert(offsetof(AuroraBrowserFutureOwnerSummary, errorCode) == 8,
+              "future owner summary error offset changed");
+static_assert(offsetof(AuroraBrowserFutureOwnerSummary, reserved) == 12,
+              "future owner summary reserved offset changed");
+static_assert(offsetof(AuroraBrowserFutureOwnerSummary, futuresArrayLabel) == 16,
+              "future owner summary futures label offset changed");
+static_assert(offsetof(AuroraBrowserFutureOwnerSummary, futuresLength) == 24,
+              "future owner summary futures length offset changed");
+static_assert(offsetof(AuroraBrowserFutureOwnerSummary, futuresOwnCount) == 32,
+              "future owner summary futures count offset changed");
+static_assert(offsetof(AuroraBrowserFutureOwnerSummary, futuresMaxIndex) == 40,
+              "future owner summary futures max offset changed");
+static_assert(offsetof(AuroraBrowserFutureOwnerSummary, jsObjectsArrayLabel) == 48,
+              "future owner summary objects label offset changed");
+static_assert(offsetof(AuroraBrowserFutureOwnerSummary, jsObjectsLength) == 56,
+              "future owner summary objects length offset changed");
+static_assert(offsetof(AuroraBrowserFutureOwnerSummary, jsObjectsOwnCount) == 64,
+              "future owner summary objects count offset changed");
+static_assert(offsetof(AuroraBrowserFutureOwnerSummary, jsObjectsMaxIndex) == 72,
+              "future owner summary objects max offset changed");
+static_assert(offsetof(AuroraBrowserFutureOwnerSummary, futureRowCount) == 80,
+              "future owner summary future rows offset changed");
+static_assert(offsetof(AuroraBrowserFutureOwnerSummary, jsObjectRowCount) == 88,
+              "future owner summary object rows offset changed");
+static_assert(offsetof(AuroraBrowserFutureOwnerRow, kind) == 0,
+              "future owner row kind offset changed");
+static_assert(offsetof(AuroraBrowserFutureOwnerRow, rowFlags) == 4,
+              "future owner row flags offset changed");
+static_assert(offsetof(AuroraBrowserFutureOwnerRow, valueKind) == 8,
+              "future owner row value kind offset changed");
+static_assert(offsetof(AuroraBrowserFutureOwnerRow, reserved) == 12,
+              "future owner row reserved offset changed");
+static_assert(offsetof(AuroraBrowserFutureOwnerRow, index) == 16,
+              "future owner row index offset changed");
+static_assert(offsetof(AuroraBrowserFutureOwnerRow, identityLabel) == 24,
+              "future owner row identity offset changed");
+#endif
