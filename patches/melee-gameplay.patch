+        display_ground != Ground_GetMapGObj(PsType_Display))
+        return 0;
+    ground = HSD_GObjGetUserData(display_ground);
+    if (ground == NULL || ground->map_id != PsType_Display ||
+        ground->u.display.xD4 != owner->children[0] ||
+        ground->u.display.xD8 != owner->children[1] ||
