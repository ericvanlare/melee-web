+    union {
+        struct {
+            /* 0x000 */ struct Toy26B8* x0;
+            /* 0x004 */ UNK_T x4;
+            /* 0x008 */ UNK_T x8;
+            /* 0x00C */ char devtext_26c4[0x8C];
+            /* 0x098 */ char devtext_2750[0xFC];
+            /* 0x194 */ u16 trophy_table[302];
+            /* 0x3F0 */ ToyAnimState anim;
+        };
+        struct Toy26B8 toy_view;
+    };
+};
