diff --git a/extern/dolphin/src/dolphin/ax/AXAux.c b/extern/dolphin/src/dolphin/ax/AXAux.c
index f78f8f9..4424b86 100644
--- a/extern/dolphin/src/dolphin/ax/AXAux.c
+++ b/extern/dolphin/src/dolphin/ax/AXAux.c
@@ -124,3 +124,62 @@ void AXRegisterAuxBCallback(void (*callback)(void*, void*), void* context)
     __AXCallbackAuxB = callback;
     __AXContextAuxB = context;
 }
+
+/* Native output must reject effects until their buffers are implemented. */
+u32 melee_web_audio_aux_enabled(void)
+{
+    return __AXCallbackAuxA != NULL || __AXCallbackAuxB != NULL;
+}
+
+#include <string.h>
+static struct {
+    __typeof__(__AXBufferAuxA) __AXBufferAuxA;
+    __typeof__(__AXBufferAuxB) __AXBufferAuxB;
+    __typeof__(__AXCallbackAuxA) __AXCallbackAuxA;
+    __typeof__(__AXCallbackAuxB) __AXCallbackAuxB;
+    __typeof__(__AXContextAuxA) __AXContextAuxA;
+    __typeof__(__AXContextAuxB) __AXContextAuxB;
+    __typeof__(__AXAuxADspWrite) __AXAuxADspWrite;
+    __typeof__(__AXAuxADspRead) __AXAuxADspRead;
+    __typeof__(__AXAuxBDspWrite) __AXAuxBDspWrite;
+    __typeof__(__AXAuxBDspRead) __AXAuxBDspRead;
+    __typeof__(__AXAuxDspWritePosition) __AXAuxDspWritePosition;
+    __typeof__(__AXAuxDspReadPosition) __AXAuxDspReadPosition;
+    __typeof__(__AXAuxCpuReadWritePosition) __AXAuxCpuReadWritePosition;
+} melee_aux_saved;
+void melee_web_audio_aux_begin(void)
+{
+    memcpy(&melee_aux_saved.__AXBufferAuxA,&__AXBufferAuxA,sizeof(__AXBufferAuxA));
+    memcpy(&melee_aux_saved.__AXBufferAuxB,&__AXBufferAuxB,sizeof(__AXBufferAuxB));
+    memcpy(&melee_aux_saved.__AXCallbackAuxA,&__AXCallbackAuxA,sizeof(__AXCallbackAuxA));
+    memcpy(&melee_aux_saved.__AXCallbackAuxB,&__AXCallbackAuxB,sizeof(__AXCallbackAuxB));
+    memcpy(&melee_aux_saved.__AXContextAuxA,&__AXContextAuxA,sizeof(__AXContextAuxA));
+    memcpy(&melee_aux_saved.__AXContextAuxB,&__AXContextAuxB,sizeof(__AXContextAuxB));
+    memcpy(&melee_aux_saved.__AXAuxADspWrite,&__AXAuxADspWrite,sizeof(__AXAuxADspWrite));
+    memcpy(&melee_aux_saved.__AXAuxADspRead,&__AXAuxADspRead,sizeof(__AXAuxADspRead));
+    memcpy(&melee_aux_saved.__AXAuxBDspWrite,&__AXAuxBDspWrite,sizeof(__AXAuxBDspWrite));
+    memcpy(&melee_aux_saved.__AXAuxBDspRead,&__AXAuxBDspRead,sizeof(__AXAuxBDspRead));
+    memcpy(&melee_aux_saved.__AXAuxDspWritePosition,&__AXAuxDspWritePosition,sizeof(__AXAuxDspWritePosition));
+    memcpy(&melee_aux_saved.__AXAuxDspReadPosition,&__AXAuxDspReadPosition,sizeof(__AXAuxDspReadPosition));
+    memcpy(&melee_aux_saved.__AXAuxCpuReadWritePosition,&__AXAuxCpuReadWritePosition,sizeof(__AXAuxCpuReadWritePosition));
+    memset(__AXBufferAuxA,0,sizeof(__AXBufferAuxA));
+    memset(__AXBufferAuxB,0,sizeof(__AXBufferAuxB));
+    __AXAuxInit();
+}
+void melee_web_audio_aux_end(void)
+{
+    __AXAuxQuit();
+    memcpy(&__AXBufferAuxA,&melee_aux_saved.__AXBufferAuxA,sizeof(__AXBufferAuxA));
+    memcpy(&__AXBufferAuxB,&melee_aux_saved.__AXBufferAuxB,sizeof(__AXBufferAuxB));
+    memcpy(&__AXCallbackAuxA,&melee_aux_saved.__AXCallbackAuxA,sizeof(__AXCallbackAuxA));
+    memcpy(&__AXCallbackAuxB,&melee_aux_saved.__AXCallbackAuxB,sizeof(__AXCallbackAuxB));
+    memcpy(&__AXContextAuxA,&melee_aux_saved.__AXContextAuxA,sizeof(__AXContextAuxA));
+    memcpy(&__AXContextAuxB,&melee_aux_saved.__AXContextAuxB,sizeof(__AXContextAuxB));
+    memcpy(&__AXAuxADspWrite,&melee_aux_saved.__AXAuxADspWrite,sizeof(__AXAuxADspWrite));
+    memcpy(&__AXAuxADspRead,&melee_aux_saved.__AXAuxADspRead,sizeof(__AXAuxADspRead));
+    memcpy(&__AXAuxBDspWrite,&melee_aux_saved.__AXAuxBDspWrite,sizeof(__AXAuxBDspWrite));
+    memcpy(&__AXAuxBDspRead,&melee_aux_saved.__AXAuxBDspRead,sizeof(__AXAuxBDspRead));
+    memcpy(&__AXAuxDspWritePosition,&melee_aux_saved.__AXAuxDspWritePosition,sizeof(__AXAuxDspWritePosition));
+    memcpy(&__AXAuxDspReadPosition,&melee_aux_saved.__AXAuxDspReadPosition,sizeof(__AXAuxDspReadPosition));
+    memcpy(&__AXAuxCpuReadWritePosition,&melee_aux_saved.__AXAuxCpuReadWritePosition,sizeof(__AXAuxCpuReadWritePosition));
+}
