+int melee_web_stadium_display_owner_capture(
+    MeleeWebStadiumDisplayOwner* owner, HSD_GObj* display_ground,
+    char* error, size_t error_size)
+{
+    if (owner == NULL || owner != stadium_display_owner_current ||
+        owner->state != STADIUM_DISPLAY_OWNER_BOUND || owner->capture_attempted)
+        return stadium_owner_error(error, error_size,
+                                   "Stadium display owner cannot capture this OnInit boundary");
+    owner->capture_attempted = 1;
+    if (!stadium_owner_capture_matches(owner, display_ground))
+        return stadium_owner_error(error, error_size,
+                                   "Original Stadium display owner journal did not match source SIS and Ground state");
+    owner->display_ground = display_ground;
+    owner->display_ground_data = HSD_GObjGetUserData(display_ground);
+    owner->state = STADIUM_DISPLAY_OWNER_CAPTURED;
+    if (error != NULL && error_size != 0) error[0] = '\0';
+    return 1;
+}
