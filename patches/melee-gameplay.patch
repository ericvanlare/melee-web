+static int stadium_owner_capture_matches(
+    const MeleeWebStadiumDisplayOwner* owner, HSD_GObj* display_ground)
+{
+    static const u8 child_links[3] = { 0x13, 0x12, 0x12 };
+    if (owner->journal_failed || owner->source_sis == NULL ||
+        !stadium_owner_text_topology_matches(owner, 1) ||
+        !stadium_owner_context_topology_matches(owner, 1) ||
+        stadium_owner_has_font1_before(owner) ||
+        !stadium_owner_slot_is_exact(HSD_SisLib_FontSlotBorrowable(1),
+                                     HSD_SisLib_804D1124[1],
+                                     owner->source_sis) ||
+        !stadium_owner_display_ground_matches(owner, display_ground))
+        return 0;
+    for (size_t i = 0; i < 3; ++i) {
+        HSD_GObj* child = owner->children[i];
+        HSD_ImageDesc* desc;
+        if (child == NULL || owner->wrappers[i] == NULL ||
+            !stadium_owner_gobj_linked(child, child_links[i]) ||
+            child->classifier != HSD_GOBJ_CLASS_TEXT ||
+            child->p_link != child_links[i] ||
+            child->user_data != owner->wrappers[i] ||
+            child->user_data_remove_func != HSD_Free)
+            return 0;
+        desc = stadium_owner_image_desc(owner, i);
+        if (owner->images[i].image_ptr == NULL ||
+            owner->images[i].image_ptr != desc->image_ptr ||
+            (owner->images[i].origin != MELEE_WEB_STADIUM_IMAGE_ORIGIN_OWNED_HSD &&
+             owner->images[i].origin != MELEE_WEB_STADIUM_IMAGE_ORIGIN_BORROWED_PRELOAD))
+            return 0;
+        for (size_t j = 0; j < i; ++j)
+            if (owner->images[i].image_ptr == owner->images[j].image_ptr &&
+                (owner->images[i].origin == MELEE_WEB_STADIUM_IMAGE_ORIGIN_OWNED_HSD ||
+                 owner->images[j].origin == MELEE_WEB_STADIUM_IMAGE_ORIGIN_OWNED_HSD))
+                return 0;
+    }
+    if (owner->context == NULL || owner->context->x4 != NULL ||
+        owner->context->xA != 1 || owner->context->x8 != 9 ||
+        owner->context->xC != 0xD || owner->context->xD != 0 ||
+        owner->context->xE != 1 || owner->context->xF != 0)
+        return 0;
+    for (size_t i = 0; i < 2; ++i) {
+        HSD_Text* text = owner->texts[i];
+        HSD_GObj* renderer = owner->renderers[i];
+        if (text == NULL || renderer == NULL ||
+            !stadium_owner_gobj_linked(renderer, 0xD) ||
+            text->font_idx != 1 ||
+            text->entity != renderer || renderer->classifier != HSD_GOBJ_CLASS_SISLIB_UNK ||
+            renderer->p_link != 0xD || renderer->user_data != text ||
+            renderer->user_data_remove_func != HSD_SisLib_803A5A2C)
+            return 0;
+    }
+    if (HSD_GObj_804D781C != NULL || HSD_GObj_804D7814 != NULL)
+        return 0;
+    return 1;
+}
