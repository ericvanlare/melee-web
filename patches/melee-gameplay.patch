+        owner->children[2] != NULL || owner->wrappers[0] != NULL ||
+        owner->wrappers[1] != NULL || owner->wrappers[2] != NULL ||
+        owner->texts[0] != NULL || owner->texts[1] != NULL ||
+        owner->context != NULL ||
