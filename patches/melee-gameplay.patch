+        !stadium_owner_context_topology_unchanged(owner) ||
+        !stadium_owner_slot_is_empty(HSD_SisLib_FontSlotBorrowable(1),
+                                     HSD_SisLib_804D1124[1]))
+        return stadium_owner_error(error, error_size,
+                                   "Partial Stadium display ownership must remain reachable");
+    stadium_display_owner_current = NULL;
+    stadium_owner_release_bookkeeping(owner);
+    if (error != NULL && error_size != 0) error[0] = '\0';
+    return 1;
+}
