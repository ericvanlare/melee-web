+        slow = slow->next;
+        fast = fast->next->next;
+        if (slow == fast) return 0;
+    }
+    *count = 0;
+    for (HSD_Text* node = head; node != NULL; node = node->next) {
+        if (*count == SIZE_MAX) return 0;
+        ++*count;
+    }
+    return 1;
