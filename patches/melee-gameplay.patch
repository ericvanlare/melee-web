+#if defined(MELEE_WEB_GAMEPLAY)
+/* The browser owns this record for its nominal 60 Hz source tick. It must not
+ * install an OS alarm or change PAD sampling; real hardware cadence remains a
+ * separate, explicitly unsupported boundary. */
+static struct lb_804329F0_t melee_source_cadence_saved;
+static OSTime melee_source_cadence_frame;
+static int melee_source_cadence_active;
+
+static int melee_source_cadence_owned(void)
+{
+    return melee_source_cadence_active && lb_804329F0.x48 == 0 &&
+           lb_804329F0.x0[0].x0 == melee_source_cadence_frame &&
+           lb_804329F0.x0[1].x0 == melee_source_cadence_frame &&
+           lb_804329F0.x38 == melee_source_cadence_frame &&
+           lb_804329F0.x40 == melee_source_cadence_frame;
+}
+
+int melee_web_source_cadence_begin(void)
+{
+    int i;
+
+    if (melee_source_cadence_active || lb_804329F0.x48 != 0) return 0;
+    melee_source_cadence_saved = lb_804329F0;
+    melee_source_cadence_frame = OSSecondsToTicks(1.0F / 60);
+    for (i = 0; i < 2; i++) {
+        lb_804329F0.x0[i].x0 = melee_source_cadence_frame;
+        lb_804329F0.x0[i].x8 = 0;
+        lb_804329F0.x0[i].x10 = 0;
+    }
+    lb_804329F0.x4 = 0;
+    lb_804329F0.x38 = melee_source_cadence_frame;
+    lb_804329F0.x40 = melee_source_cadence_frame;
+    lb_804329F0.x48 = 0;
+    melee_source_cadence_active = 1;
+    return 1;
+}
+
+int melee_web_source_cadence_tick(void)
+{
+    if (!melee_source_cadence_owned()) return 0;
+    /* lb_80019900 advances both source cadence edges and performs the original
+     * Game/Copy PAD renewal when edge 0 is ready. The caller has already done
+     * Master PAD renewal and must call this before source_clock_pre(). */
+    lb_80019900();
+    return melee_source_cadence_owned();
+}
+
+int melee_web_source_cadence_end(void)
+{
+    if (!melee_source_cadence_owned()) return 0;
+    lb_804329F0 = melee_source_cadence_saved;
+    melee_source_cadence_frame = 0;
+    melee_source_cadence_active = 0;
+    return 1;
+}
+#endif
