+STATIC_ASSERT(offsetof(struct ToyRuntimeAggregate, devtext_26c4) == 0xC);
+STATIC_ASSERT(offsetof(struct ToyRuntimeAggregate, devtext_2750) == 0x98);
+STATIC_ASSERT(offsetof(struct ToyRuntimeAggregate, trophy_table) +
