CpuRestoreFixtureSnapshot melee_web_cpu_restore_model_snapshot() {
    CpuRestoreFixtureSnapshot out{};
    out.action=source_state.action; out.audio=source_state.audio;
    out.flow=source_state.flow; out.bootstrap=source_state.bootstrap;
    out.context=source_state.context; out.payload=source_state.payload;
    out.rng=source_state.rng; out.pad=source_state.pad; out.transfer=source_state.transfer;
    return out;
}
void melee_web_cpu_restore_model_apply(const CpuRestoreFixtureSnapshot& in) {
    source_state.action=in.action; source_state.audio=in.audio;
    source_state.flow=in.flow; source_state.bootstrap=in.bootstrap;
    source_state.context=in.context; source_state.payload=in.payload;
    source_state.rng=in.rng; source_state.pad=in.pad; source_state.transfer=in.transfer;
}
bool melee_web_cpu_restore_model_equal(const CpuRestoreFixtureSnapshot& in) {
    const auto live=melee_web_cpu_restore_model_snapshot();
    return std::memcmp(&live,&in,sizeof(in))==0;
}
void melee_web_cpu_restore_mark_disarm() { ++capsule_disarms; }
void melee_web_cpu_restore_mark_destroy() { ++capsule_destroys; }

namespace melee_web {
GameplayCpuCheckpoint::~GameplayCpuCheckpoint() {
    if(source_step_possible_&&!retired_) std::abort();
    if(actions_) melee_web_action_interval_destroy(actions_);
    melee_web_cpu_restore_mark_destroy();
}
std::unique_ptr<GameplayCpuCheckpoint> GameplayCpuCheckpoint::capture(
    const GameplayMatchSession& session,
    std::unique_ptr<GameplayCpuStatics> statics,CpuCaptureDiagnostic& diagnostic,CpuCheckpointSpan span) noexcept {
    diagnostic={};
    if(fail_capture){diagnostic.comparison={7,1,UINT32_MAX,UINT32_MAX,0,0,0,0,5};
        std::snprintf(diagnostic.message.data(),diagnostic.message.size(),"fixture bootstrap capture refusal");return {};}
    if(!statics||!statics->capture()) return {};
    try {
        auto value=std::unique_ptr<GameplayCpuCheckpoint>(new GameplayCpuCheckpoint(span));
        value->statics_=std::move(statics);
        value->pre_frame_=session.source_frames();
        value->pre_=melee_web_cpu_restore_model_snapshot();
        pre_action=value->pre_.action;pre_audio=value->pre_.audio;pre_flow=value->pre_.flow;
        pre_bootstrap=value->pre_.bootstrap;pre_context=value->pre_.context;pre_payload=value->pre_.payload;
        pre_rng=value->pre_.rng;pre_pad=value->pre_.pad;pre_transfer=value->pre_.transfer;
        pre_source_frame=value->pre_frame_;
        value->actions_=reinterpret_cast<MeleeWebActionInterval*>(std::uintptr_t(0x101));
        value->commit_.actions=value->actions_;
        value->commit_.audio=reinterpret_cast<MeleeWebAudio*>(std::uintptr_t(0x102));
        value->commit_.audio_snapshot=reinterpret_cast<MeleeWebAudioSnapshot*>(std::uintptr_t(0x103));
        value->commit_.flow=reinterpret_cast<MeleeWebMatchFlow*>(std::uintptr_t(0x104));
        value->commit_.flow_snapshot=reinterpret_cast<MeleeWebMatchFlowCpuSnapshot*>(std::uintptr_t(0x105));
        value->commit_.bootstrap=reinterpret_cast<MeleeWebGameplayBootstrapSnapshot*>(std::uintptr_t(0x106));
        value->commit_.context=reinterpret_cast<MeleeWebMatchContext*>(std::uintptr_t(0x107));
        value->commit_.context_snapshot=reinterpret_cast<MeleeWebMatchContextSnapshot*>(std::uintptr_t(0x108));
        value->commit_.payload=reinterpret_cast<MeleeWebSourceMemoryPayloadSnapshot*>(std::uintptr_t(0x109));
        value->commit_.statics=value->statics_.get();
        return value;
    } catch(...) { return {}; }
}
bool GameplayCpuCheckpoint::begin_record(const GameplayMatchSession& session) noexcept {
    if(phase_!=Phase::Captured||session.source_frames()!=pre_frame_) return false;
    effect_token_=melee_web_cpu_interval_begin();
    commit_.effect_token=effect_token_;
    if(!effect_token_||melee_web_action_interval_begin_record(actions_)!=1) return false;
    phase_=Phase::Recording;source_step_possible_=true;return true;
}
bool GameplayCpuCheckpoint::interval_boundary(const GameplayMatchSession& session) noexcept {
    // Explicit model of typed owner/effect/action leaves; production method is
    // separately compiled and exercised by the actual capture-body control.
    return (phase_==Phase::Recording||phase_==Phase::Replaying)&&
        session.source_frames()>=pre_frame_&&session.source_frames()<=pre_frame_+static_cast<std::uint32_t>(span_)&&
        !fail_replay&&melee_web_cpu_interval_admit(effect_token_);
}
bool GameplayCpuCheckpoint::seal_post(const GameplayMatchSession& session) noexcept {
    if(phase_!=Phase::Recording||session.source_frames()!=pre_frame_+static_cast<std::uint32_t>(span_)||
       !melee_web_cpu_interval_admit(effect_token_)||
       melee_web_action_interval_seal_record(actions_)!=1||!statics_->seal_post()) return false;
    post_frame_=session.source_frames();post_=melee_web_cpu_restore_model_snapshot();
    post_action=post_.action;
    phase_=Phase::Sealed;return true;
}
GameplayCpuCommitResult GameplayCpuCheckpoint::restore(const GameplayMatchSession& session) noexcept {
    if(phase_!=Phase::Sealed||session.source_frames()!=post_frame_) return GameplayCpuCommitResult::MissingOwner;
    const auto result=gameplay_cpu_commit(commit_);
    if(result==GameplayCpuCommitResult::Ok) phase_=Phase::Replaying;
    else phase_=Phase::Failed;
    return result;
}
bool GameplayCpuCheckpoint::finish_replay(const GameplayMatchSession& session) noexcept {
    checked_domains_=matched_domains_=0;comparison_={};
    const bool modeled=phase_==Phase::Replaying&&session.source_frames()==post_frame_&&
        melee_web_cpu_interval_admit(effect_token_)&&melee_web_action_interval_finish_replay(actions_)==1&&
        melee_web_cpu_restore_model_equal(post_)&&!fail_replay;
    checked_domains_=0x1fe;
    if(modeled_payload_byte_failure){
        // Explicit payload leaf model; actual byte producer tested separately.
        comparison_={4,2,7,5,9,8,0x10000,64,0x80010000};checked_domains_=30;matched_domains_=14;
        payload_failure_witness_={};auto& w=payload_failure_witness_;
        class_piece_capture_witness_={1,sizeof(MeleeWebClassPieceCaptureWitness),0,4,1};class_piece_capture_witness_.live_reason=7; // modeled capture-time UNKNOWN
        class_piece_witness_={1,sizeof(MeleeWebClassPieceWitness)};class_piece_witness_.reason=4; // modeled leaf UNKNOWN
        allocation_origin_witness_={};auto& origin=allocation_origin_witness_;
        origin.schema=1;origin.bytes=320;origin.hook_active=1;
        origin.first_difference_matches=1;origin.reason=2; // modeled leaf UNKNOWN
        origin.row=7;origin.offset=5;origin.host=64;origin.generation=1;origin.epoch=1;origin.world=1;origin.requested=64;

        w.schema=1;w.bytes=256;w.original_status=2;w.first_difference_matches=1;
        w.window.schema=1;w.window.bytes=168;w.window.status=2;w.window.row=7;w.window.offset=5;
        w.window.requested_bytes=64;w.window.window_count=32;w.window.expected[5]=9;w.window.actual[5]=8;
        w.hook_active=1;w.attribution=0;w.reason=2;phase_=Phase::Failed;return false;
    }
    if(!modeled){comparison_={4,1,UINT32_MAX,UINT32_MAX,0,0,0,0,77};phase_=Phase::Failed;return false;}
    matched_domains_=checked_domains_;checked_domains_|=1u<<9;
    comparison_=statics_->compare_post();
    const bool okay=comparison_.status==0;
    if(okay)matched_domains_|=1u<<9;
    phase_=okay?Phase::Finished:Phase::Failed;return okay;
}
bool GameplayCpuCheckpoint::seal_drawn_reference(const GameplayMatchSession& session) noexcept {
    if(phase_!=Phase::Sealed||pending_submission||session.source_frames()!=post_frame_||
       !melee_web_cpu_interval_admit(effect_token_)||melee_web_action_interval_admit(actions_)!=1)return false;
    drawn_=melee_web_cpu_restore_model_snapshot();comparison_=statics_->capture_expected(drawn_statics_);return comparison_.status==0;
}
bool GameplayCpuCheckpoint::matches_drawn_reference(const GameplayMatchSession& session) noexcept {
    checked_domains_=matched_domains_=0;comparison_={};
    if(phase_!=Phase::Finished||session.source_frames()!=post_frame_||!melee_web_cpu_interval_admit(effect_token_)||
       !melee_web_cpu_restore_model_equal(drawn_))return false;
    checked_domains_=0x3fe;comparison_=statics_->compare_expected(drawn_statics_);
    if(comparison_.status)return false;
    matched_domains_=0x3fe;return true;
}
void GameplayCpuCheckpoint::disarm() noexcept {
    if(actions_) melee_web_action_interval_disarm(actions_);
    if(effect_token_){melee_web_cpu_interval_end(effect_token_);effect_token_=0;}
    melee_web_cpu_restore_mark_disarm();
}
bool GameplayCpuCheckpoint::source_owners_retired(const GameplayMatchSession* session) noexcept {
    if(session||world_exists) return false;
    disarm();phase_=Phase::Retired;retired_=true;source_step_possible_=false;return true;
}
}

