}
void verify_payload_failure_retention() {
    reset_fixture();check(configure_valid(),"Witness configure");
    check(!melee_web_synctest_cpu_restore_command(8)&&!melee_web_synctest_cpu_restore_command(9),"Witness baseline300");
    pending_submission=false;check(!melee_web_synctest_cpu_restore_command(10),"Witness baseline301");
    pending_submission=false;modeled_payload_byte_failure=true;
    check(melee_web_synctest_cpu_restore_command(11)==1216&&draw_calls==2,"Witness must preserve1216/no final present");
    check(melee_web_synctest_cpu_tobj_writer_evidence_bytes()==28048,"TObj separate fixed ABI");
    const auto tobj_saved=*static_cast<const MeleeWebTObjWriterEvidence*>(melee_web_synctest_cpu_tobj_writer_evidence());
    check(tobj_saved.schema==1&&tobj_saved.bytes==28048&&tobj_saved.status==2&&tobj_saved.reason==1&&!tobj_saved.hook_active,"Actual adapter retains modeled TObj UNKNOWN before1216");
    check(melee_web_synctest_cpu_lobj_writer_evidence_bytes()==16784,"Writer fixed ABI");
    const auto writer_saved=*static_cast<const MeleeWebLObjWriterEvidence*>(melee_web_synctest_cpu_lobj_writer_evidence());
    check(writer_saved.schema==1&&writer_saved.bytes==16784&&writer_saved.status==2&&writer_saved.reason==1&&!writer_saved.hook_active,"Actual adapter retains explicitly modeled unavailable writer leaf before strict failure");
    check(melee_web_synctest_cpu_class_piece_capture_witness_bytes()==160,"Capture-only fixed ABI");
    const auto historical_saved=*static_cast<const MeleeWebClassPieceCaptureWitness*>(melee_web_synctest_cpu_class_piece_capture_witness());
    check(historical_saved.schema==1&&historical_saved.bytes==160&&historical_saved.scope==1&&historical_saved.reason==4&&historical_saved.live_reason==7&&!historical_saved.status,"Actual adapter retains distinct modeled capture-time UNKNOWN");
    check(melee_web_synctest_cpu_class_piece_witness_bytes()==208,"Class piece fixed ABI");
    const auto piece_saved=*static_cast<const MeleeWebClassPieceWitness*>(melee_web_synctest_cpu_class_piece_witness());
    check(piece_saved.schema==1&&piece_saved.reason==4&&!piece_saved.status,"Actual adapter retains modeled class UNKNOWN");
    check(melee_web_synctest_cpu_payload_failure_witness_bytes()==256,"Witness fixed ABI");
    check(melee_web_synctest_cpu_allocation_origin_witness_bytes()==320,"Origin fixed ABI");
    const auto origin_saved=*static_cast<const MeleeWebSourceAllocationOriginWitness*>(melee_web_synctest_cpu_allocation_origin_witness());
    check(origin_saved.schema==1&&origin_saved.bytes==320&&origin_saved.reason==2&&origin_saved.first_difference_matches&&
          !origin_saved.status&&!origin_saved.site_kind,"Actual adapter keeps modeled origin UNKNOWN separately");
    const auto saved=*static_cast<const MeleeWebSourcePayloadFailureWitness*>(melee_web_synctest_cpu_payload_failure_witness());
    check(saved.schema==1&&saved.first_difference_matches==1&&saved.window.row==7&&saved.window.offset==5,
          "Actual adapter retained modeled leaf witness before refusal");
    EM_ASM({console.log("CPU_PAYLOAD_ACTUAL_WASM_WITNESS_BASE64="+
        Buffer.from(HEAPU8.subarray($0,$0+$1)).toString("base64"));},melee_web_synctest_cpu_payload_failure_witness(),256);
    EM_ASM({console.log("CPU_ORIGIN_ACTUAL_WASM_WITNESS_BASE64="+
        Buffer.from(HEAPU8.subarray($0,$0+320)).toString("base64"));},melee_web_synctest_cpu_allocation_origin_witness());
    check(melee_web_synctest_cpu_restore_command(5)==1216,"CLOSE preserves original1216");
    check(!std::memcmp(&saved,melee_web_synctest_cpu_payload_failure_witness(),256),"CLOSE preserves witness bytes");
    check(!std::memcmp(&tobj_saved,melee_web_synctest_cpu_tobj_writer_evidence(),28048),"CLOSE retains all28048 TObj bytes after capsule destruction");
    check(!std::memcmp(&writer_saved,melee_web_synctest_cpu_lobj_writer_evidence(),16784),"CLOSE retains all16784 writer bytes after capsule destruction");
    check(!std::memcmp(&historical_saved,melee_web_synctest_cpu_class_piece_capture_witness(),160),"CLOSE retains capture-only evidence");
    check(!std::memcmp(&piece_saved,melee_web_synctest_cpu_class_piece_witness(),208),"CLOSE retains separate class piece bytes");
    check(!std::memcmp(&origin_saved,melee_web_synctest_cpu_allocation_origin_witness(),320),"CLOSE preserves separate origin bytes");
    close_and_retire();
}
void verify_two_tick_refusals() {
    reset_fixture();check(configure_valid(),"Two refusal configure");
    check(melee_web_synctest_cpu_restore_command(8)==0&&melee_web_synctest_cpu_restore_command(9)==0,"Two refusal setup");
    const auto busy=melee_web_synctest_cpu_restore_command(10);
    check(busy!=0&&tick_calls==1&&draw_calls==1,"Busy baseline advanced second source tick");
    pending_submission=false;
    check(melee_web_synctest_cpu_restore_command(10)==busy&&tick_calls==1,"Busy failure was not latched");
    close_and_retire();
    reset_fixture();check(configure_valid(),"Two interval configure");
    check(melee_web_synctest_cpu_restore_command(8)==0&&melee_web_synctest_cpu_restore_command(9)==0,"Two interval setup");
    pending_submission=false;fail_replay=true;
    check(melee_web_synctest_cpu_restore_command(10)!=0&&tick_calls==1,"Latched interval failure stepped301");
    close_and_retire();
    reset_fixture();check(configure_valid(),"Two step-failure configure");
    check(melee_web_synctest_cpu_restore_command(8)==0,"Two step-failure capture");
    fail_baseline_sample300=true;
    const auto step_failure=melee_web_synctest_cpu_restore_command(9);
    const std::string step_message(error);
    const auto* step_evidence=static_cast<const CpuRestoreEvidence*>(melee_web_synctest_cpu_restore_evidence());
    check(step_failure==1204&&step_evidence->first_failure==1204&&
          tick_calls==0&&tick_sample_count==0&&draw_calls==0,
          "Baseline source-step refusal lost its specific code or reached draw");
    check(error[sizeof(error)-1]=='\0'&&
          step_message.find("baseline sample300 refused: fixture sample300 source sentinel")!=std::string::npos,
          "Baseline source-step refusal lost its cause or failed to terminate the bounded message");
    check(melee_web_synctest_cpu_restore_command(10)==step_failure&&
          std::string(error)==step_message&&draw_calls==0,
          "Next command overwrote the first baseline source-step refusal");
    check(melee_web_synctest_cpu_restore_command(5)==step_failure&&
          std::string(error)==step_message&&draw_calls==0,
          "CLOSE overwrote the first baseline source-step refusal or drew");
    check(melee_web_synctest_cpu_before_source_close()==1,
          "Source close was not admitted after disarm");
    match.reset();world_exists=false;
    check(melee_web_synctest_cpu_after_source_close()==1,
          "Source retirement refused the baseline source-step failure");
    for(bool unexpected_draw:{false,true}) {
        reset_fixture();check(configure_valid(),"Two replay interruption configure");
        check(melee_web_synctest_cpu_restore_command(8)==0&&melee_web_synctest_cpu_restore_command(9)==0,"Two replay interruption setup");
        pending_submission=false;check(melee_web_synctest_cpu_restore_command(10)==0,"Two replay interruption baseline301");
        pending_submission=false;
        if(unexpected_draw)unexpected_draw_tick=3;else journal_failure_tick=3;
        const auto refusal=melee_web_synctest_cpu_restore_command(11);
        check(refusal!=0&&tick_calls==3&&draw_calls==2,"First replay failure did not stop before sample301/present");
        check(melee_web_synctest_cpu_restore_command(12)==refusal&&draw_calls==2,"Failure permitted final draw");
        close_and_retire();
    }
    reset_fixture();check(configure_valid(),"Two mixed configure");
    check(melee_web_synctest_cpu_restore_command(8)==0,"Two mixed capture");
    check(melee_web_synctest_cpu_restore_command(2)!=0&&tick_calls==0,"Legacy command entered two route");
    close_and_retire();
}
