enum : uint32_t { PayloadUnsafeCallBoundary=2,PayloadOwnerUnavailable=3,
                  PayloadTransferBusy=4,PayloadFrameMismatch=7 };
extern "C" int melee_web_source_memory_healthy(void) { return world_exists ? 1 : 0; }
