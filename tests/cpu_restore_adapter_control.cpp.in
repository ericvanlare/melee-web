namespace {
void check(bool value,const char* message) { if(!value) throw std::runtime_error(message); }
std::uint32_t ptr32(const void* p) {
    const auto value=reinterpret_cast<std::uintptr_t>(p);
    check(value<=UINT32_MAX,"Fixture pointer is outside Wasm32 address space");
    return static_cast<std::uint32_t>(value);
}
void reset_fixture() {
    fail_capture=false;
    fail_static_replay=false;
    cpu_restore=CpuRestoreControl{};
    match=std::make_unique<melee_web::GameplayMatchSession>(176);
    source_state=FixtureSourceState{};source_static_counter=0;source_invariant=0x51a7u;
    std::memset(error,0,sizeof(error));observation={};observation.frame=176;
    observation.stocks[0]=observation.stocks[1]=4;observation.ending=0;
    rng_profile_observation={1,0x1234u,0,UINT32_MAX,0,176,0,0};transfer_diagnostic={};
    pcm.fill(0);input_bytes.fill(0);audio_phase=7;
    draw_calls=0;pending_submission=false;world_exists=true;fail_admission_leaf=0;fail_replay=false;
    idle_boundary_calls=submission_boundary_calls=0;capsule_disarms=capsule_destroys=0;
    action_disarms=action_destroys=0;tick_calls=0;tick_samples={};tick_sample_count=0;
    interruption=StepInterruption::None;interruption_done=false;
    commit_trace={};commit_trace_count=0;admission_trace={};admission_trace_count=0;
    pre_action=pre_audio=pre_flow=pre_bootstrap=pre_context=pre_payload=pre_rng=0;
    pre_pad={};pre_transfer={};post_action=0;payload_admission_state=PayloadAdmissionState::Idle;
}
bool configure_valid() {
    std::array<melee_web::CpuStaticRow,2> rows{{
        {ptr32(&source_static_counter),sizeof(source_static_counter),
         melee_web::CpuStaticPolicy::Restore,melee_web::CpuStaticDomain::OriginalSourceC},
        {ptr32(&source_invariant),sizeof(source_invariant),
         melee_web::CpuStaticPolicy::Invariant,melee_web::CpuStaticDomain::OriginalSourceC}}};
    std::sort(rows.begin(),rows.end(),[](const auto& a,const auto& b){return a.address<b.address;});
    return melee_web_synctest_cpu_restore_configure(ptr32(rows.data()),rows.size())==0;
}
void close_and_retire() {
    (void)melee_web_synctest_cpu_restore_command(5);
    check(capsule_destroys==0,"CLOSE released the capsule before source retirement");
    check(melee_web_synctest_cpu_before_source_close()==1,"Source close was not admitted after disarm");
    match.reset();world_exists=false;
    check(melee_web_synctest_cpu_after_source_close()==1,"Retired source owners did not release the capsule");
}
void verify_successful_interval() {
    reset_fixture();
    check(melee_web_synctest_cpu_restore_evidence_bytes()==11416,"Adapter evidence ABI byte size changed");
    auto* evidence=static_cast<const CpuRestoreEvidence*>(melee_web_synctest_cpu_restore_evidence());
    check(evidence&&evidence->schema==1&&evidence->bytes==11416,"Adapter evidence schema/size invalid");
    check(configure_valid(),"Valid source static configuration refused");
    check(melee_web_synctest_cpu_restore_command(1)==0,"CAPTURE failed");
    check(melee_web_synctest_cpu_restore_command(2)==0,"Baseline/restore/replay failed");
    evidence=static_cast<const CpuRestoreEvidence*>(melee_web_synctest_cpu_restore_evidence());
    check(evidence->pre_frame==176&&evidence->post_frame==177,"Source frame did not reset 176→177 around replay");
    check(tick_sample_count==2&&tick_samples[0]==300&&tick_samples[1]==300,
          "Original adapter did not repeat the fixed sample300 input");
    check(evidence->checked_domains==0x3fe&&evidence->matched_domains==0x3fe&&evidence->comparison.status==0,
          "Adapter did not preserve successful per-domain evidence");
    check(source_state.action==post_action&&source_static_counter==1&&evidence->equality==1,
          "Replay did not reproduce exact modeled source-owned post-state");
    const std::array<std::uint32_t,7> expected_admit{1,2,3,4,5,6,0};
    const std::array<std::uint32_t,7> expected_write{1,2,3,4,5,6,0};
    check(admission_trace_count==6&&std::equal(admission_trace.begin(),admission_trace.begin()+6,expected_admit.begin()),
          "Actual fixed commit admission leaf ordering changed");
    check(commit_trace_count==6&&std::equal(commit_trace.begin(),commit_trace.begin()+6,expected_write.begin()),
          "Actual fixed commit writer ordering changed");
    check(melee_web_synctest_cpu_restore_command(3)==0,"Single post-equality draw/present failed");
    check(draw_calls==1&&pending_submission,"Adapter did not present exactly one pending draw");
    check(idle_boundary_calls==0,"Adapter prematurely required idle submission at draw return");
    pending_submission=false;
    check(melee_web_synctest_cpu_restore_command(4)==0,"Later idle postdraw boundary failed");
    check(idle_boundary_calls==1,"Adapter omitted the required later idle boundary");
    close_and_retire();
    check(capsule_disarms>0&&capsule_destroys==1&&action_destroys==1,
          "Disarm/retire/destroy sequence did not retain then release the capsule");
}
void verify_capture_refusal_retains_typed_reason_through_close() {
    reset_fixture();check(configure_valid(),"Configuration failed");fail_capture=true;
    const auto result=melee_web_synctest_cpu_restore_command(1);
    check(result==0x434&&tick_sample_count==0&&draw_calls==0,"Capture refusal ran source work");
    const auto* e=static_cast<const CpuRestoreEvidence*>(melee_web_synctest_cpu_restore_evidence());
    check(e->comparison.domain==7&&e->comparison.status==1&&e->comparison.detail==5&&
          e->comparison.row==UINT32_MAX&&e->comparison.offset==UINT32_MAX&&e->commit_result==UINT32_MAX,
          "Structured capture refusal lost or invented byte evidence");
    const std::string message(error);check(message.find("fixture bootstrap capture refusal")!=std::string::npos,"Leaf reason lost");
    check(melee_web_synctest_cpu_restore_command(5)==result&&std::string(error)==message,
          "CLOSE lost first capture refusal");
    check(e->comparison.domain==7&&e->comparison.detail==5&&tick_sample_count==0&&draw_calls==0,
          "CLOSE cleared native capture refusal or ran source work");
    check(melee_web_synctest_cpu_before_source_close()==1,"Source close refused");
    match.reset();world_exists=false;check(melee_web_synctest_cpu_after_source_close()==1,"Source retirement refused");
}
void verify_admission_refusal_blocks_draw_and_retains_failure() {
    reset_fixture();
    check(configure_valid(),"Valid source static configuration refused");
    check(melee_web_synctest_cpu_restore_command(1)==0,"CAPTURE failed");
    fail_admission_leaf=2;
    const auto first=melee_web_synctest_cpu_restore_command(2);
    check(first!=0&&draw_calls==0,"Admission refusal reached draw");
    const std::string first_message(error);
    check(melee_web_synctest_cpu_restore_command(3)==first&&draw_calls==0&&
          std::string(error)==first_message,"First admission failure was not latched");
    check(commit_trace_count==0,"A component admission refusal wrote CPU owner state");
    close_and_retire();
}
void verify_replay_refusal_blocks_draw() {
    reset_fixture();
    check(configure_valid(),"Valid source static configuration refused");
    check(melee_web_synctest_cpu_restore_command(1)==0,"CAPTURE failed");
    fail_replay=true;
    const auto first=melee_web_synctest_cpu_restore_command(2);
    check(first!=0&&draw_calls==0,"Replay mismatch reached draw/present");
    check(melee_web_synctest_cpu_restore_command(3)==first&&draw_calls==0,
          "Replay failure did not block later draw/present");
    close_and_retire();
}
void verify_actual_static_byte_diff_is_retained() {
    reset_fixture();check(configure_valid(),"Configuration failed");
    check(melee_web_synctest_cpu_restore_command(1)==0,"CAPTURE failed");
    fail_static_replay=true;
    check(melee_web_synctest_cpu_restore_command(2)!=0&&draw_calls==0,"Actual static mismatch reached draw");
    const auto* e=static_cast<const CpuRestoreEvidence*>(melee_web_synctest_cpu_restore_evidence());
    check(e->comparison.domain==9&&e->comparison.status==2&&e->comparison.offset==0&&
          e->comparison.expected==1&&e->comparison.actual==2&&e->comparison.extent==4&&
          e->checked_domains==0x3fe&&e->matched_domains==0x1fe,
          "First actual static row/offset/bytes or masks missing from failure evidence");
    close_and_retire();
}
void verify_source_close_reentry_disarms_before_retirement() {
    reset_fixture();
    check(configure_valid(),"Valid source static configuration refused");
    check(melee_web_synctest_cpu_restore_command(1)==0,"CAPTURE failed");
    interruption=StepInterruption::ReenterSourceClose;
    const auto first=melee_web_synctest_cpu_restore_command(2);
    check(first!=0&&capsule_disarms>0&&capsule_destroys==0,
          "Reentrant source close did not fail and disarm while retaining capsule leases");
    const std::string first_message(error);
    check(melee_web_synctest_cpu_restore_command(3)==first&&std::string(error)==first_message&&draw_calls==0,
          "Source-close first failure was not retained or later draw was not blocked");
    check(melee_web_synctest_cpu_before_source_close()==1,"Retried source close after unwind was not admitted");
    check(capsule_destroys==0,"Source close hook released capsule before owner retirement");
    match.reset();world_exists=false;
    check(melee_web_synctest_cpu_after_source_close()==1&&capsule_destroys==1,
          "Capsule was not released after source owner retirement");
}
void verify_command_reentry() {
    reset_fixture();
    check(configure_valid(),"Valid source static configuration refused");
    check(melee_web_synctest_cpu_restore_command(1)==0,"CAPTURE failed");
    interruption=StepInterruption::ReenterCommand;
    const auto first=melee_web_synctest_cpu_restore_command(2);
    check(first!=0&&capsule_disarms>0&&capsule_destroys==0,
          "Reentrant command was accepted or released capsule too early");
    const std::string first_message(error);
    check(melee_web_synctest_cpu_restore_command(3)==first&&std::string(error)==first_message&&draw_calls==0,
          "Reentrant-command first failure was not retained");
    close_and_retire();
}
void verify_invalid_configuration_guards() {
    const auto check_bad=[&](std::uint32_t address,std::uint32_t count,const char* label) {
        reset_fixture();
        const auto result=melee_web_synctest_cpu_restore_configure(address,count);
        check(result!=0,label);
        auto* evidence=static_cast<const CpuRestoreEvidence*>(melee_web_synctest_cpu_restore_evidence());
        check(evidence&&evidence->first_failure==result&&evidence->state==CpuRestoreControl::Failed,
              "Invalid configuration did not publish a stable first failure");
    };
    check_bad(0,1,"Null config address was accepted");
    check_bad(1,1,"Misaligned config address was accepted");
    check_bad(static_cast<std::uint32_t>(emscripten_get_heap_size()-4),1,
              "Out-of-bounds config extent was accepted");
    check_bad(ptr32(&source_static_counter),UINT32_MAX,"Overflowing config row count was accepted");
    reset_fixture();
    std::array<melee_web::CpuStaticRow,1> forbidden{{
        {ptr32(&audio_phase),sizeof(audio_phase),melee_web::CpuStaticPolicy::Restore,
         melee_web::CpuStaticDomain::OriginalSourceC}}};
    check(melee_web_synctest_cpu_restore_configure(ptr32(forbidden.data()),1)!=0,
          "Forbidden live adapter range was accepted as a restore row");
}
}

extern "C" int melee_web_snapshot_step(unsigned sample) {
    if(!match||sample!=300||tick_sample_count>=tick_samples.size()) return 0;
    tick_samples[tick_sample_count++]=sample;++tick_calls;
    if(!interruption_done&&interruption==StepInterruption::ReenterCommand) {
        interruption_done=true;(void)melee_web_synctest_cpu_restore_command(5);
    } else if(!interruption_done&&interruption==StepInterruption::ReenterSourceClose) {
        interruption_done=true;(void)melee_web_synctest_cpu_before_source_close();
    }
    match->increment_source_frames();
    ++source_state.action;++source_state.audio;++source_state.flow;
    ++source_state.bootstrap;++source_state.context;++source_state.payload;++source_state.rng;
    for(std::size_t i=0;i<source_state.pad.size();++i) source_state.pad[i]=std::uint8_t(sample+i+source_state.payload);
    for(std::size_t i=0;i<source_state.transfer.size();++i) source_state.transfer[i]=int(source_state.payload+i);
    ++source_static_counter;
    if(fail_static_replay&&tick_calls==2)++source_static_counter;
    observation={};observation.frame=match->source_frames();observation.rng=source_state.rng;
    observation.stocks[0]=observation.stocks[1]=4;observation.motion[0]=14;observation.motion[1]=14;
    observation.pcm_frames=533;observation.audio_phase=audio_phase;
    observation.players[0].stocks=observation.players[1].stocks=4;
    observation.players[0].motion_id=observation.players[1].motion_id=14;
    std::copy(source_state.pad.begin(),source_state.pad.end(),observation.pad_history);
    input_bytes=source_state.pad;
    audio_phase+=32000;
    const unsigned frames=audio_phase/60;
    audio_phase%=60;
    observation.audio_phase=audio_phase;
    observation.pcm_frames=frames;
    for(std::size_t i=0;i<pcm.size();++i) pcm[i]=float((source_state.audio+i)%31)/31.0f;
    transfer_diagnostic={};transfer_diagnostic.sample=sample;
    transfer_diagnostic.before_tick_drive=source_state.transfer[0];
    transfer_diagnostic.before_tick_source=source_state.transfer[1];
    transfer_diagnostic.before_tick_bank=source_state.transfer[2];
    transfer_diagnostic.after_tick_drive=source_state.transfer[3];
    transfer_diagnostic.after_tick_source=source_state.transfer[4];
    transfer_diagnostic.after_tick_bank=source_state.transfer[5];
    transfer_diagnostic.after_audio_drive=source_state.transfer[6];
    transfer_diagnostic.after_audio_source=source_state.transfer[7];
    transfer_diagnostic.after_audio_bank=source_state.transfer[8];
    rng_profile_observation.callback_count++;
    rng_profile_observation.callback_frame=observation.frame;
    rng_profile_observation.callback_seed=source_state.rng;
    rng_profile_observation.source_global_frame=observation.frame;
    return 1;
}
extern "C" int melee_web_synctest_draw_present() {
    if(!match||draw_calls) return 0;
    ++draw_calls;pending_submission=true;return 1;
}

int main() {
    try {
        verify_successful_interval();
        verify_capture_refusal_retains_typed_reason_through_close();
        verify_admission_refusal_blocks_draw_and_retains_failure();
        verify_replay_refusal_blocks_draw();
        verify_actual_static_byte_diff_is_retained();
        verify_source_close_reentry_disarms_before_retirement();
        verify_command_reentry();
        verify_invalid_configuration_guards();
        std::puts("Actual CPU adapter control passed: frame-reset/replay, strict equality, ordered leaves, draw gating, busy→idle, first-failure and close lifetime.");
        return 0;
    } catch(const std::exception& failure) {
        std::fprintf(stderr,"CPU adapter control failure: %s\n",failure.what());
        return 1;
    }
}
