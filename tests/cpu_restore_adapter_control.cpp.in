@ACTUAL_PAYLOAD_SOURCE_BOUNDARY@
std::uint32_t payload_admission_boundary(bool require_idle) {
    if(const uint32_t failure=payload_admission_source_boundary())return failure;
    if(require_idle) { ++idle_boundary_calls; if(pending_submission) return 1; }
    return 0;
}
std::uint32_t payload_admission_runtime_boundary() { return 0; }
std::uint32_t payload_admission_submission_boundary() {
    ++submission_boundary_calls; return pending_submission&&draw_calls>=1?0u:1u;
}

extern "C" {
int melee_web_action_interval_admit(const MeleeWebActionInterval* value) {
    admission_trace[admission_trace_count++]=1; return value&&fail_admission_leaf!=1;
}
int melee_web_audio_snapshot_admit(MeleeWebAudio*,const MeleeWebAudioSnapshot*) {
    admission_trace[admission_trace_count++]=2; return fail_admission_leaf!=2;
}
int melee_web_match_flow_cpu_snapshot_admit(MeleeWebMatchFlow*,const MeleeWebMatchFlowCpuSnapshot*,char*,size_t) {
    admission_trace[admission_trace_count++]=3; return fail_admission_leaf!=3;
}
int melee_web_gameplay_bootstrap_snapshot_admit(const MeleeWebGameplayBootstrapSnapshot*,char*,size_t) {
    admission_trace[admission_trace_count++]=4; return fail_admission_leaf!=4;
}
int melee_web_match_context_snapshot_admit(MeleeWebMatchContext*,const MeleeWebMatchContextSnapshot*,char*,size_t) {
    admission_trace[admission_trace_count++]=5; return fail_admission_leaf!=5;
}
MeleeWebSourceMemoryPayloadSnapshotStatus melee_web_source_memory_payload_snapshot_admit(
    const MeleeWebSourceMemoryPayloadSnapshot*) {
    admission_trace[admission_trace_count++]=6;
    return fail_admission_leaf==6?MELEE_WEB_SOURCE_MEMORY_PAYLOAD_SNAPSHOT_TOPOLOGY_CHANGED:
        MELEE_WEB_SOURCE_MEMORY_PAYLOAD_SNAPSHOT_OK;
}
int melee_web_action_interval_restore(MeleeWebActionInterval*) {
    commit_trace[commit_trace_count++]=1; source_state.action=pre_action; return 1;
}
int melee_web_audio_snapshot_restore(MeleeWebAudio*,const MeleeWebAudioSnapshot*) {
    commit_trace[commit_trace_count++]=2; source_state.audio=pre_audio; return 1;
}
int melee_web_match_flow_cpu_snapshot_restore(MeleeWebMatchFlow*,const MeleeWebMatchFlowCpuSnapshot*,char*,size_t) {
    commit_trace[commit_trace_count++]=3; source_state.flow=pre_flow; return 1;
}
int melee_web_gameplay_bootstrap_snapshot_restore(const MeleeWebGameplayBootstrapSnapshot*,char*,size_t) {
    commit_trace[commit_trace_count++]=4; source_state.bootstrap=pre_bootstrap; return 1;
}
int melee_web_match_context_snapshot_restore(MeleeWebMatchContext*,const MeleeWebMatchContextSnapshot*,char*,size_t) {
    commit_trace[commit_trace_count++]=5; source_state.context=pre_context;
    if(match) match->set_source_frames(pre_source_frame); return 1;
}
MeleeWebSourceMemoryPayloadSnapshotStatus melee_web_source_memory_payload_snapshot_restore(
    const MeleeWebSourceMemoryPayloadSnapshot*) {
    commit_trace[commit_trace_count++]=6; source_state.payload=pre_payload;
    source_state.rng=pre_rng; source_state.pad=pre_pad; source_state.transfer=pre_transfer;
    return MELEE_WEB_SOURCE_MEMORY_PAYLOAD_SNAPSHOT_OK;
}
