 * Python runner, so the adapter evidence layout follows the checked-in fixture. */
@ACTUAL_FIXTURE_OBSERVATIONS@

namespace melee_web {
class GameplayMatchSession {
public:
    explicit GameplayMatchSession(std::uint32_t frame) : frame_(frame) {}
    std::uint32_t source_frames() const noexcept { return frame_; }
    void set_source_frames(std::uint32_t value) noexcept { frame_=value; }
    void increment_source_frames() noexcept { ++frame_; }
    struct CpuOwners {MeleeWebAudio* audio;};
    CpuOwners diagnostic_cpu_owners() const noexcept {return {reinterpret_cast<MeleeWebAudio*>(std::uintptr_t(0x102))};}
private:
    std::uint32_t frame_;
};
}

