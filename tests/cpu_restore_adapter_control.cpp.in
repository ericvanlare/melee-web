}
void melee_web_action_interval_disarm(MeleeWebActionInterval*) { ++action_disarms; }
void melee_web_action_interval_destroy(MeleeWebActionInterval*) { ++action_destroys; }
}

namespace {
void check(bool value,const char* message) { if(!value) throw std::runtime_error(message); }
std::uint32_t ptr32(const void* p) {
    const auto value=reinterpret_cast<std::uintptr_t>(p);
    check(value<=UINT32_MAX,"Fixture pointer is outside Wasm32 address space");
    return static_cast<std::uint32_t>(value);
}
void reset_fixture() {
    fail_capture=false;
    renderer_ready=true;renderer_error_count=0;
    fixture_draw_diagnostics={};
    fail_static_replay=false;fail_baseline_sample300=false;journal_failure_tick=unexpected_draw_tick=0;
    step_attempts=fail_step_attempt=draw_attempts=fail_draw_attempt=0;
    fail_draw_without_diagnostic=false;
    // Fixture-only in-place reset: avoid a >64KiB automatic aggregate.
    cpu_restore.~CpuRestoreControl();
    ::new (static_cast<void*>(&cpu_restore)) CpuRestoreControl{};
    match=std::make_unique<melee_web::GameplayMatchSession>(176);
    source_state=FixtureSourceState{};source_static_counter=0;source_invariant=0x51a7u;
    std::memset(error,0,sizeof(error));observation={};observation.frame=176;
    observation.stocks[0]=observation.stocks[1]=4;observation.ready=1;observation.ending=0;
    rng_profile_observation={1,0x1234u,0,UINT32_MAX,0,176,0,0};transfer_diagnostic={};
    pcm.fill(0);input_bytes.fill(0);audio_phase=7;
    draw_calls=0;pending_submission=false;world_exists=true;fail_admission_leaf=0;fail_replay=false;modeled_payload_byte_failure=false;
    tobj_boundary_calls=0;tobj_boundary_index=tobj_boundary_frame=0;
    idle_boundary_calls=submission_boundary_calls=0;capsule_disarms=capsule_destroys=0;
    action_disarms=action_destroys=0;tick_calls=0;tick_samples={};tick_sample_count=0;
    interruption=StepInterruption::None;interruption_done=false;
    commit_trace={};commit_trace_count=0;admission_trace={};admission_trace_count=0;
    pre_action=pre_audio=pre_flow=pre_bootstrap=pre_context=pre_payload=pre_rng=0;
    pre_pad={};pre_transfer={};post_action=0;payload_admission_state=PayloadAdmissionState::Idle;
    class_piece_trace_context_count=slist_trace_context_count=0;
    class_piece_trace_contexts={};slist_trace_contexts={};
    trace_context_overflow=trace_context_invalid=false;
}
bool configure_valid() {
    std::array<melee_web::CpuStaticRow,2> rows{{
        {ptr32(&source_static_counter),sizeof(source_static_counter),
         melee_web::CpuStaticPolicy::Restore,melee_web::CpuStaticDomain::OriginalSourceC},
        {ptr32(&source_invariant),sizeof(source_invariant),
         melee_web::CpuStaticPolicy::Invariant,melee_web::CpuStaticDomain::OriginalSourceC}}};
    std::sort(rows.begin(),rows.end(),[](const auto& a,const auto& b){return a.address<b.address;});
    return melee_web_synctest_cpu_restore_configure(ptr32(rows.data()),rows.size())==0;
}
void close_and_retire() {
    (void)melee_web_synctest_cpu_restore_command(5);
    check(capsule_destroys==0,"CLOSE released the capsule before source retirement");
    check(melee_web_synctest_cpu_before_source_close()==1,"Source close was not admitted after disarm");
    match.reset();world_exists=false;
    check(melee_web_synctest_cpu_after_source_close()==1,"Retired source owners did not release the capsule");
}
void assert_source_call_failure_latched(std::uint32_t code,const std::string& message,
                                        std::uint32_t next_command,
                                        unsigned expected_ticks,unsigned expected_draws) {
    const auto* evidence=static_cast<const CpuRestoreEvidence*>(
        melee_web_synctest_cpu_restore_evidence());
    check(evidence&&evidence->first_failure==code&&cpu_restore.state==CpuRestoreControl::Failed,
          "Checked source refusal did not preserve its code/state");
    if(cpu_restore.two_active)
        check(cpu_restore.two.first_failure==code&&cpu_restore.two.state==CpuRestoreControl::Failed,
              "Two-tick checked source refusal did not preserve its code/state");
    check(melee_web_synctest_cpu_restore_command(next_command)==code&&
          std::string(error)==message&&tick_calls==expected_ticks&&draw_calls==expected_draws,
          "Next command overwrote the checked source cause or advanced source/draw work");
    check(melee_web_synctest_cpu_restore_command(5)==code&&std::string(error)==message&&
          tick_calls==expected_ticks&&draw_calls==expected_draws,
          "CLOSE overwrote the checked source cause or advanced source/draw work");
    check(melee_web_synctest_cpu_before_source_close()==1,
          "Source close was not admitted after checked source refusal");
    match.reset();world_exists=false;
    check(melee_web_synctest_cpu_after_source_close()==1,
          "Source retirement refused checked source failure");
}
void setup_two_capture_for_failure() {
    reset_fixture();check(configure_valid(),"Two source-failure configure refused");
    check(melee_web_synctest_cpu_restore_command(8)==0,"Two source-failure capture refused");
}
void setup_two_baseline300_for_failure() {
    setup_two_capture_for_failure();
    check(melee_web_synctest_cpu_restore_command(9)==0,"Two source-failure baseline300 refused");
    pending_submission=false;
}
void setup_two_baseline301_for_failure() {
    setup_two_baseline300_for_failure();
    check(melee_web_synctest_cpu_restore_command(10)==0,"Two source-failure baseline301 refused");
    pending_submission=false;
}
void setup_two_equal_for_failure() {
    setup_two_baseline301_for_failure();
    check(melee_web_synctest_cpu_restore_command(11)==0,"Two source-failure replay refused");
}
void mark_stale_source_error() {
    std::snprintf(error,sizeof(error),"stale error from an earlier boundary");
}
void assert_source_call_report(std::uint32_t code,const char* boundary,const char* cause,
                               std::uint32_t next_command,unsigned expected_ticks,
                               unsigned expected_draws) {
    const std::string message(error);
    check(message.find(boundary)!=std::string::npos&&message.find(cause)!=std::string::npos&&
          message.find("stale error")==std::string::npos,
          "Checked source refusal lost its current cause or used stale error text");
    assert_source_call_failure_latched(code,message,next_command,expected_ticks,expected_draws);
}
void verify_successful_interval() {
    reset_fixture();
    check(melee_web_synctest_cpu_restore_evidence_bytes()==11416,"Adapter evidence ABI byte size changed");
    auto* evidence=static_cast<const CpuRestoreEvidence*>(melee_web_synctest_cpu_restore_evidence());
    check(evidence&&evidence->schema==1&&evidence->bytes==11416,"Adapter evidence schema/size invalid");
    check(configure_valid(),"Valid source static configuration refused");
    check(melee_web_synctest_cpu_restore_command(1)==0,"CAPTURE failed");
    check(melee_web_synctest_cpu_restore_command(2)==0,"Baseline/restore/replay failed");
    evidence=static_cast<const CpuRestoreEvidence*>(melee_web_synctest_cpu_restore_evidence());
    check(evidence->pre_frame==176&&evidence->post_frame==177,"Source frame did not reset 176→177 around replay");
    check(tick_sample_count==2&&tick_samples[0]==300&&tick_samples[1]==300,
          "Original adapter did not repeat the fixed sample300 input");
    check(evidence->checked_domains==0x3fe&&evidence->matched_domains==0x3fe&&evidence->comparison.status==0,
          "Adapter did not preserve successful per-domain evidence");
    check(source_state.action==post_action&&source_static_counter==1&&evidence->equality==1,
          "Replay did not reproduce exact modeled source-owned post-state");
    const std::array<std::uint32_t,7> expected_admit{1,2,3,4,5,6,0};
    const std::array<std::uint32_t,7> expected_write{1,2,3,4,5,6,0};
    check(admission_trace_count==6&&std::equal(admission_trace.begin(),admission_trace.begin()+6,expected_admit.begin()),
          "Actual fixed commit admission leaf ordering changed");
    check(commit_trace_count==6&&std::equal(commit_trace.begin(),commit_trace.begin()+6,expected_write.begin()),
          "Actual fixed commit writer ordering changed");
    check(melee_web_synctest_cpu_restore_command(3)==0,"Single post-equality draw/present failed");
    check(draw_calls==1&&pending_submission,"Adapter did not present exactly one pending draw");
    check(idle_boundary_calls==0,"Adapter prematurely required idle submission at draw return");
    pending_submission=false;
    check(melee_web_synctest_cpu_restore_command(4)==0,"Later idle postdraw boundary failed");
    check(idle_boundary_calls==1,"Adapter omitted the required later idle boundary");
    close_and_retire();
    check(capsule_disarms>0&&capsule_destroys==1&&action_destroys==1,
          "Disarm/retire/destroy sequence did not retain then release the capsule");
    const std::array<std::uint32_t,4> expected_context_commands{1,2,3,4};
    check(class_piece_trace_context_count==expected_context_commands.size()&&
          !trace_context_overflow&&!trace_context_invalid,
          "Modeled class-piece trace context was missing, invalid, or overflowed");
    for(std::size_t i=0;i<expected_context_commands.size();++i){
        const auto& context=class_piece_trace_contexts[i];
        check(context.command==expected_context_commands[i]&&context.scope==0&&
              context.frame==0&&context.sample==0,
              "Adapter did not forward the current command boundary to class-piece diagnostics");
    }
#if defined(MELEE_WEB_SLIPPI_TOBJ_PRESENTATION_CACHE) && MELEE_WEB_SLIPPI_TOBJ_PRESENTATION_CACHE
    check(class_piece_trace_context_count==slist_trace_context_count&&
          std::memcmp(class_piece_trace_contexts.data(),slist_trace_contexts.data(),
                      class_piece_trace_context_count*sizeof(FixtureTraceContext))==0,
          "Enabled SList trace context did not follow the same command boundary");
#else
    check(slist_trace_context_count==0,
          "Default fixture unexpectedly enabled the private SList trace");
#endif
}
void verify_drawn_reference_interval() {
    reset_fixture();check(configure_valid(),"Drawn configure failed");
    check(melee_web_synctest_cpu_restore_command(1)==0,"Drawn capture failed");
    check(melee_web_synctest_cpu_restore_command(6)==0,"Drawn CPU/baseline submit failed");
    check(draw_calls==1&&pending_submission&&tick_sample_count==1&&commit_trace_count==0,
          "Baseline did not draw before any restore/replay");
    pending_submission=false;
    check(melee_web_synctest_cpu_restore_command(7)==0,"Drawn quiescent restore/replay failed");
    check(draw_calls==1&&tick_sample_count==2&&cpu_restore.evidence.equality==1&&cpu_restore.drawn.stage==3,
          "Correction unexpectedly drew or equality missing");
    check(melee_web_synctest_cpu_restore_command(3)==0&&draw_calls==2,"Final present missing");
    pending_submission=false;check(melee_web_synctest_cpu_restore_command(4)==0,"Postdraw owner equality failed");
    check(cpu_restore.drawn.pair.equality==1&&cpu_restore.drawn.pair.checked_domains==0x3fe&&
          cpu_restore.drawn.pair.matched_domains==0x3fe&&cpu_restore.drawn.draw_mask==7,
          "Independent drawn raw/typed evidence missing");
    check(cpu_restore.evidence.bytes==11416&&melee_web_synctest_cpu_drawn_evidence_bytes()==11832,
          "Legacy/new evidence ABI drift");close_and_retire();
}
void verify_two_tick_interval() {
    reset_fixture();check(configure_valid(),"Two configure refused");
    check(melee_web_synctest_cpu_two_tick_evidence_bytes()==35368,"Two ABI size drift");
    check(melee_web_synctest_cpu_restore_command(8)==0,"Two capture refused");
    check(melee_web_synctest_cpu_restore_command(9)==0&&draw_calls==1&&tick_calls==1,"First baseline order");
    pending_submission=false;
    check(melee_web_synctest_cpu_restore_command(10)==0&&draw_calls==2&&tick_calls==2,"Second baseline order");
    pending_submission=false;
    check(melee_web_synctest_cpu_restore_command(11)==0&&tick_calls==4&&draw_calls==2,"Two replay refused or drew");
    check(tick_sample_count==4&&tick_samples[0]==300&&tick_samples[1]==301&&
          tick_samples[2]==300&&tick_samples[3]==301,"Two literal sample order");
    const auto& e=cpu_restore.two;
    check(e.cpu_equality==1&&e.checked_cpu==0x3fe&&e.matched_cpu==0x3fe&&
          e.tick_pairs[0].equality==1&&e.tick_pairs[0].checked_domains==0&&e.tick_pairs[1].equality==1,
          "Two raw/typed CPU evidence missing");
    check(melee_web_synctest_cpu_restore_command(12)==0&&draw_calls==3,"Two final draw refused");
    pending_submission=false;check(melee_web_synctest_cpu_restore_command(13)==0,"Two final completion refused");
    check(e.diagnostic_mask==255&&e.drawn_equality==1&&e.checked_drawn==0x3fe&&e.matched_drawn==0x3fe&&
          e.diagnostics[0]==e.diagnostics[1]&&e.diagnostics[2]==e.diagnostics[3]&&
          e.diagnostics[4]==e.diagnostics[5]&&e.diagnostics[4]==e.diagnostics[6],"Two diagnostic boundaries");
    check(e.drawn_pair.pre_frame==e.post_frame&&e.drawn_pair.post_frame==e.post_frame,
          "New two-tick drawn pair must label the same source endpoint");
    // Actual Wasm ABI bytes, not a handwritten JS success buffer. Source-world
    // leaves are still the explicit fixture models described at file start.
    EM_ASM({console.log("CPU_TWO_ACTUAL_WASM_EVIDENCE_BASE64="+
        Buffer.from(HEAPU8.subarray($0,$0+$1)).toString("base64"));},&cpu_restore.two,sizeof(cpu_restore.two));
    close_and_retire();
}
void verify_seven_tick_phase_boundary() {
    reset_fixture();check(configure_valid(),"Seven configure refused");
    check(melee_web_synctest_cpu_seven_tick_evidence_bytes()==93512,"Seven ABI size drift");
    check(melee_web_synctest_cpu_restore_command(14)==0&&
          cpu_restore.state==CpuRestoreControl::CapturedSeven,"Seven capture refused");
    const Observation captured_observation=observation;
    for(unsigned index=0;index<7;++index) {
        check(melee_web_synctest_cpu_restore_command(15u+index)==0&&
              tick_calls==index+1u&&draw_calls==index+1u&&pending_submission,
              "Seven authoritative tick/draw order changed");
        pending_submission=false;
    }
    // Command 22 runs after command 21 sealed the capsule. It must use the
    // sealed drawn-reference admission, not a recording/replay interval check.
    check(melee_web_synctest_cpu_restore_command(22)==0&&
          cpu_restore.state==CpuRestoreControl::ReplayingSeven&&
          cpu_restore.seven.commit_result==0&&match->source_frames()==176&&
          observation.frame==176&&
          std::memcmp(&observation,&captured_observation,sizeof(observation))==0,
          "Seven sealed command22, exact captured observer or checked restore cursor refused");
    for(unsigned index=0;index<7;++index) {
        check(melee_web_synctest_cpu_restore_command(23u+index)==0&&
              tick_calls==8u+index&&match->source_frames()==177u+index&&
              observation.frame==177u+index&&draw_calls==7,
              "Seven corrected no-draw step or post-step observation refused");
    }
    auto& evidence=cpu_restore.seven;
    check(cpu_restore.state==CpuRestoreControl::SevenEqual&&evidence.cpu_equality==1&&
          evidence.checked_cpu==0x3fe&&evidence.matched_cpu==0x3fe&&
          evidence.replay_step_no_draw_mask==0x7fu,
          "Seven per-tick/typed replay equality missing");
    check(melee_web_synctest_cpu_restore_command(30)==0&&draw_calls==8&&pending_submission,
          "Seven final present refused");
    pending_submission=false;
    check(melee_web_synctest_cpu_restore_command(31)==0&&
          cpu_restore.state==CpuRestoreControl::Complete&&evidence.drawn_equality==1&&
          evidence.diagnostic_mask==0xffffu,
          "Seven endpoint completion/draw diagnostics refused");
    check(tick_sample_count==14,"Seven raw source sample count drift");
    for(unsigned index=0;index<14;++index)
        check(tick_samples[index]==300u+(index%7u),"Seven raw source sample order drift");
    close_and_retire();
}
void verify_seven_stale_observer_refusal() {
    reset_fixture();check(configure_valid(),"Seven stale configure");
    check(melee_web_synctest_cpu_restore_command(14)==0,"Seven stale capture");
    for(unsigned i=0;i<7;++i){check(melee_web_synctest_cpu_restore_command(15+i)==0,"Seven stale baseline");pending_submission=false;}
    check(melee_web_synctest_cpu_restore_command(22)==0,"Seven stale restore");
    observation.frame=183; // reproduce the real failed command23 dependency
    check(payload_admission_source_boundary()==PayloadFrameMismatch,"Actual source boundary accepted stale observer");
    check(melee_web_synctest_cpu_restore_command(23)==0x417u&&tick_calls==7&&draw_calls==7,
          "Stale observer reached a replay source step or lost exact frame refusal");
