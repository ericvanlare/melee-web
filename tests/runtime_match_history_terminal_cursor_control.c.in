static MeleeWebRuntimeMatchHistoryTerminalOwner make_owner(
    const void *capsule, const void *checkpoint)
{
    static int storage, context, flow, audio, ticks;
    return (MeleeWebRuntimeMatchHistoryTerminalOwner){
        capsule, checkpoint, &storage, &context, &flow, &audio, &ticks,
        9, 12, sizeof(uint64_t)
    };
}

static void reset_gm(int p1, int p2, int source_frame)
{
    memset(&lbl_8046B6A0, 0, sizeof(lbl_8046B6A0));
    memset(stocks, 0, sizeof(stocks));
    stocks[0] = p1; stocks[1] = p2;
    lbl_8046B6A0.x24C8.match_kind = 1;
    lbl_8046B6A0.frame_count = source_frame;
    lbl_8046B6A0.hud_enabled = 1;
    lbl_8046B6A0.unk_0 = 0;
}

/* This is a component control. The scheduler counter is an explicit modeled
 * boundary around the actual original source call, not browser evidence. */
static int traversed_gm_tick(
    MeleeWebRuntimeMatchHistoryTerminalCursor *cursor,
    MeleeWebRuntimeMatchHistoryTerminalOwner *owner,
    uint64_t *ticks)
{
    const uint64_t before_tick = *ticks;
    const uint32_t before_frame = (uint32_t)lbl_8046B6A0.frame_count;
    const uint32_t ending_before = lbl_8046B6A0.unk_0 != 0;
    const uint32_t complete_before = lbl_8046B6A0.unk_0 >= 3;
    if (!melee_web_runtime_match_history_terminal_before(
            cursor, owner, before_tick, before_frame,
            ending_before, complete_before))
        return 0;
    gm_Scene_Vs_OnFrame();
    ++source_calls;
    ++*ticks;
    const uint32_t after_frame = (uint32_t)lbl_8046B6A0.frame_count;
    const uint32_t ending_after = lbl_8046B6A0.unk_0 != 0;
    const uint32_t complete_after = lbl_8046B6A0.unk_0 >= 3;
    return melee_web_runtime_match_history_terminal_observe(
        cursor, owner, before_tick, *ticks, before_frame, after_frame,
        ending_before, ending_after, complete_before, complete_after);
}

int main(void)
{
    int capsule_a, checkpoint_a, capsule_b, checkpoint_b;
    uint64_t ticks = 500;
    const uint32_t pre_frame = 41;
    MeleeWebRuntimeMatchHistoryTerminalOwner owner =
        make_owner(&capsule_a, &checkpoint_a);
    MeleeWebRuntimeMatchHistoryTerminalCursor cursor = {0};

    reset_gm(0, 1, (int)pre_frame);
    if (!melee_web_runtime_match_history_terminal_bind(
            &cursor, &owner, ticks, pre_frame, pre_frame)) return 10;
    if (!traversed_gm_tick(&cursor, &owner, &ticks)) return 11;
    if (lbl_8046B6A0.unk_0 != 1 || lbl_8046B6A0.match_result != OUTCOME_ELIMINATION)
        return 12;
    if (lbl_8046B6A0.frame_count != (int)pre_frame ||
        cursor.completed_tick != 501 || cursor.input_ordinal != pre_frame + 1 ||
        cursor.source_frame != pre_frame || !cursor.first_terminal_valid ||
        cursor.first_terminal_source_frame_before != pre_frame ||
        cursor.first_terminal_source_frame_after != pre_frame ||
        cursor.first_terminal_ending_before != 0 ||
        cursor.first_terminal_ending_after != 1 ||
        cursor.first_terminal_complete_after != 0)
        return 13;

    /* Existing checkpoint restore is modeled by returning the exact measured
     * tick/frame and original state to PRE; terminal evidence is retained. */
    ticks = 500;
    reset_gm(1, 1, (int)pre_frame);
    if (!melee_web_runtime_match_history_terminal_rewind_pre(
            &cursor, &owner, ticks, pre_frame, 0, 0) ||
        !cursor.first_terminal_valid || cursor.input_ordinal != pre_frame)
        return 14;
    if (!traversed_gm_tick(&cursor, &owner, &ticks)) return 15;
    if (lbl_8046B6A0.unk_0 != 0 ||
        cursor.input_ordinal != pre_frame + 1 ||
        cursor.source_frame != pre_frame + 1 || cursor.ending || cursor.complete ||
        !cursor.first_terminal_valid)
        return 16;

    /* A wrong owner or stale measured tick is refused before the original
     * source routine can be invoked. */
    MeleeWebRuntimeMatchHistoryTerminalOwner wrong =
        make_owner(&capsule_b, &checkpoint_b);
    if (melee_web_runtime_match_history_terminal_before(
            &cursor, &wrong, ticks, cursor.source_frame, 0, 0) || source_calls != 2)
        return 17;
    if (melee_web_runtime_match_history_terminal_before(
            &cursor, &owner, ticks + 1, cursor.source_frame, 0, 0) || source_calls != 2)
        return 18;

    /* Seven completed input traversals are representable; a further source
     * call is not admitted by the existing seven-row capsule. */
    MeleeWebRuntimeMatchHistoryTerminalCursor cap_cursor = {0};
    uint64_t cap_ticks = 1000;
    const uint32_t cap_frame = 20;
    reset_gm(1, 1, (int)cap_frame);
    MeleeWebRuntimeMatchHistoryTerminalOwner cap_owner =
        make_owner(&capsule_b, &checkpoint_b);
    if (!melee_web_runtime_match_history_terminal_bind(
            &cap_cursor, &cap_owner, cap_ticks, cap_frame, cap_frame)) return 19;
    for (int i = 0; i < MELEE_WEB_RUNTIME_MATCH_HISTORY_TERMINAL_MAX_SPAN; ++i) {
        if (!traversed_gm_tick(&cap_cursor, &cap_owner, &cap_ticks)) return 20;
    }
    const int calls_at_cap = source_calls;
    if (traversed_gm_tick(&cap_cursor, &cap_owner, &cap_ticks) ||
        source_calls != calls_at_cap)
        return 21;

    MeleeWebRuntimeMatchHistoryTerminalCursor overflow = {0};
    if (melee_web_runtime_match_history_terminal_bind(
            &overflow, &owner, ticks, UINT32_MAX, UINT32_MAX))
        return 22;

    puts("terminal cursor: original stock-out traversal, corrected-live branch, owner/tick preflight, and seven-row bound passed (component control)");
    return 0;
}
