 MeleeWebMenuMatchSelection selection;
 GameplayMatchSession(int,MeleeWebMenuMatchSelection selected,RuntimeArchiveCache&,
                      melee_web::GameplayMatchConstruction):selection(selected){++default_pad_constructors;}
 unsigned source_frames() const {return gameplay_frame;}
