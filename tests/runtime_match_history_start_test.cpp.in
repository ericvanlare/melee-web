};
uint32_t source_tick=0,gameplay_frame=0;
bool hud_ready=false;
uint32_t gm_801A4BA8(){return source_tick;}
MeleeWebAudio fixture_audio;
bool source_files_idle=true,source_memory_healthy=true,bank_pending=false,stream_pending=false;
bool bank_active=false,stream_owned=true,stream_pump_ok=true,stream_completes=true;
std::string transfer_order;
