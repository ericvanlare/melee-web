class GameplayWorld{public:
 void ensure_source_files_quiescent(){++source_quiescence_calls;retirement_step(4);
  if(!source_quiescent||!runtime_files_owner_live)throw std::runtime_error("fixture exact RuntimeFiles busy or retired");}
};
struct SessionStorage{std::unique_ptr<GameplayWorld> world=std::make_unique<GameplayWorld>();};
class GameplayMatchSession{public:
 GameplayMatchSession():storage_(std::make_unique<SessionStorage>()){}
 std::uint32_t source_frames()const{retirement_step(2);return live_frame;}
 bool construction_complete()const{return session_complete;}
 GameplayMatchCpuOwners diagnostic_cpu_owners() const noexcept{
  retirement_step(retirement_order_count==0?1:3);
  if(owner_missing||!storage_||!storage_->world||!session_match||!session_flow||
     !session_bank||!construction_complete())return {};
  return {storage_.get(),reinterpret_cast<MeleeWebMatchContext*>(1),
          reinterpret_cast<MeleeWebMatchFlow*>(1),reinterpret_cast<MeleeWebAudio*>(1),
          1,1,frame_wrap?UINT32_MAX:live_frame};}
 bool diagnostic_source_files_quiescent()const noexcept;
 void fixture_remove_storage(){storage_.reset();}
 void fixture_remove_world(){if(storage_)storage_->world.reset();}
private:
 std::unique_ptr<SessionStorage> storage_;
};
