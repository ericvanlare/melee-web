 assert_retirement_order({1,2,3,4,5,6});assert(retire_admit_calls==0&&retire_confirm_calls==0);
 normal_fallback_cleanup(light_refusal);unchanged();

#if defined(MELEE_WEB_SLIPPI_TOBJ_PRESENTATION_CACHE) && MELEE_WEB_SLIPPI_TOBJ_PRESENTATION_CACHE
