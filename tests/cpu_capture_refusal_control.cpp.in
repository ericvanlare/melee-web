void retirement_step(unsigned value){
 if(!retirement_trace)return;
 assert(retirement_order_count<retirement_order.size());
 retirement_order[retirement_order_count++]=value;
}
void reset_retirement_trace(){retirement_order.fill(0);retirement_order_count=0;retirement_trace=true;}
}
