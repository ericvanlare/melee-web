    MELEE_WEB_SLIST_TRACE_CAPTURE=1,
    MELEE_WEB_SLIST_TRACE_BASELINE_SEAL=2,
};
/* Diagnostic hooks are explicit fixture leaves: they record the production
 * calls but do not model allocator ownership or affect capture decisions. */
static unsigned slist_trace_arm_calls=0,slist_capture_samples=0;
static unsigned slist_trace_early_closes=0,class_piece_trace_early_closes=0;
extern "C" int melee_web_source_memory_slist_target_trace_arm(
    const MeleeWebSourceMemoryPayloadSnapshot*,MeleeWebClassPieceAnchor,
    std::uint32_t source,std::uint32_t extent,std::uint32_t offset) {
    ++slist_trace_arm_calls;
    return source==0x80d349c0u&&extent==8u&&offset==0u;
}
extern "C" void melee_web_lobj_slist_trace_sample(std::uint32_t boundary) {
    if(boundary==1u)++slist_capture_samples;
}
extern "C" void melee_web_source_memory_slist_trace_early_close() {
    ++slist_trace_early_closes;
}
extern "C" void melee_web_source_memory_class_piece_slab_trace_early_close() {
    ++class_piece_trace_early_closes;
#if defined(MELEE_WEB_SLIPPI_TOBJ_PRESENTATION_CACHE) && MELEE_WEB_SLIPPI_TOBJ_PRESENTATION_CACHE
    melee_web_source_memory_slist_trace_early_close();
#endif
}
namespace {
unsigned refuse_leaf=0,throw_leaf=0,created=0,destroyed=0,static_destroys=0;
bool capsule_alloc_failure=false,owner_missing=false,frame_wrap=false;
std::uint32_t live_frame=176;
bool effect_ok=true,action_ok=true,payload_ok=true,flow_ok=true,bytes_ok=true;
std::array<unsigned,16> trace{};unsigned count=0;
std::array<unsigned char,64> source_bytes{};
unsigned commit_calls=0,profile_reset_calls=0;
melee_web::GameplayCpuCommitResult modeled_commit_result=melee_web::GameplayCpuCommitResult::Ok;
bool profile_reset_ok=true;
SlippiLObjAnchor last_profile_reset_anchor{};
void visit(unsigned leaf){trace[count++]=leaf;if(throw_leaf==leaf)throw std::bad_alloc();}
Snapshot* snapshot(unsigned leaf){visit(leaf);if(refuse_leaf==leaf)return nullptr;++created;return new Snapshot{leaf};}
void destroy(Snapshot* p){if(p){++destroyed;delete p;}}
void leaf_error(char* p,std::size_t n,unsigned leaf){if(refuse_leaf==leaf)std::snprintf(p,n,"actual fixture leaf%u refused",leaf);}
}
extern "C" int fixture_profile_reset_after_restore(SlippiLObjAnchor anchor) {
    ++profile_reset_calls;
    last_profile_reset_anchor=anchor;
    return profile_reset_ok;
}
