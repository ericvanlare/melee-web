int main(){
 using namespace melee_web;
 const std::array<unsigned,8> order{1,2,3,4,5,6,7,8};
 const std::array<unsigned,8> domains{7,5,6,8,4,3,9,8};
 GameplayMatchSession session;
#if !(defined(MELEE_WEB_SLIPPI_TOBJ_PRESENTATION_CACHE) && MELEE_WEB_SLIPPI_TOBJ_PRESENTATION_CACHE)
 const auto disabled_tobj=slippi_tobj_anchor_capture();assert(disabled_tobj.token==0&&slippi_tobj_anchor_admit(disabled_tobj)==1&&slippi_tobj_failure()==0);slippi_tobj_anchor_disarm(disabled_tobj);
#endif
 auto reset=[](){assert(live_capsules==0&&live_action_intervals==0);live_frame=176;effect_ok=action_ok=payload_ok=flow_ok=bytes_ok=true;refuse_leaf=throw_leaf=created=destroyed=static_destroys=count=0;live_action_intervals=max_live_action_intervals=0;live_capsules=max_live_capsules=0;trace={};capsule_alloc_failure=owner_missing=frame_wrap=false;source_quiescent=runtime_files_owner_live=world_live=true;session_complete=session_match=session_flow=session_bank=true;source_quiescence_calls=0;active_source_interval=0;source_interval_end_calls=source_interval_end_mismatches=0;retirement_trace=false;retire_admit_ok=retire_confirm_ok=true;retire_admit_calls=retire_confirm_calls=action_disarm_calls=0;retirement_order.fill(0);retirement_order_count=0;class_arms=class_disarms=0;class_unavailable=false;lobj_ok=true;lobj_disarms=0;reset_tobj_owner_model();source_bytes.fill(0x5a);tobj_arms=tobj_mark_post=tobj_mark_drawn=tobj_disarms=0;slist_trace_arm_calls=slist_capture_samples=slist_trace_early_closes=class_piece_trace_early_closes=0;commit_calls=corrected_commit_calls=profile_reset_calls=particle_reset_calls=particle_anchor_disarms=corrected_seal_calls=finish_replay_calls=0;modeled_commit_result=GameplayCpuCommitResult::Ok;modeled_corrected_commit_result=GameplayCpuCommitResult::Ok;profile_reset_ok=particle_anchor_ok=particle_reset_ok=corrected_action_ok=true;last_profile_reset_anchor={};};
 const auto unchanged=[](){for(auto b:source_bytes)assert(b==0x5a);};
 reset();
 const auto source_calls_before=source_quiescence_calls;
 assert(session.diagnostic_source_files_quiescent());
 assert(source_quiescence_calls==source_calls_before+1);
 source_quiescent=false;assert(!session.diagnostic_source_files_quiescent());
 assert(source_quiescence_calls==source_calls_before+2);source_quiescent=true;
 session_complete=false;assert(!session.diagnostic_source_files_quiescent());
