 Snapshot *drawn_payload_{},*drawn_flow_{};std::vector<std::byte> drawn_bytes_,drawn_statics_;
 std::vector<std::byte> post_bytes_;AudioRanges audio_ranges_{};std::size_t audio_range_count_{};
 AudioRanges drawn_audio_ranges_{};std::size_t drawn_audio_range_count_{};bool drawn_sealed_=false;
 std::uint32_t post_frame_{},checked_domains_{},matched_domains_{};CpuComparison comparison_{};bool confirmed_disarmed_=false;
 std::uint64_t lobj_writer_session_=0,tobj_writer_session_=0;
