 assert(count==clean_sealed_count&&commit_calls==0&&corrected_commit_calls==0);unchanged();
 clean_sealed_reference.reset();assert(live_capsules==0&&live_action_intervals==0);
 std::puts("clean Sealed reference releases with zero comparison masks; nonzero mask refuses");

 reset();auto effects_refusal=retirement_candidate();effect_ok=false;
 reset_retirement_trace();assert(!effects_refusal->retire_confirmed(session));retirement_trace=false;
 assert_retirement_order({1,2,3,4,5});assert(retire_admit_calls==0&&retire_confirm_calls==0);
 normal_fallback_cleanup(effects_refusal);unchanged();

 reset();auto light_refusal=retirement_candidate();lobj_ok=false;
