// These existing capture tests intentionally model diagnostic unavailable.
// Actual writer lifetime/correlation is tested in source_lobj_writer_control.
template<class T> uint64_t melee_web_lobj_writer_arm(T*,MeleeWebClassPieceAnchor,uint32_t){return 0;}
void melee_web_lobj_writer_mark(uint64_t,uint32_t){}
void melee_web_lobj_writer_disarm(uint64_t){}
// Explicit diagnostic-unavailable model, not actual TObj observation/lifetime.
// Real producer/decoder controls passed separately; zero sessions are legal.
static unsigned tobj_arms=0,tobj_mark_post=0,tobj_mark_drawn=0,tobj_disarms=0;
// Match the actual source-writer diagnostic profile guard. V7 can observe
// source MakeTextureMtx; V8 managed cache makes this source witness N/A.
static unsigned expected_tobj_arms(CpuCheckpointSpan span){
#if defined(MELEE_WEB_SLIPPI_LOBJ_PRESENTATION_CACHE) && MELEE_WEB_SLIPPI_LOBJ_PRESENTATION_CACHE && !(defined(MELEE_WEB_SLIPPI_TOBJ_PRESENTATION_CACHE) && MELEE_WEB_SLIPPI_TOBJ_PRESENTATION_CACHE)
 return span==CpuCheckpointSpan::TwoTicks?1u:0u;
#else
 (void)span;return 0;
#endif
}

template<class T> uint64_t melee_web_tobj_writer_arm(T* pre,MeleeWebClassPieceAnchor a,uint32_t command,uint32_t frame){
 assert(pre&&count==8&&class_arms==1&&a.epoch==1&&a.world==1&&command==8&&frame==live_frame);
 ++tobj_arms;return 0;
}
void melee_web_tobj_writer_mark(uint64_t session,uint32_t endpoint){
 assert(session==0&&(endpoint==1||endpoint==2));
 if(endpoint==1)++tobj_mark_post;else ++tobj_mark_drawn;
}
void melee_web_tobj_writer_disarm(uint64_t session){assert(session==0);++tobj_disarms;}

