struct GameplayMatchCpuOwners{const void* storage;MeleeWebMatchContext* context;MeleeWebMatchFlow* flow;MeleeWebAudio* audio;std::uint64_t world;std::uint64_t context_epoch;std::uint32_t frame;};
class GameplayMatchSession{public:std::uint32_t source_frames()const{return live_frame;}GameplayMatchCpuOwners diagnostic_cpu_owners() const noexcept{
 return {owner_missing?nullptr:this,nullptr,nullptr,nullptr,1,1,frame_wrap?UINT32_MAX:live_frame};}};
class GameplayCpuStatics{public:~GameplayCpuStatics(){++static_destroys;}bool capture(){visit(7);return refuse_leaf!=7;}bool seal_post(){return bytes_ok;}
 CpuComparison capture_expected(std::vector<std::byte>& out)const{out.assign(1,std::byte{0x5a});CpuComparison c;if(!bytes_ok)c.status=2;return c;}
 CpuComparison compare_expected(std::span<const std::byte> out)const{CpuComparison c;if(!bytes_ok||out.size()!=1)c.status=2;return c;}};
struct Commit{GameplayCpuStatics* statics{};MeleeWebAudio* audio{};MeleeWebMatchFlow* flow{};MeleeWebMatchContext* context{};
 const Snapshot *bootstrap{},*flow_snapshot{},*context_snapshot{},*audio_snapshot{},*payload{};Snapshot* actions{};std::uint64_t effect_token{};SlippiLObjAnchor lobj_anchor{};SlippiTObjAnchor tobj_anchor{};};
GameplayCpuCommitResult gameplay_cpu_commit(const Commit&) noexcept {
 ++commit_calls;
 return modeled_commit_result;
}
class GameplayCpuCheckpoint{public:
 static void* operator new(std::size_t n,const std::nothrow_t&) noexcept {return capsule_alloc_failure?nullptr:std::malloc(n);}
 static void operator delete(void* p) noexcept {std::free(p);}
 static std::unique_ptr<GameplayCpuCheckpoint> capture(const GameplayMatchSession&,std::unique_ptr<GameplayCpuStatics>,CpuCaptureDiagnostic&,CpuCheckpointSpan=CpuCheckpointSpan::OneTick) noexcept;
 ~GameplayCpuCheckpoint();
 const CpuComparison& comparison()const{return comparison_;}
 bool interval_boundary(const GameplayMatchSession&) noexcept;
 bool seal_post(const GameplayMatchSession&) noexcept;
 GameplayCpuCommitResult restore(const GameplayMatchSession&) noexcept;
 bool seal_drawn_reference(const GameplayMatchSession&) noexcept;
 bool matches_drawn_reference(const GameplayMatchSession&) noexcept;
 void fixture_sealed(){phase_=Phase::Sealed;post_frame_=176;commit_.effect_token=1;}
 void fixture_recording(){phase_=Phase::Recording;commit_.effect_token=1;}
 void fixture_replaying(){phase_=Phase::Replaying;}
 void fixture_finished(){phase_=Phase::Finished;}
 bool fixture_failed()const{return phase_==Phase::Failed;}
 bool fixture_is_replaying()const{return phase_==Phase::Replaying;}
 void disarm() noexcept;
 void release() noexcept;
private:
 explicit GameplayCpuCheckpoint(CpuCheckpointSpan span):span_(span){}
 const CpuCheckpointSpan span_;
 enum class Phase{Captured,Recording,Sealed,Replaying,Finished,Failed};Phase phase_=Phase::Captured;
 bool same_owner(const GameplayMatchSession&)const{return !owner_missing;}
 using AudioRanges=std::array<int,16>;
 bool capture_post_bytes(const GameplayMatchSession&,std::vector<std::byte>& b,AudioRanges&,std::size_t& n){b.assign(1,std::byte{0x5a});n=1;return bytes_ok;}
 bool matches_post_bytes(const GameplayMatchSession&,const std::vector<std::byte>&,const AudioRanges&,std::size_t){return bytes_ok;}
 Snapshot *drawn_payload_{},*drawn_flow_{};std::vector<std::byte> drawn_bytes_,drawn_statics_;
 std::vector<std::byte> post_bytes_;AudioRanges audio_ranges_{};std::size_t audio_range_count_{};
 AudioRanges drawn_audio_ranges_{};std::size_t drawn_audio_range_count_{};bool drawn_sealed_=false;
 std::uint32_t post_frame_{},checked_domains_{},matched_domains_{};CpuComparison comparison_{};
 std::uint64_t lobj_writer_session_=0,tobj_writer_session_=0;
 MeleeWebClassPieceAnchor class_piece_anchor_{};
 GameplayMatchCpuOwners owner_{};std::unique_ptr<GameplayCpuStatics> statics_;Commit commit_{};std::uint64_t audio_generation_{};bool source_step_possible_=false;Snapshot *post_payload_{},*post_flow_{};
};
// These existing capture tests intentionally model diagnostic unavailable.
// Actual writer lifetime/correlation is tested in source_lobj_writer_control.
template<class T> uint64_t melee_web_lobj_writer_arm(T*,MeleeWebClassPieceAnchor,uint32_t){return 0;}
void melee_web_lobj_writer_mark(uint64_t,uint32_t){}
void melee_web_lobj_writer_disarm(uint64_t){}
// Explicit diagnostic-unavailable model, not actual TObj observation/lifetime.
// Real producer/decoder controls passed separately; zero sessions are legal.
static unsigned tobj_arms=0,tobj_mark_post=0,tobj_mark_drawn=0,tobj_disarms=0;
// Match the actual source-writer diagnostic profile guard. V7 can observe
// source MakeTextureMtx; V8 managed cache makes this source witness N/A.
static unsigned expected_tobj_arms(CpuCheckpointSpan span){
#if defined(MELEE_WEB_SLIPPI_LOBJ_PRESENTATION_CACHE) && MELEE_WEB_SLIPPI_LOBJ_PRESENTATION_CACHE && !(defined(MELEE_WEB_SLIPPI_TOBJ_PRESENTATION_CACHE) && MELEE_WEB_SLIPPI_TOBJ_PRESENTATION_CACHE)
 return span==CpuCheckpointSpan::TwoTicks?1u:0u;
#else
 (void)span;return 0;
#endif
}

template<class T> uint64_t melee_web_tobj_writer_arm(T* pre,MeleeWebClassPieceAnchor a,uint32_t command,uint32_t frame){
 assert(pre&&count==8&&class_arms==1&&a.epoch==1&&a.world==1&&command==8&&frame==live_frame);
 ++tobj_arms;return 0;
}
void melee_web_tobj_writer_mark(uint64_t session,uint32_t endpoint){
 assert(session==0&&(endpoint==1||endpoint==2));
 if(endpoint==1)++tobj_mark_post;else ++tobj_mark_drawn;
}
void melee_web_tobj_writer_disarm(uint64_t session){assert(session==0);++tobj_disarms;}

