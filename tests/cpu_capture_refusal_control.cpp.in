 assert(retire_admit_calls==1&&retire_confirm_calls==0&&action_disarm_calls==0);
 assert(action_admission_refusal->fixture_source_step_possible());normal_fallback_cleanup(action_admission_refusal);unchanged();

 reset();auto action_commit_refusal=retirement_candidate(true);retire_confirm_ok=false;
 reset_retirement_trace();assert(!action_commit_refusal->retire_confirmed(session));retirement_trace=false;
#if defined(MELEE_WEB_SLIPPI_TOBJ_PRESENTATION_CACHE) && MELEE_WEB_SLIPPI_TOBJ_PRESENTATION_CACHE
