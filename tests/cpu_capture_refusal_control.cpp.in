struct Compare{std::uint32_t status=0,allocation_index=0,byte_offset=0,expected_byte=0,actual_byte=0;std::uintptr_t host_address=0;std::uint32_t requested_bytes=0,admission_status=0,source_address=0;};
Compare melee_web_source_memory_payload_snapshot_compare_live(Snapshot*){Compare c;c.status=payload_ok?0:2;return c;}
