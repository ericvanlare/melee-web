 auto* p=snapshot(5);return {p?MELEE_WEB_SOURCE_MEMORY_PAYLOAD_SNAPSHOT_OK:MELEE_WEB_SOURCE_MEMORY_PAYLOAD_SNAPSHOT_ALLOCATION_FAILED,p};
}
Snapshot* melee_web_action_interval_capture(){return snapshot(6);}
std::uint64_t melee_web_audio_generation(MeleeWebAudio*){visit(8);return refuse_leaf==8?0:17;}
