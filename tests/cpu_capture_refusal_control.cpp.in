class GameplayCpuCheckpoint{public:
 static void* operator new(std::size_t n,const std::nothrow_t&) noexcept {if(capsule_alloc_failure)return nullptr;void* p=std::malloc(n);if(p){++live_capsules;max_live_capsules=std::max(max_live_capsules,live_capsules);}return p;}
 static void operator delete(void* p) noexcept {if(p){assert(live_capsules>0);--live_capsules;}std::free(p);}
 static std::unique_ptr<GameplayCpuCheckpoint> capture(const GameplayMatchSession&,std::unique_ptr<GameplayCpuStatics>,CpuCaptureDiagnostic&,CpuCheckpointSpan=CpuCheckpointSpan::OneTick) noexcept;
 static std::unique_ptr<GameplayCpuCheckpoint> capture_span(const GameplayMatchSession&,std::unique_ptr<GameplayCpuStatics>,CpuCaptureDiagnostic&,std::uint32_t) noexcept;
 ~GameplayCpuCheckpoint();
 const CpuComparison& comparison()const{return comparison_;}
 bool interval_boundary(const GameplayMatchSession&) noexcept;
 bool seal_post(const GameplayMatchSession&) noexcept;
 GameplayCpuCommitResult restore(const GameplayMatchSession&) noexcept;
 GameplayCpuCommitResult restore_corrected(const GameplayMatchSession&) noexcept;
 bool finish_corrected(const GameplayMatchSession&) noexcept;
 bool seal_drawn_reference(const GameplayMatchSession&) noexcept;
 bool matches_drawn_reference(const GameplayMatchSession&) noexcept;
 bool retire_confirmed(const GameplayMatchSession&) noexcept;
 bool source_owners_retired(const GameplayMatchSession*) noexcept;
 void fixture_sealed(){phase_=Phase::Sealed;post_frame_=176;commit_.effect_token=1;}
 void fixture_recording(){phase_=Phase::Recording;commit_.effect_token=1;}
 void fixture_replaying(){phase_=Phase::Replaying;}
 void fixture_correcting(){phase_=Phase::Correcting;post_frame_=live_frame;commit_.effect_token=1;}
 void fixture_finished(){phase_=Phase::Finished;}
 void fixture_retirement_terminal(bool corrected=false,std::uint64_t interval=1){phase_=corrected?Phase::CorrectedSealed:Phase::Finished;post_frame_=live_frame;commit_.effect_token=interval;source_step_possible_=true;comparison_={};checked_domains_=matched_domains_=corrected?0u:0x3feu;}
 void fixture_clean_reference_retirement_terminal(std::uint64_t interval=1){phase_=Phase::Sealed;post_frame_=live_frame;commit_.effect_token=interval;source_step_possible_=true;comparison_={};checked_domains_=matched_domains_=0;}
 bool fixture_confirmed_detached()const{return phase_==Phase::ConfirmedDetached;}
 bool fixture_source_step_possible()const{return source_step_possible_;}
 bool fixture_phase_terminal()const{return phase_==Phase::Finished||phase_==Phase::CorrectedSealed;}
 void fixture_wrong_phase(){phase_=Phase::Sealed;}
 void fixture_comparison_status(std::uint32_t status){comparison_.status=status;}
 void fixture_domain_masks(std::uint32_t checked,std::uint32_t matched){checked_domains_=checked;matched_domains_=matched;}
 bool fixture_failed()const{return phase_==Phase::Failed;}
 bool fixture_is_replaying()const{return phase_==Phase::Replaying;}
 bool fixture_is_correcting()const{return phase_==Phase::Correcting;}
 bool fixture_is_corrected_sealed()const{return phase_==Phase::CorrectedSealed;}
 std::uint32_t checked_domains()const{return checked_domains_;}
 std::uint32_t matched_domains()const{return matched_domains_;}
 void disarm() noexcept;
 void release() noexcept;
private:
