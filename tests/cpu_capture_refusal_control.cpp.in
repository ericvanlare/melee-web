int main(){
 using namespace melee_web;
 const std::array<unsigned,8> order{1,2,3,4,5,6,7,8};
 const std::array<unsigned,8> domains{7,5,6,8,4,3,9,8};
 GameplayMatchSession session;
#if !(defined(MELEE_WEB_SLIPPI_TOBJ_PRESENTATION_CACHE) && MELEE_WEB_SLIPPI_TOBJ_PRESENTATION_CACHE)
 const auto disabled_tobj=slippi_tobj_anchor_capture();assert(disabled_tobj.token==0&&slippi_tobj_anchor_admit(disabled_tobj)==1&&slippi_tobj_failure()==0);slippi_tobj_anchor_disarm(disabled_tobj);
#endif
 auto reset=[](){live_frame=176;effect_ok=action_ok=payload_ok=flow_ok=bytes_ok=true;refuse_leaf=throw_leaf=created=destroyed=static_destroys=count=0;trace={};capsule_alloc_failure=owner_missing=frame_wrap=false;class_arms=class_disarms=0;class_unavailable=false;lobj_ok=true;lobj_disarms=0;reset_tobj_owner_model();source_bytes.fill(0x5a);tobj_arms=tobj_mark_post=tobj_mark_drawn=tobj_disarms=0;slist_trace_arm_calls=slist_capture_samples=slist_trace_early_closes=class_piece_trace_early_closes=0;commit_calls=profile_reset_calls=0;modeled_commit_result=GameplayCpuCommitResult::Ok;profile_reset_ok=true;last_profile_reset_anchor={};};
 const auto unchanged=[](){for(auto b:source_bytes)assert(b==0x5a);};
 for(unsigned failure=1;failure<=8;++failure){reset();refuse_leaf=failure;CpuCaptureDiagnostic d;
  auto c=GameplayCpuCheckpoint::capture(session,std::make_unique<GameplayCpuStatics>(),d);assert(!c);
  assert(d.comparison.domain==domains[failure-1]&&d.comparison.status==1&&d.comparison.row==UINT32_MAX&&d.comparison.offset==UINT32_MAX);
  assert(count==failure&&std::equal(trace.begin(),trace.begin()+count,order.begin()));
  assert(created==destroyed&&static_destroys==1);unchanged();
  if(failure<=3){char exact[80];std::snprintf(exact,sizeof(exact),"actual fixture leaf%u refused",failure);assert(std::strcmp(d.message.data(),exact)==0);}
  if(failure==5)assert(d.comparison.detail==MELEE_WEB_SOURCE_MEMORY_PAYLOAD_SNAPSHOT_ALLOCATION_FAILED);
  if(failure==4||failure==6)assert(std::strstr(d.message.data(),"opaque capture API"));
 }
 for(unsigned failure=1;failure<=8;++failure){reset();throw_leaf=failure;CpuCaptureDiagnostic d;
  auto c=GameplayCpuCheckpoint::capture(session,std::make_unique<GameplayCpuStatics>(),d);assert(!c);
  assert(d.comparison.domain==domains[failure-1]&&d.comparison.detail==static_cast<unsigned>(CpuCaptureRefusal::AllocationException));
  assert(created==destroyed&&static_destroys==1&&count==failure);unchanged();
 }
 reset();owner_missing=true;CpuCaptureDiagnostic owner;
 assert(!GameplayCpuCheckpoint::capture(session,std::make_unique<GameplayCpuStatics>(),owner));
 assert(owner.comparison.domain==1&&owner.comparison.detail==3&&count==0&&static_destroys==1);unchanged();
 reset();frame_wrap=true;CpuCaptureDiagnostic frame;
 assert(!GameplayCpuCheckpoint::capture(session,std::make_unique<GameplayCpuStatics>(),frame));assert(frame.comparison.domain==1&&frame.comparison.detail==4&&count==0);unchanged();
 reset();capsule_alloc_failure=true;CpuCaptureDiagnostic allocation;
 assert(!GameplayCpuCheckpoint::capture(session,std::make_unique<GameplayCpuStatics>(),allocation));assert(allocation.comparison.domain==1&&allocation.comparison.detail==1&&count==0&&static_destroys==1);
 reset();CpuCaptureDiagnostic missing;
 assert(!GameplayCpuCheckpoint::capture(session,nullptr,missing));assert(missing.comparison.domain==9&&missing.comparison.detail==2&&count==0);
#if defined(MELEE_WEB_SLIPPI_TOBJ_PRESENTATION_CACHE) && MELEE_WEB_SLIPPI_TOBJ_PRESENTATION_CACHE
 reset();tobj_ok=false;CpuCaptureDiagnostic texture;
 assert(!GameplayCpuCheckpoint::capture(session,std::make_unique<GameplayCpuStatics>(),texture));
 assert(texture.comparison.domain==1&&texture.comparison.detail==static_cast<unsigned>(CpuCaptureRefusal::TObjOwner));
 assert(created==destroyed&&tobj_owner_disarms==1&&class_arms==0);unchanged();
#endif
 reset();lobj_ok=false;CpuCaptureDiagnostic light;
 assert(!GameplayCpuCheckpoint::capture(session,std::make_unique<GameplayCpuStatics>(),light));
 assert(light.comparison.domain==1&&light.comparison.detail==static_cast<unsigned>(CpuCaptureRefusal::LObjOwner));
 assert(count==8&&created==destroyed&&lobj_disarms==1&&class_arms==0);unchanged();
 reset();CpuCaptureDiagnostic success;success.comparison.status=9;
 auto c=GameplayCpuCheckpoint::capture(session,std::make_unique<GameplayCpuStatics>(),success);
 assert(class_arms==1&&class_disarms==0&&tobj_arms==0&&tobj_disarms==0);
 assert(c&&success.comparison.domain==0&&success.comparison.status==0&&success.message[0]==0&&count==8&&created==6&&destroyed==0);
 assert(std::equal(trace.begin(),trace.begin()+count,order.begin()));unchanged();c.reset();assert(destroyed==6&&static_destroys==1&&class_disarms==1&&tobj_disarms==1);
 reset();class_unavailable=true;CpuCaptureDiagnostic unavailable;
 auto unavailable_capsule=GameplayCpuCheckpoint::capture(session,std::make_unique<GameplayCpuStatics>(),unavailable);
 assert(unavailable_capsule&&unavailable.comparison.status==0&&class_arms==1);unavailable_capsule.reset();assert(class_disarms==0);
 reset();CpuCaptureDiagnostic endpoint;
 auto e=GameplayCpuCheckpoint::capture(session,std::make_unique<GameplayCpuStatics>(),endpoint);assert(e);e->fixture_sealed();
 effect_ok=false;assert(!e->seal_drawn_reference(session));effect_ok=true;
 action_ok=false;assert(!e->seal_drawn_reference(session));action_ok=true;
 payload_ok=false;assert(!e->seal_drawn_reference(session));payload_ok=true;
 count=0;assert(e->seal_drawn_reference(session));assert(count==2&&trace[0]==5&&trace[1]==2&&tobj_mark_drawn==1&&tobj_mark_post==0);unchanged();
 assert(!e->seal_drawn_reference(session));e->fixture_finished();
 assert(e->matches_drawn_reference(session));
 for(bool* failure:{&effect_ok,&action_ok,&payload_ok,&flow_ok,&bytes_ok,&lobj_ok}){*failure=false;assert(!e->matches_drawn_reference(session));*failure=true;unchanged();}
#if defined(MELEE_WEB_SLIPPI_TOBJ_PRESENTATION_CACHE) && MELEE_WEB_SLIPPI_TOBJ_PRESENTATION_CACHE
 tobj_ok=false;assert(!e->matches_drawn_reference(session));tobj_ok=true;unchanged();
#endif
 owner_missing=true;assert(!e->matches_drawn_reference(session));owner_missing=false;
 e.reset();assert(created==destroyed);
 // Execute actual capture/span, interval guard, and seal methods. Owner,
 // effect, journal and capture leaves remain explicitly modeled above.
 reset();CpuCaptureDiagnostic invalid;
 assert(!GameplayCpuCheckpoint::capture(session,std::make_unique<GameplayCpuStatics>(),invalid,static_cast<CpuCheckpointSpan>(3)));
 assert(invalid.comparison.detail==static_cast<unsigned>(CpuCaptureRefusal::InvalidSpan)&&count==0);unchanged();
 reset();live_frame=UINT32_MAX-1u;CpuCaptureDiagnostic overflow;
 assert(!GameplayCpuCheckpoint::capture(session,std::make_unique<GameplayCpuStatics>(),overflow,CpuCheckpointSpan::TwoTicks));
 assert(overflow.comparison.detail==static_cast<unsigned>(CpuCaptureRefusal::SourceFrameWrap)&&count==0);unchanged();
 reset();live_frame=UINT32_MAX-2u;CpuCaptureDiagnostic exact;
 auto max=GameplayCpuCheckpoint::capture(session,std::make_unique<GameplayCpuStatics>(),exact,CpuCheckpointSpan::TwoTicks);assert(max);assert(tobj_arms==expected_tobj_arms(CpuCheckpointSpan::TwoTicks));
#if defined(MELEE_WEB_SLIPPI_TOBJ_PRESENTATION_CACHE) && MELEE_WEB_SLIPPI_TOBJ_PRESENTATION_CACHE
 assert(slist_trace_arm_calls==1&&slist_capture_samples==1);
#else
 assert(slist_trace_arm_calls==0&&slist_capture_samples==0);
#endif
 max.reset();assert(tobj_disarms==1&&class_piece_trace_early_closes>0);
#if defined(MELEE_WEB_SLIPPI_TOBJ_PRESENTATION_CACHE) && MELEE_WEB_SLIPPI_TOBJ_PRESENTATION_CACHE
 assert(slist_trace_early_closes==class_piece_trace_early_closes);
#else
 assert(slist_trace_early_closes==0);
#endif
 for(auto span:{CpuCheckpointSpan::OneTick,CpuCheckpointSpan::TwoTicks}){
   reset();CpuCaptureDiagnostic d;auto interval=GameplayCpuCheckpoint::capture(session,std::make_unique<GameplayCpuStatics>(),d,span);assert(interval);
   assert(tobj_arms==expected_tobj_arms(span)&&tobj_disarms==0);
   assert(!interval->interval_boundary(session)&&interval->comparison().domain==1);
   interval->fixture_recording();assert(interval->interval_boundary(session));
   owner_missing=true;assert(!interval->interval_boundary(session)&&interval->comparison().domain==1);owner_missing=false;
   effect_ok=false;assert(!interval->interval_boundary(session)&&interval->comparison().domain==2);effect_ok=true;
   action_ok=false;assert(!interval->interval_boundary(session)&&interval->comparison().domain==3);action_ok=true;
   ++live_frame;assert(interval->interval_boundary(session));
   if(span==CpuCheckpointSpan::TwoTicks){
#if defined(MELEE_WEB_SLIPPI_TOBJ_PRESENTATION_CACHE) && MELEE_WEB_SLIPPI_TOBJ_PRESENTATION_CACHE
     assert(slist_trace_arm_calls==1&&slist_capture_samples==1);
#else
     assert(slist_trace_arm_calls==0&&slist_capture_samples==0);
#endif
     ++live_frame;assert(interval->interval_boundary(session));
   } else assert(slist_trace_arm_calls==0&&slist_capture_samples==0);
   assert(interval->seal_post(session));assert(tobj_mark_post==1&&tobj_mark_drawn==0);assert(!interval->interval_boundary(session));
